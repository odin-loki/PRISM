func trunc_ok
L params 1 x 64
L ret 32
L block entry
L cast %conv trunc 0 64 32 %x
L ret %conv
status ok
P vars 2 64 32
P params 1 0
P retw 32
P block
P assign 1 trunc 1 v0:64
P ret v1:32
end
func widen_bad
L params 2 a 16 b 16
L ret 32
L block entry
L cast %conv sext 0 16 32 %a
L cast %conv1 sext 0 16 32 %b
L bin %mul mul nsw 32 %conv %conv1
L bin %mul2 mul nsw 32 %mul #2
L ret %mul2
status ok
P vars 8 16 16 32 32 32 32 1 1
P params 2 0 1
P retw 32
P block
P assign 2 sext 1 v0:16
P assign 3 sext 1 v1:16
P assign 6 smul.ovf 2 v2:32 v3:32
P check v6:1 ovf* INT-SIGNED-OVF
P assign 4 mul 2 v2:32 v3:32
P assign 7 smul.ovf 2 v4:32 c32:2
P check v7:1 ovf* INT-SIGNED-OVF
P assign 5 mul 2 v4:32 c32:2
P ret v5:32
end
func widen_ok
L params 2 a 16 b 16
L ret 32
L block entry
L cast %conv sext 0 16 32 %a
L cast %conv1 sext 0 16 32 %b
L bin %mul mul nsw 32 %conv %conv1
L ret %mul
status ok
P vars 6 16 16 32 32 32 1
P params 2 0 1
P retw 32
P block
P assign 2 sext 1 v0:16
P assign 3 sext 1 v1:16
P assign 5 smul.ovf 2 v2:32 v3:32
P check v5:1 ovf* INT-SIGNED-OVF
P assign 4 mul 2 v2:32 v3:32
P ret v4:32
end
func uchar_ok
L params 2 a 8 b 8
L ret 8
L block entry
L cast %conv zext 0 8 32 %a
L cast %conv1 zext 0 8 32 %b
L bin %add add nsw 32 %conv %conv1
L cast %conv2 trunc 0 32 8 %add
L ret %conv2
status ok
P vars 7 8 8 32 32 32 8 1
P params 2 0 1
P retw 8
P block
P assign 2 zext 1 v0:8
P assign 3 zext 1 v1:8
P assign 6 sadd.ovf 2 v2:32 v3:32
P check v6:1 ovf+ INT-SIGNED-OVF
P assign 4 add 2 v2:32 v3:32
P assign 5 trunc 1 v4:32
P ret v5:8
end
func sext_mul_ok
L params 2 a 32 b 32
L ret 64
L block entry
L cast %conv sext 0 32 64 %a
L cast %conv1 sext 0 32 64 %b
L bin %mul mul nsw 64 %conv %conv1
L ret %mul
status ok
P vars 6 32 32 64 64 64 1
P params 2 0 1
P retw 64
P block
P assign 2 sext 1 v0:32
P assign 3 sext 1 v1:32
P assign 5 smul.ovf 2 v2:64 v3:64
P check v5:1 ovf* INT-SIGNED-OVF
P assign 4 mul 2 v2:64 v3:64
P ret v4:64
end
