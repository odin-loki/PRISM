func add_bad
L params 2 a 32 b 32
L ret 32
L block entry
L bin %add add nsw 32 %a %b
L ret %add
status ok
P vars 4 32 32 32 1
P params 2 0 1
P retw 32
P block
P assign 3 sadd.ovf 2 v0:32 v1:32
P check v3:1 ovf+ INT-SIGNED-OVF
P assign 2 add 2 v0:32 v1:32
P ret v2:32
end
func add_ok
L params 1 a 32
L ret 32
L block entry
L icmp %cmp sgt 32 %a #1000
L cbr %cmp if.then lor.lhs.false
L block lor.lhs.false
L icmp %cmp1 slt 32 %a #18446744073709550616
L cbr %cmp1 if.then if.end
L block if.then
L br return
L block if.end
L bin %add add nsw 32 %a #1
L br return
L block return
L phi %retval.0 32 2 #0 if.then %add if.end
L ret %retval.0
status ok
P vars 6 32 1 1 32 32 1
P params 1 0
P retw 32
P block
P assign 1 sgt 2 v0:32 c32:1000
P br v1:1 2 1
P block
P assign 2 slt 2 v0:32 c32:4294966296
P br v2:1 2 3
P block
P jmp 4
P block
P assign 5 sadd.ovf 2 v0:32 c32:1
P check v5:1 ovf+ INT-SIGNED-OVF
P assign 3 add 2 v0:32 c32:1
P jmp 4
P block
P phi 4 2 2 c32:0 3 v3:32
P ret v4:32
end
