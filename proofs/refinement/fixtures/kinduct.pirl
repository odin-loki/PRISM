func kind_closed
L params 1 n 32
L ret 32
L block entry
L br while.cond
L block while.cond
L phi %n.addr.0 32 2 %n entry %dec while.body
L icmp %cmp sgt 32 %n.addr.0 #0
L cbr %cmp while.body while.end
L block while.body
L bin %dec add nsw 32 %n.addr.0 #18446744073709551615
L br while.cond
L block while.end
L phi %n.addr.0.lcssa 32 1 %n.addr.0 while.cond
L ret %n.addr.0.lcssa
status ok
P vars 6 32 32 1 32 32 1
P params 1 0
P retw 32
P block
P jmp 1
P block
P phi 1 2 0 v0:32 2 v3:32
P assign 2 sgt 2 v1:32 c32:0
P br v2:1 2 3
P block
P assign 5 sadd.ovf 2 v1:32 c32:4294967295
P check v5:1 ovf+ INT-SIGNED-OVF
P assign 3 add 2 v1:32 c32:4294967295
P jmp 1
P block
P phi 4 1 1 v1:32
P ret v4:32
end
func kind_countdown
L params 1 n 32
L ret 32
L block entry
L br while.cond
L block while.cond
L phi %s.0 32 2 #0 entry %inc while.body
L phi %n.addr.0 32 2 %n entry %dec while.body
L icmp %cmp ne 32 %n.addr.0 #0
L cbr %cmp while.body while.end
L block while.body
L bin %dec add - 32 %n.addr.0 #18446744073709551615
L bin %inc add - 32 %s.0 #1
L br while.cond
L block while.end
L phi %s.0.lcssa 32 1 %s.0 while.cond
L ret %s.0.lcssa
status ok
P vars 7 32 32 32 1 32 32 32
