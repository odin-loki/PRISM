P assign 5 add 2 v1:32 c32:1
P jmp 1
P block
P phi 6 1 1 v1:32
P ret v6:32
end
func kind_open
L params 1 n 32
L ret 32
L block entry
L br while.cond
L block while.cond
L phi %x.0 32 2 #1 entry %add while.body
L phi %n.addr.0 32 2 %n entry %dec while.body
L icmp %cmp sgt 32 %n.addr.0 #0
L cbr %cmp while.body while.end
L block while.body
L bin %add add nsw 32 %x.0 %x.0
L bin %dec add nsw 32 %n.addr.0 #18446744073709551615
L br while.cond
L block while.end
L phi %x.0.lcssa 32 1 %x.0 while.cond
L ret %x.0.lcssa
