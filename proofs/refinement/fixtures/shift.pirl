func shl_amount_bad
L params 2 a 32 s 32
L ret 32
L block entry
L icmp %cmp slt 32 %a #0
L cbr %cmp if.then lor.lhs.false
L block lor.lhs.false
L icmp %cmp1 sgt 32 %a #1
L cbr %cmp1 if.then if.end
L block if.then
L br return
L block if.end
L bin %shl shl - 32 %a %s
L br return
L block return
L phi %retval.0 32 2 #0 if.then %shl if.end
L ret %retval.0
status ok
P vars 7 32 32 1 1 32 32 1
P params 2 0 1
P retw 32
P block
P assign 2 slt 2 v0:32 c32:0
P br v2:1 2 1
P block
P assign 3 sgt 2 v0:32 c32:1
P br v3:1 2 3
P block
P jmp 4
P block
P assign 6 shift.oob 2 v0:32 v1:32
P check v6:1 shift INT-SHIFT-UB
P assign 4 shl 2 v0:32 v1:32
P jmp 4
P block
P phi 5 2 2 c32:0 3 v4:32
P ret v5:32
end
func shl_masked_ok
L params 2 a 32 s 32
L ret 32
L block entry
L bin %and and - 32 %s #31
L bin %shl shl - 32 %a %and
L ret %shl
status ok
P vars 5 32 32 32 32 1
P params 2 0 1
P retw 32
P block
P assign 2 and 2 v1:32 c32:31
P assign 4 shift.oob 2 v0:32 v2:32
P check v4:1 shift INT-SHIFT-UB
P assign 3 shl 2 v0:32 v2:32
P ret v3:32
end
