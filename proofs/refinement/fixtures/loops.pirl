func nested_ok
L params 1 n 32
L ret 32
L block entry
L br for.cond
L block for.cond
L phi %i.0 32 2 #0 entry %inc6 for.inc5
L phi %c.0 32 2 #0 entry %c.1.lcssa for.inc5
L icmp %cmp slt 32 %i.0 #3
L cbr %cmp for.body for.end7
L block for.body
L br for.cond1
L block for.cond1
L phi %c.1 32 2 %c.0 for.body %inc for.inc
L phi %j.0 32 2 #0 for.body %inc4 for.inc
L icmp %cmp2 slt 32 %j.0 #3
L cbr %cmp2 for.body3 for.end
L block for.body3
L bin %inc add nsw 32 %c.1 #1
L br for.inc
L block for.inc
L bin %inc4 add nsw 32 %j.0 #1
L br for.cond1
L block for.end
L phi %c.1.lcssa 32 1 %c.1 for.cond1
L br for.inc5
L block for.inc5
L bin %inc6 add nsw 32 %i.0 #1
L br for.cond
L block for.end7
L phi %c.0.lcssa 32 1 %c.0 for.cond
L bin %and and - 32 %n #1
L bin %add add nsw 32 %c.0.lcssa %and
L ret %add
status ok
P vars 18 32 32 32 1 32 32 1 32 32 32 32 32 32 32 1 1 1 1
P params 1 0
P retw 32
P block
P jmp 1
P block
P phi 1 2 0 c32:0 7 v10:32
P phi 2 2 0 c32:0 7 v9:32
P assign 3 slt 2 v1:32 c32:3
P br v3:1 2 8
P block
P jmp 3
P block
