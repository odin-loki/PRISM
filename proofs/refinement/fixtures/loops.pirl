func count4_ok
L params 1 x 32
L ret 32
L block entry
L br for.cond
L block for.cond
L phi %s.0 32 2 #0 entry %add for.inc
L phi %i.0 32 2 #0 entry %inc for.inc
L icmp %cmp slt 32 %i.0 #4
L cbr %cmp for.body for.end
L block for.body
L bin %add add nsw 32 %s.0 %i.0
L br for.inc
L block for.inc
L bin %inc add nsw 32 %i.0 #1
L br for.cond
L block for.end
L phi %s.0.lcssa 32 1 %s.0 for.cond
L bin %and and - 32 %x #1
L bin %add1 add nsw 32 %s.0.lcssa %and
L ret %add1
status ok
P vars 12 32 32 32 1 32 32 32 32 32 1 1 1
P params 1 0
P retw 32
P block
P jmp 1
P block
P phi 1 2 0 c32:0 3 v4:32
P phi 2 2 0 c32:0 3 v5:32
P assign 3 slt 2 v2:32 c32:4
P br v3:1 2 4
P block
P assign 9 sadd.ovf 2 v1:32 v2:32
P check v9:1 ovf+ INT-SIGNED-OVF
P assign 4 add 2 v1:32 v2:32
P jmp 3
P block
P assign 10 sadd.ovf 2 v2:32 c32:1
P check v10:1 ovf+ INT-SIGNED-OVF
P assign 5 add 2 v2:32 c32:1
P jmp 1
P block
P phi 6 1 1 v1:32
P assign 7 and 2 v0:32 c32:1
P assign 11 sadd.ovf 2 v6:32 v7:32
P check v11:1 ovf+ INT-SIGNED-OVF
P assign 8 add 2 v6:32 v7:32
P ret v8:32
end
func loop_ovf_bad
L params 1 x 32
