private:
    result_type _M_x;
};

class random_device {
public:
    using result_type = unsigned int;

    random_device() = default;
    random_device(const random_device&) = delete;
    random_device& operator=(const random_device&) = delete;

    // May be nondeterministic. It is not a measure of entropy.
    // random_device is not a proof. A program that only calls it is
    // not PROVED and not CLEAN.
    result_type operator()() { return __VERIFIER_nondet_uint(); }
};

// Only the int specialization. uniform_int_distribution<long> and the other
// distributions are not defined. a > b does not store the inverted pair.
// operator() on that range does not return a value. This is not a proof of
// uniformity.
template <class IntType = int>
class uniform_int_distribution;

template <>
class uniform_int_distribution<int> {
public:
    using result_type = int;

    // Stores a and b. The default upper bound is the maximum int, matching
    // the standard default. a > b is a contract failure: the check runs,
    // then __builtin_trap, and the inverted pair is not stored.
    explicit uniform_int_distribution(int a = 0, int b = INT_MAX) {
        if (a > b) {
            __prism_check(0, "FUNC-CONTRACT", "uniform_int_distribution range is inverted");
            __builtin_trap();
        } else {
            _M_a = a;
            _M_b = b;
        }
    }

    result_type a() const { return _M_a; }
    result_type b() const { return _M_b; }
    result_type min() const { return _M_a; }
    result_type max() const { return _M_b; }

    // a == b returns a and does not call __VERIFIER_nondet_uint. Otherwise
    // the span is b - a + 1. A span that does not fit in an unsigned 32-bit
    // count is FUNC-CONTRACT, then __builtin_trap, and does not return a
    // wrapped value. Otherwise the result is a + (nondet % span). That value
    // is inside [a, b]. This is not a proof of uniformity. It is not PROVED
    // and not CLEAN. The engine is not the source of the value.
    template <class URNG>
    result_type operator()(URNG&) {
        if (_M_a > _M_b) {
            __prism_check(0, "FUNC-CONTRACT", "uniform_int_distribution range is inverted");
            __builtin_trap();
        } else if (_M_a == _M_b) {
            return _M_a;
        } else {
            const unsigned long long span =
                static_cast<unsigned long long>(static_cast<long long>(_M_b) - static_cast<long long>(_M_a)) +
                1ull;
            if (span > 0xffffffffull) {
                __prism_check(0, "FUNC-CONTRACT",
                              "uniform_int_distribution span does not fit in an unsigned 32-bit count");
                __builtin_trap();
            } else {
                const unsigned long long pick =
                    static_cast<unsigned long long>(__VERIFIER_nondet_uint()) % span;
                return static_cast<int>(static_cast<long long>(_M_a) + static_cast<long long>(pick));
            }
        }
    }

private:
    result_type _M_a;
    result_type _M_b;
};

}  // namespace std

#endif
