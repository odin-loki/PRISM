// PRISM operational model of <condition_variable> (docs/PIR.md "C++ library models").
// The pir stage puts this directory first on the C++ include path, so
// `#include <condition_variable>` reaches this file instead of libstdc++'s.
// It is a file, not a directory: a directory of this name would make the
// include fail with EISDIR and every such unit would fall back to libstdc++.
//
// Partial on purpose. std::condition_variable stores one bool in the object.
// There is no heap allocation and no thread. This header is not a
// concurrency proof.
//
// notify_one() and notify_all() set that flag. They do not run a waiter.
// A default condition_variable has the flag false.
//
// wait(lock) returns at once. That is a spurious wakeup, which
// [thread.condition.condvar] permits, so it is not a fake wakeup: every
// program correct against the standard already re-checks its condition.
// wait(lock, pred) returns only with pred() true: the model evaluates pred()
// once and __prism_assume()s it, the standard's postcondition on return. A
// path where pred() stays false forever never returns, so no later step of
// that path is checked (a hang is not a memory error here).
// wait_for / wait_until with a predicate return pred() (true or a timeout
// with pred() false, both allowed). Without a predicate they return
// cv_status::no_timeout or cv_status::timeout from havoc:
// the returned status is an unconstrained choice of the two.
// condition_variable_any has the same members over any BasicLockable.
// notify_all_at_thread_exit is not declared, so a use of it fails to compile
// against this header and the pir stage lowers that unit again with
// libstdc++.
//
// The include guard is _GLIBCXX_CONDITION_VARIABLE, the usual libstdc++
// guard. This file does not include a libstdc++ header to learn that name.
// It does not include mutex, thread, atomic, memory, chrono, or functional.
#ifndef _GLIBCXX_CONDITION_VARIABLE
#define _GLIBCXX_CONDITION_VARIABLE 1

#pragma GCC system_header

// PIR intrinsic (translate.cpp). A literal class and message, as in the libc
// models. Not defined here: the analysed program does not link a body.
// Nothing in this header calls it. notify has no failing operation, and a
// woken thread is not invented.
extern "C" void __prism_check(int __ok, const char* __cls, const char* __msg);
extern "C" void __prism_assume(int __cond);
extern "C" void __prism_havoc_bytes(void* __p, unsigned long __n);

namespace std {

enum class cv_status { no_timeout, timeout };

namespace __prism_cv {
// An unconstrained choice between the two statuses.
inline cv_status __any_status() noexcept {
    unsigned char __b = 0;
    __prism_havoc_bytes(&__b, 1);
    return (__b & 1u) ? cv_status::timeout : cv_status::no_timeout;
}
template <class _Pred>
inline void __wait_pred(_Pred& __p) {
    __prism_assume(static_cast<bool>(__p()) ? 1 : 0);
}
}  // namespace __prism_cv

class condition_variable {
    bool _M_flag;

public:
    // A default condition_variable has the flag false.
    condition_variable() noexcept : _M_flag(false) {}

    condition_variable(const condition_variable&) = delete;
    condition_variable& operator=(const condition_variable&) = delete;

    // The flag is a member, not a heap object. Nothing is freed.
    ~condition_variable() = default;


    // Spurious wakeup: allowed by the standard, so returning is sound.
    template <class _Lock>
    void wait(_Lock&) noexcept {}

    // Returns only with pred() true (the standard's postcondition).
    template <class _Lock, class _Pred>
    void wait(_Lock&, _Pred __p) { __prism_cv::__wait_pred(__p); }

    template <class _Lock, class _Dur>
    cv_status wait_for(_Lock&, const _Dur&) noexcept { return __prism_cv::__any_status(); }

    template <class _Lock, class _Dur, class _Pred>
    bool wait_for(_Lock&, const _Dur&, _Pred __p) { return static_cast<bool>(__p()); }

    template <class _Lock, class _Tp>
    cv_status wait_until(_Lock&, const _Tp&) noexcept { return __prism_cv::__any_status(); }

    template <class _Lock, class _Tp, class _Pred>
    bool wait_until(_Lock&, const _Tp&, _Pred __p) { return static_cast<bool>(__p()); }

    // Sets the flag. Does not run a waiter and does not invent a woken thread.
    void notify_one() noexcept { _M_flag = true; }

    // Sets the same flag. Does not run a waiter and does not invent a woken thread.
    void notify_all() noexcept { _M_flag = true; }

    // The handle is the object's own address: it lives exactly as long as the
    // condition_variable, so a read through it after delete is a use after
    // free, as with libstdc++'s handle (a pointer into the object).
    using native_handle_type = condition_variable*;
    native_handle_type native_handle() noexcept { return this; }
};


// Same model over any BasicLockable.
class condition_variable_any {
    bool _M_flag;

public:
    condition_variable_any() : _M_flag(false) {}
    condition_variable_any(const condition_variable_any&) = delete;
    condition_variable_any& operator=(const condition_variable_any&) = delete;
    ~condition_variable_any() = default;

    void notify_one() noexcept { _M_flag = true; }
    void notify_all() noexcept { _M_flag = true; }

    // Spurious wakeup: allowed by the standard, so returning is sound.
    template <class _Lock>
    void wait(_Lock&) noexcept {}

    // Returns only with pred() true (the standard's postcondition).
    template <class _Lock, class _Pred>
    void wait(_Lock&, _Pred __p) { __prism_cv::__wait_pred(__p); }

    template <class _Lock, class _Dur>
    cv_status wait_for(_Lock&, const _Dur&) noexcept { return __prism_cv::__any_status(); }

    template <class _Lock, class _Dur, class _Pred>
    bool wait_for(_Lock&, const _Dur&, _Pred __p) { return static_cast<bool>(__p()); }

    template <class _Lock, class _Tp>
    cv_status wait_until(_Lock&, const _Tp&) noexcept { return __prism_cv::__any_status(); }

    template <class _Lock, class _Tp, class _Pred>
    bool wait_until(_Lock&, const _Tp&, _Pred __p) { return static_cast<bool>(__p()); }
};

}  // namespace std

#endif  // _GLIBCXX_CONDITION_VARIABLE
