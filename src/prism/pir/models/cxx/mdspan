    // Non-owning. Destroying the view does not free _M_ptr.
    ~mdspan() = default;

    size_type size() const noexcept { return _M_size; }

    // extent(0) is the first extent, not the product. An index past the rank
    // is a check, then the last stored extent is what comes back.
    size_type extent(size_type __r) const {
        __prism_check(__r < 7, "FUNC-CONTRACT", "std::mdspan::extent index is outside the rank");
        if (__r == 0) return _M_e0;
        if (__r == 1) return _M_e1;
        if (__r == 2) return _M_e2;
        if (__r == 3) return _M_e3;
        if (__r == 4) return _M_e4;
        if (__r == 5) return _M_e5;
        return _M_e6;
    }

    pointer data() const noexcept { return _M_ptr; }

    // Each index is checked. The address is i * extent(1) * extent(2) *
    // extent(3) * extent(4) * extent(5) * extent(6) + j * extent(2) *
    // extent(3) * extent(4) * extent(5) * extent(6) + k * extent(3) *
    // extent(4) * extent(5) * extent(6) + l * extent(4) * extent(5) *
    // extent(6) + m * extent(5) * extent(6) + n * extent(6) + p in the
    // caller's array, not a padding element. The check does not replace
    // the index; the call still indexes the caller's array.
    reference operator()(size_type __i, size_type __j, size_type __k, size_type __l, size_type __m, size_type __n,
                         size_type __p) const {
        __prism_check(__i < _M_e0 && __j < _M_e1 && __k < _M_e2 && __l < _M_e3 && __m < _M_e4 && __n < _M_e5 &&
                          __p < _M_e6,
                      "MEM-OOB-READ",
                      "std::mdspan::operator() index is outside the extents");
        return _M_ptr[__i * _M_e1 * _M_e2 * _M_e3 * _M_e4 * _M_e5 * _M_e6 +
                      __j * _M_e2 * _M_e3 * _M_e4 * _M_e5 * _M_e6 +
                      __k * _M_e3 * _M_e4 * _M_e5 * _M_e6 + __l * _M_e4 * _M_e5 * _M_e6 +
                      __m * _M_e5 * _M_e6 + __n * _M_e6 + __p];
    }

private:
    _Tp* _M_ptr;
    size_type _M_e0;
    size_type _M_e1;
    size_type _M_e2;
    size_type _M_e3;
    size_type _M_e4;
    size_type _M_e5;
    size_type _M_e6;
    size_type _M_size;
};

template <typename _Tp>
mdspan(_Tp*, std::size_t) -> mdspan<_Tp, 1>;

template <typename _Tp>
mdspan(_Tp*, std::size_t, std::size_t) -> mdspan<_Tp, 2>;

template <typename _Tp>
mdspan(_Tp*, std::size_t, std::size_t, std::size_t) -> mdspan<_Tp, 3>;

template <typename _Tp>
mdspan(_Tp*, std::size_t, std::size_t, std::size_t, std::size_t) -> mdspan<_Tp, 4>;

template <typename _Tp>
mdspan(_Tp*, std::size_t, std::size_t, std::size_t, std::size_t, std::size_t) -> mdspan<_Tp, 5>;

template <typename _Tp>
mdspan(_Tp*, std::size_t, std::size_t, std::size_t, std::size_t, std::size_t, std::size_t) -> mdspan<_Tp, 6>;

template <typename _Tp>
mdspan(_Tp*, std::size_t, std::size_t, std::size_t, std::size_t, std::size_t, std::size_t, std::size_t) -> mdspan<_Tp, 7>;

}  // namespace std

#endif  // _GLIBCXX_MDSPAN
