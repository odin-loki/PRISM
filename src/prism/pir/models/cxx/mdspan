                            __e7 == 0 || __e8 == 0 || __e9 == 0 || __e10 == 0;
        bool __fits = __zero;
        size_type __prod = 0;
        if (!__zero && __e0 <= static_cast<size_type>(-1) / __e1) {
            const size_type __e01 = __e0 * __e1;
            if (__e01 <= static_cast<size_type>(-1) / __e2) {
                const size_type __e012 = __e01 * __e2;
                if (__e012 <= static_cast<size_type>(-1) / __e3) {
                    const size_type __e0123 = __e012 * __e3;
                    if (__e0123 <= static_cast<size_type>(-1) / __e4) {
                        const size_type __e01234 = __e0123 * __e4;
                        if (__e01234 <= static_cast<size_type>(-1) / __e5) {
                            const size_type __e012345 = __e01234 * __e5;
                            if (__e012345 <= static_cast<size_type>(-1) / __e6) {
                                const size_type __e0123456 = __e012345 * __e6;
                                if (__e0123456 <= static_cast<size_type>(-1) / __e7) {
                                    const size_type __e01234567 = __e0123456 * __e7;
                                    if (__e01234567 <= static_cast<size_type>(-1) / __e8) {
                                        const size_type __e012345678 = __e01234567 * __e8;
                                        if (__e012345678 <= static_cast<size_type>(-1) / __e9) {
                                            const size_type __e0123456789 = __e012345678 * __e9;
                                            if (__e0123456789 <= static_cast<size_type>(-1) / __e10) {
                                                __prod = __e0123456789 * __e10;
                                                __fits = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        __prism_check(__fits, "MEM-OOB-READ", "std::mdspan extents product overflows");
        if (__fits) _M_size = __prod;
    }

    // Non-owning. Destroying the view does not free _M_ptr.
    ~__prism_mdspan() = default;

    size_type size() const noexcept { return _M_size; }

    // extent(0) is the first extent, not the product. An index past the rank
    // is a check, then the last stored extent is what comes back.
    size_type extent(size_type __r) const {
        __prism_check(__r < 11, "FUNC-CONTRACT", "std::mdspan::extent index is outside the rank");
        if (__r == 0) return _M_e0;
        if (__r == 1) return _M_e1;
        if (__r == 2) return _M_e2;
        if (__r == 3) return _M_e3;
        if (__r == 4) return _M_e4;
        if (__r == 5) return _M_e5;
        if (__r == 6) return _M_e6;
        if (__r == 7) return _M_e7;
        if (__r == 8) return _M_e8;
        if (__r == 9) return _M_e9;
        return _M_e10;
    }

    pointer data() const noexcept { return _M_ptr; }

    // Each index is checked. The address is i * extent(1) * extent(2) *
    // extent(3) * extent(4) * extent(5) * extent(6) * extent(7) * extent(8) *
    // extent(9) * extent(10) + j * extent(2) * extent(3) * extent(4) *
    // extent(5) * extent(6) * extent(7) * extent(8) * extent(9) * extent(10) +
    // k * extent(3) * extent(4) * extent(5) * extent(6) * extent(7) *
    // extent(8) * extent(9) * extent(10) + l * extent(4) * extent(5) *
    // extent(6) * extent(7) * extent(8) * extent(9) * extent(10) + m *
    // extent(5) * extent(6) * extent(7) * extent(8) * extent(9) * extent(10) +
    // n * extent(6) * extent(7) * extent(8) * extent(9) * extent(10) + p *
    // extent(7) * extent(8) * extent(9) * extent(10) + q * extent(8) *
    // extent(9) * extent(10) + r * extent(9) * extent(10) + s * extent(10) + t
    // in the caller's array, not a padding element. The check does not replace
    // the index; the call still indexes the caller's array.
    reference operator()(size_type __i, size_type __j, size_type __k, size_type __l, size_type __m, size_type __n,
                         size_type __p, size_type __q, size_type __r, size_type __s, size_type __t) const {
        __prism_check(__i < _M_e0 && __j < _M_e1 && __k < _M_e2 && __l < _M_e3 && __m < _M_e4 && __n < _M_e5 &&
                          __p < _M_e6 && __q < _M_e7 && __r < _M_e8 && __s < _M_e9 && __t < _M_e10,
                      "MEM-OOB-READ",
                      "std::mdspan::operator() index is outside the extents");
        return _M_ptr[__i * _M_e1 * _M_e2 * _M_e3 * _M_e4 * _M_e5 * _M_e6 * _M_e7 * _M_e8 * _M_e9 * _M_e10 +
                      __j * _M_e2 * _M_e3 * _M_e4 * _M_e5 * _M_e6 * _M_e7 * _M_e8 * _M_e9 * _M_e10 +
                      __k * _M_e3 * _M_e4 * _M_e5 * _M_e6 * _M_e7 * _M_e8 * _M_e9 * _M_e10 +
                      __l * _M_e4 * _M_e5 * _M_e6 * _M_e7 * _M_e8 * _M_e9 * _M_e10 +
                      __m * _M_e5 * _M_e6 * _M_e7 * _M_e8 * _M_e9 * _M_e10 +
                      __n * _M_e6 * _M_e7 * _M_e8 * _M_e9 * _M_e10 + __p * _M_e7 * _M_e8 * _M_e9 * _M_e10 +
                      __q * _M_e8 * _M_e9 * _M_e10 + __r * _M_e9 * _M_e10 + __s * _M_e10 + __t];
    }

private:
    _Tp* _M_ptr;
    size_type _M_e0;
    size_type _M_e1;
    size_type _M_e2;
    size_type _M_e3;
    size_type _M_e4;
    size_type _M_e5;
    size_type _M_e6;
    size_type _M_e7;
    size_type _M_e8;
    size_type _M_e9;
    size_type _M_e10;
    size_type _M_size;
};

// Standard spelling (C++23 [mdspan.syn]). extents<IndexType, Exts...> keeps
// the static extents for rank() and static_extent(); dynamic_extent entries
// are supplied to the constructor. mdspan<T, Extents, Layout, Accessor>
// derives from the rank model above, so every check is the same. Only
// layout_right with default_accessor is modelled: any other layout or
// accessor is an incomplete type, the unit fails to compile and pir falls
// back.
inline constexpr std::size_t __prism_mdspan_dynamic = static_cast<std::size_t>(-1);

template <typename _IndexType, std::size_t... _Exts>
class extents {
public:
    using index_type = _IndexType;
    using size_type = std::size_t;
    using rank_type = std::size_t;
    static constexpr rank_type rank() noexcept { return sizeof...(_Exts); }
    static constexpr rank_type rank_dynamic() noexcept {
        return ((_Exts == __prism_mdspan_dynamic ? 1u : 0u) + ... + 0u);
    }
    static constexpr std::size_t static_extent(rank_type __r) noexcept {
        constexpr std::size_t __e[] = {_Exts..., 0};
        return __e[__r];
    }
};

template <typename _IndexType, std::size_t _Rank, std::size_t... _Acc>
struct __prism_dextents_build {
    using type = typename __prism_dextents_build<_IndexType, _Rank - 1, _Acc..., __prism_mdspan_dynamic>::type;
};
template <typename _IndexType, std::size_t... _Acc>
struct __prism_dextents_build<_IndexType, 0, _Acc...> {
    using type = extents<_IndexType, _Acc...>;
};

template <typename _IndexType, std::size_t _Rank>
using dextents = typename __prism_dextents_build<_IndexType, _Rank>::type;

struct layout_right {};
template <typename _Tp>
struct default_accessor {
    using element_type = _Tp;
    using reference = _Tp&;
    using data_handle_type = _Tp*;
};

template <typename _Tp, typename _Extents, typename _Layout = layout_right,
          typename _Accessor = default_accessor<_Tp>>
class mdspan;

template <typename _Tp, typename _IndexType, std::size_t... _Exts>
class mdspan<_Tp, extents<_IndexType, _Exts...>, layout_right, default_accessor<_Tp>>
    : public __prism_mdspan<_Tp, sizeof...(_Exts)> {
    using _Base = __prism_mdspan<_Tp, sizeof...(_Exts)>;

public:
    using extents_type = extents<_IndexType, _Exts...>;
    using layout_type = layout_right;
    using accessor_type = default_accessor<_Tp>;
    using typename _Base::reference;
    using typename _Base::size_type;
    using _Base::_Base;

    // C++23 multidimensional subscript. Same bounds check as operator().
    template <typename... _Idx>
    reference operator[](_Idx... __i) const {
        static_assert(sizeof...(_Idx) == sizeof...(_Exts), "std::mdspan::operator[] needs rank() indices");
        return (*this)(static_cast<size_type>(__i)...);
    }
};

template <typename _Tp>
mdspan(_Tp*, std::size_t) -> mdspan<_Tp, dextents<std::size_t, 1>>;

template <typename _Tp>
mdspan(_Tp*, std::size_t, std::size_t) -> mdspan<_Tp, dextents<std::size_t, 2>>;

