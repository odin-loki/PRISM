// Two pointers, then the value: libstdc++'s _List_node<T> (cxx11 ABI).
// max_size() is SIZE_MAX / sizeof(this), not sizeof(the model node).
struct _Prism_list_lib_base {
    void* _M_next;
    void* _M_prev;
};
template <typename _Tp>
struct _Prism_list_lib_node : _Prism_list_lib_base {
    __gnu_cxx::__aligned_membuf<_Tp> _M_storage;
};

// Model node. _M_owner is the sentinel of the list that holds it (the
// sentinel owns itself, so it is not dereferenceable). One extra pointer
// versus libstdc++; max_size() does not use this layout.
struct _Prism_list_link {
    _Prism_list_link* _M_next = nullptr;
    _Prism_list_link* _M_prev = nullptr;
    const _Prism_list_link* _M_owner = nullptr;

    bool _M_dereferenceable() const noexcept { return _M_owner != this; }

    void _M_hook(_Prism_list_link* __pos) noexcept {
        _M_next = __pos;
        _M_prev = __pos->_M_prev;
        __pos->_M_prev->_M_next = this;
        __pos->_M_prev = this;
    }
    void _M_unhook() noexcept {
        _M_prev->_M_next = _M_next;
        _M_next->_M_prev = _M_prev;
    }
};

struct _Prism_list_head : _Prism_list_link {
    _Prism_list_head() noexcept {
        _M_next = _M_prev = this;
        _M_owner = this;
    }
};

template <typename _Tp>
struct _Prism_list_node : _Prism_list_link {
    __gnu_cxx::__aligned_membuf<_Tp> _M_storage;
    _Tp* _M_valptr() noexcept { return _M_storage._M_ptr(); }
    const _Tp* _M_valptr() const noexcept { return _M_storage._M_ptr(); }
};

// Inline replacements for the libstdc++.so hooks. `transfer` splices
// [__first, __last) so it sits just before __pos (a no-op when __pos == __last).
inline void _Prism_list_transfer(_Prism_list_link* __pos, _Prism_list_link* __first,
                                 _Prism_list_link* __last) noexcept {
    if (__pos == __last) return;
    __last->_M_prev->_M_next = __pos;
    __first->_M_prev->_M_next = __last;
    __pos->_M_prev->_M_next = __first;
    _Prism_list_link* const __tmp = __pos->_M_prev;
    __pos->_M_prev = __last->_M_prev;
    __last->_M_prev = __first->_M_prev;
    __first->_M_prev = __tmp;
}

inline void _Prism_list_swap(_Prism_list_link& __x, _Prism_list_link& __y) noexcept {
    if (__x._M_next != &__x) {
        if (__y._M_next != &__y) {
            std::swap(__x._M_next, __y._M_next);
            std::swap(__x._M_prev, __y._M_prev);
            __x._M_next->_M_prev = __x._M_prev->_M_next = &__x;
            __y._M_next->_M_prev = __y._M_prev->_M_next = &__y;
        } else {
            __y._M_next = __x._M_next;
            __y._M_prev = __x._M_prev;
            __y._M_next->_M_prev = __y._M_prev->_M_next = &__y;
            __x._M_next = __x._M_prev = &__x;
        }
    } else if (__y._M_next != &__y) {
        __x._M_next = __y._M_next;
        __x._M_prev = __y._M_prev;
        __x._M_next->_M_prev = __x._M_prev->_M_next = &__x;
        __y._M_next = __y._M_prev = &__y;
    }
}

inline void _Prism_list_reverse(_Prism_list_link* __head) noexcept {
    _Prism_list_link* __tmp = __head;
    do {
        std::swap(__tmp->_M_next, __tmp->_M_prev);
        __tmp = __tmp->_M_prev;  // old next
    } while (__tmp != __head);
}

template <typename _Tp>
struct _Prism_list_const_iterator;

template <typename _Tp>
struct _Prism_list_iterator {
    using _Self = _Prism_list_iterator<_Tp>;
    using _Node = _Prism_list_node<_Tp>;
    using difference_type = ptrdiff_t;
    using iterator_category = bidirectional_iterator_tag;
    using value_type = _Tp;
    using pointer = _Tp*;
    using reference = _Tp&;

    _Prism_list_link* _M_node = nullptr;

    _Prism_list_iterator() noexcept = default;
    explicit _Prism_list_iterator(_Prism_list_link* __x) noexcept : _M_node(__x) {}

    _Self _M_const_cast() const noexcept { return *this; }

    reference operator*() const noexcept {
        __glibcxx_assert(_M_node && _M_node->_M_dereferenceable());
        return *static_cast<_Node*>(_M_node)->_M_valptr();
    }
    pointer operator->() const noexcept {
        __glibcxx_assert(_M_node && _M_node->_M_dereferenceable());
        return static_cast<_Node*>(_M_node)->_M_valptr();
    }
    _Self& operator++() noexcept {
        __glibcxx_assert(_M_node && _M_node->_M_dereferenceable());
        _M_node = _M_node->_M_next;
        return *this;
    }
    _Self operator++(int) noexcept {
        _Self __tmp = *this;
        ++*this;
        return __tmp;
    }
    _Self& operator--() noexcept {
        _M_node = _M_node->_M_prev;
        __glibcxx_assert(_M_node && _M_node->_M_dereferenceable());
        return *this;
    }
    _Self operator--(int) noexcept {
        _Self __tmp = *this;
        --*this;
        return __tmp;
    }
    friend bool operator==(const _Self& __x, const _Self& __y) noexcept { return __x._M_node == __y._M_node; }
};

template <typename _Tp>
struct _Prism_list_const_iterator {
    using _Self = _Prism_list_const_iterator<_Tp>;
    using _Node = const _Prism_list_node<_Tp>;
    using iterator = _Prism_list_iterator<_Tp>;
    using difference_type = ptrdiff_t;
    using iterator_category = bidirectional_iterator_tag;
    using value_type = _Tp;
    using pointer = const _Tp*;
    using reference = const _Tp&;

    const _Prism_list_link* _M_node = nullptr;

    _Prism_list_const_iterator() noexcept = default;
    explicit _Prism_list_const_iterator(const _Prism_list_link* __x) noexcept : _M_node(__x) {}
    _Prism_list_const_iterator(const iterator& __it) noexcept : _M_node(__it._M_node) {}

    iterator _M_const_cast() const noexcept { return iterator(const_cast<_Prism_list_link*>(_M_node)); }

    reference operator*() const noexcept {
        __glibcxx_assert(_M_node && _M_node->_M_dereferenceable());
        return *static_cast<_Node*>(_M_node)->_M_valptr();
    }
    pointer operator->() const noexcept {
        __glibcxx_assert(_M_node && _M_node->_M_dereferenceable());
        return static_cast<_Node*>(_M_node)->_M_valptr();
    }
    _Self& operator++() noexcept {
        __glibcxx_assert(_M_node && _M_node->_M_dereferenceable());
        _M_node = _M_node->_M_next;
        return *this;
    }
    _Self operator++(int) noexcept {
        _Self __tmp = *this;
        ++*this;
        return __tmp;
    }
    _Self& operator--() noexcept {
        _M_node = _M_node->_M_prev;
        __glibcxx_assert(_M_node && _M_node->_M_dereferenceable());
        return *this;
    }
    _Self operator--(int) noexcept {
        _Self __tmp = *this;
        --*this;
        return __tmp;
    }
    friend bool operator==(const _Self& __x, const _Self& __y) noexcept { return __x._M_node == __y._M_node; }
};

