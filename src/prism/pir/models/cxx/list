template <typename _Tp, typename _Alloc = allocator<_Tp>>
class list {
    static_assert(is_same_v<typename remove_cv<_Tp>::type, _Tp>,
                  "std::list must have a non-const, non-volatile value_type");
    static_assert(is_same_v<_Alloc, allocator<_Tp>>,
                  "PRISM list model: only std::allocator<T> is modelled (the pir stage falls back to libstdc++)");

    using _Link = _Prism_list_link;
    using _Node = _Prism_list_node<_Tp>;
    using _Node_alloc = allocator<_Node>;
    using _Node_traits = allocator_traits<_Node_alloc>;

public:
    using value_type = _Tp;
    using allocator_type = _Alloc;
    using size_type = size_t;
    using difference_type = ptrdiff_t;
    using reference = _Tp&;
    using const_reference = const _Tp&;
    using pointer = _Tp*;
    using const_pointer = const _Tp*;
    using iterator = _Prism_list_iterator<_Tp>;
    using const_iterator = _Prism_list_const_iterator<_Tp>;
    using reverse_iterator = std::reverse_iterator<iterator>;
    using const_reverse_iterator = std::reverse_iterator<const_iterator>;

private:
    _Prism_list_head _M_head;
    size_type _M_size = 0;

    static _Tp* _S_val(_Link* __p) noexcept { return static_cast<_Node*>(__p)->_M_valptr(); }
    static const _Tp* _S_val(const _Link* __p) noexcept { return static_cast<const _Node*>(__p)->_M_valptr(); }

    void _M_reset() noexcept {
        _M_head._M_next = _M_head._M_prev = &_M_head;
        _M_head._M_owner = &_M_head;
        _M_size = 0;
    }
    void _M_adopt() noexcept {
        for (_Link* __p = _M_head._M_next; __p != &_M_head; __p = __p->_M_next) __p->_M_owner = &_M_head;
    }
    // Drops every node of a circular header (the list, or a side list of
    // removed nodes) and leaves the header empty. Returns how many were dropped.
    size_type _M_drop_owned(_Link* __head) noexcept {
        size_type __n = 0;
        _Link* __p = __head->_M_next;
        while (__p != __head) {
            _Link* __nxt = __p->_M_next;
            _M_drop(__p);
            __p = __nxt;
            ++__n;
        }
        __head->_M_next = __head->_M_prev = __head;
        __head->_M_owner = __head;
        return __n;
    }
    void _M_link(_Link* __pos, _Node* __n) noexcept {
        __n->_M_hook(__pos);
        __n->_M_owner = &_M_head;
        ++_M_size;
    }
    void _M_erase_one(_Link* __n) noexcept {
        __n->_M_unhook();
        --_M_size;
        _M_drop(__n);
    }
    void _M_check_pos(const _Link* __p) const noexcept {
        __glibcxx_assert(__p && __p->_M_owner == &_M_head);
    }
    void _M_check_elem(const _Link* __p) const noexcept {
        __glibcxx_assert(__p && __p->_M_owner == &_M_head && __p != &_M_head);
    }

    template <typename... _Args>
    _Node* _M_create(_Args&&... __args) {
        _Node_alloc __na;
        _Node* __n = _Node_traits::allocate(__na, 1);
        ::new (static_cast<void*>(__n)) _Node;
        try {
            std::construct_at(__n->_M_valptr(), std::forward<_Args>(__args)...);
        } catch (...) {
            std::destroy_at(__n);
            _Node_traits::deallocate(__na, __n, 1);
            throw;
        }
        return __n;
    }
    void _M_drop(_Link* __b) noexcept {
        _Node* __n = static_cast<_Node*>(__b);
        std::destroy_at(__n->_M_valptr());
        std::destroy_at(__n);
        _Node_alloc __na;
        _Node_traits::deallocate(__na, __n, 1);
    }
    void _M_steal(list& __x) noexcept {
        if (__x._M_head._M_next == &__x._M_head) return;
        _M_head._M_next = __x._M_head._M_next;
        _M_head._M_prev = __x._M_head._M_prev;
        _M_head._M_next->_M_prev = &_M_head;
        _M_head._M_prev->_M_next = &_M_head;
        _M_size = __x._M_size;
        _M_adopt();
        __x._M_reset();
    }
    // New nodes on a side header, then one transfer. A throw drops the side
    // list; *this is unchanged (libstdc++ builds a temporary and splices).
    iterator _M_splice_new(_Link* __pos, _Prism_list_head& __tmp, size_type __n) noexcept {
        if (__n == 0) return iterator(__pos);
        _Link* __first = __tmp._M_next;
        _Prism_list_transfer(__pos, __first, &__tmp);
        for (_Link* __p = __first; __p != __pos; __p = __p->_M_next) __p->_M_owner = &_M_head;
        _M_size += __n;
        return iterator(__first);
    }
    void _M_default_append(size_type __n) {
        size_type __i = 0;
        try {
            for (; __i < __n; ++__i) emplace_back();
        } catch (...) {
            for (; __i; --__i) pop_back();
            throw;
        }
    }
    _Link* _M_at(size_type __n) const noexcept {
        const _Link* __p = _M_head._M_next;
        for (size_type __i = 0; __i < __n; ++__i) __p = __p->_M_next;
        return const_cast<_Link*>(__p);
    }

    template <typename _Pred>
    size_type _M_remove_if(_Pred& __pred) {
        _Prism_list_head __grave;
        try {
            for (_Link* __p = _M_head._M_next; __p != &_M_head;) {
                _Link* __nxt = __p->_M_next;
                if (__pred(*_S_val(__p))) {
                    __p->_M_unhook();
                    --_M_size;
                    __p->_M_hook(__grave._M_next);  // front of the side list
                    __p->_M_owner = &__grave;
                }
                __p = __nxt;
            }
        } catch (...) {
            _M_drop_owned(&__grave);
            throw;
        }
        return _M_drop_owned(&__grave);
    }
    template <typename _BinPred>
    size_type _M_unique(_BinPred& __pred) {
        if (_M_head._M_next == &_M_head) return 0;
        _Prism_list_head __grave;
        _Link* __first = _M_head._M_next;
        try {
            _Link* __next = __first;
            while ((__next = __next->_M_next) != &_M_head) {
                if (__pred(*_S_val(__first), *_S_val(__next))) {
                    _Link* __dead = __next;
                    __dead->_M_unhook();
                    --_M_size;
                    __dead->_M_hook(__grave._M_next);
                    __dead->_M_owner = &__grave;
                } else {
                    __first = __next;
                }
                __next = __first;
            }
        } catch (...) {
            _M_drop_owned(&__grave);
            throw;
        }
        return _M_drop_owned(&__grave);
    }

    // libstdc++'s bottom-up mergesort (list.tcc), with the .so transfers inlined.
    // _M_size stays put: every node is back in *this when this returns, including
    // when the comparator throws (the catch appends the scratch lists).
    template <typename _Cmp>
    void _M_sort(_Cmp __comp) {
        if (_M_head._M_next == &_M_head || _M_head._M_next->_M_next == &_M_head) return;
        struct _PtrCmp {
            _Cmp _M_c;
            bool operator()(_Link* __a, _Link* __b) {
                return _M_c(*_S_val(__a), *_S_val(__b));
            }
        };
        _PtrCmp __pc{__comp};
        struct _Chain {
            _Prism_list_head _M_h;
            bool empty() const noexcept { return _M_h._M_next == &_M_h; }
            void swap_chain(_Chain& __o) noexcept { _Prism_list_swap(_M_h, __o._M_h); }
            void swap_link(_Link& __o) noexcept { _Prism_list_swap(_M_h, __o); }
            void take_one(_Link* __n) noexcept { _Prism_list_transfer(&_M_h, __n, __n->_M_next); }
            void put_all(_Link* __pos) noexcept {
                if (!empty()) _Prism_list_transfer(__pos, _M_h._M_next, &_M_h);
            }
            // By value, as libstdc++'s scratch merge copies the comparator.
            // Not a member template: a local class cannot declare one.
            void merge(_Chain& __x, _PtrCmp __cmp) {
                _Link* __first1 = _M_h._M_next;
                _Link* const __last1 = &_M_h;
                _Link* __first2 = __x._M_h._M_next;
                _Link* const __last2 = &__x._M_h;
                while (__first1 != __last1 && __first2 != __last2) {
                    if (__cmp(__first2, __first1)) {
                        _Link* __next = __first2->_M_next;
                        _Prism_list_transfer(__first1, __first2, __next);
                        __first2 = __next;
                    } else {
                        __first1 = __first1->_M_next;
                    }
                }
                if (__first2 != __last2) _Prism_list_transfer(&_M_h, __first2, __last2);
            }
        };
        _Chain __carry;
        _Chain __tmp[64];
        _Chain* __fill = __tmp;
        try {
            do {
                __carry.take_one(_M_head._M_next);
                _Chain* __counter;
                for (__counter = __tmp; __counter != __fill && !__counter->empty(); ++__counter) {
                    __counter->merge(__carry, __pc);
                    __carry.swap_chain(*__counter);
                }
                __carry.swap_chain(*__counter);
                if (__counter == __fill) ++__fill;
            } while (_M_head._M_next != &_M_head);
            for (_Chain* __counter = __tmp + 1; __counter != __fill; ++__counter)
                __counter->merge(__counter[-1], __pc);
            __fill[-1].swap_link(_M_head);
        } catch (...) {
            __carry.put_all(&_M_head);
            for (int __i = 0; __i < 64; ++__i) __tmp[__i].put_all(&_M_head);
            throw;
        }
    }

    struct _Op_less {
        bool operator()(const value_type& __a, const value_type& __b) const { return __a < __b; }
    };
    struct _Op_eq {
        bool operator()(const value_type& __a, const value_type& __b) const { return __a == __b; }
    };

public:
    list() = default;
    explicit list(const allocator_type&) noexcept {}
    explicit list(size_type __n, const allocator_type& = allocator_type()) { _M_default_append(__n); }
    list(size_type __n, const value_type& __v, const allocator_type& = allocator_type()) {
        for (; __n; --__n) push_back(__v);
    }
    list(const list& __x) {
        for (const _Link* __p = __x._M_head._M_next; __p != &__x._M_head; __p = __p->_M_next)
            _M_link(&_M_head, _M_create(*_S_val(__p)));
    }
    list(list&& __x) noexcept { _M_steal(__x); }
    list(initializer_list<value_type> __l, const allocator_type& = allocator_type()) {
        for (auto __it = __l.begin(); __it != __l.end(); ++__it) emplace_back(*__it);
    }
    list(const list& __x, const allocator_type&) : list(__x) {}
    list(list&& __x, const allocator_type&) noexcept : list(std::move(__x)) {}
    template <typename _InputIterator, typename = _RequireInputIter<_InputIterator>>
    list(_InputIterator __first, _InputIterator __last, const allocator_type& = allocator_type()) {
        for (; __first != __last; ++__first) emplace_back(*__first);
    }
    ~list() { clear(); }

    list& operator=(const list& __x) {
        if (this != std::__addressof(__x)) assign(__x.begin(), __x.end());
        return *this;
    }
    list& operator=(list&& __x) noexcept {
        // libstdc++ leaves a self-move-assigned list unchanged.
        if (this != std::__addressof(__x)) {
            clear();
            _M_steal(__x);
        }
        return *this;
    }
    list& operator=(initializer_list<value_type> __l) {
        assign(__l.begin(), __l.end());
        return *this;
    }

    void assign(size_type __n, const value_type& __v) {
        iterator __i = begin();
        for (; __i != end() && __n > 0; ++__i, --__n) *__i = __v;
        if (__n > 0)
            insert(end(), __n, __v);
        else
            erase(__i, end());
    }
    template <typename _InputIterator, typename = _RequireInputIter<_InputIterator>>
    void assign(_InputIterator __first, _InputIterator __last) {
        iterator __i = begin();
        for (; __i != end() && __first != __last; ++__i, (void)++__first) *__i = *__first;
        if (__first == __last)
            erase(__i, end());
        else
            insert(end(), __first, __last);
    }
    void assign(initializer_list<value_type> __l) { assign(__l.begin(), __l.end()); }

    allocator_type get_allocator() const noexcept { return allocator_type(); }

    iterator begin() noexcept { return iterator(_M_head._M_next); }
    const_iterator begin() const noexcept { return const_iterator(_M_head._M_next); }
    iterator end() noexcept { return iterator(&_M_head); }
    const_iterator end() const noexcept { return const_iterator(&_M_head); }
