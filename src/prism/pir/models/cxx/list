[[nodiscard]] inline bool operator==(const list<_Tp, _Alloc>& __x, const list<_Tp, _Alloc>& __y) {
    if (__x.size() != __y.size()) return false;
    auto __i1 = __x.begin();
    auto __i2 = __y.begin();
    for (auto __e = __x.end(); __i1 != __e; ++__i1, (void)++__i2)
        if (!(*__i1 == *__i2)) return false;
