// PRISM operational model of <list> (roadmap 2.6, docs/PIR.md "C++ library
// models"). The pir stage puts this directory first on the C++ include path,
// so `#include <list>` reaches this file instead of libstdc++'s. libstdc++'s
// node hooks (_List_node_base::_M_hook / _M_unhook / _M_transfer / swap /
// _M_reverse) are out-of-line in libstdc++.so, which the encoder reports as
// UNENCODED. This header is a circular doubly linked list the encoder can
// inline, written to reach every behaviour libstdc++ 13 can for the
// operations it defines:
//
//  * one heap node per element from std::allocator (operator new/delete, PIR
//    models). insert never invalidates. erase, pop, remove, unique, clear,
//    and the destructor free exactly the nodes they drop, so an iterator,
//    pointer or reference to a removed element points into a freed object
//    and using it is MEM-UAF, as it is with libstdc++;
//  * the same element construction and destruction order, including the
//    strong guarantee on insert (build the new nodes, then link them; a
//    throw leaves the list unchanged) and resize's rollback of a throwing
//    default constructor. remove / remove_if / unique splice removed nodes
//    to the front of a side list and destroy that list at the end, so the
//    removed elements are destroyed in reverse order of removal, as
//    libstdc++ 13 does;
//  * max_size() from the size of libstdc++'s _List_node (the model node is
//    larger: it records its container, the way the map model does, so a
//    foreign iterator is a failed precondition rather than a silent unlink);
//  * sort is libstdc++'s iterative mergesort over inline node transfers, so
//    a throwing comparator leaves the same elements in the list. reverse
//    relinks. Neither constructs elements;
//  * _GLIBCXX_ASSERTIONS preconditions (FUNC-CONTRACT, the condition text
//    does not mention size()): !this->empty() on front/back/pop, a
//    dereferenceable iterator on * / ++ / --, an iterator of this list on
//    insert/erase, and a dereferenceable one on erase of a single element.
//    libstdc++'s own <list> does not spell these out (front() is *begin());
//    they are the standard's preconditions, checked the way <vector> is.
//
// What it does not model is not declared, so a unit that names it fails to
// compile against this header and the pir stage lowers it again with
// libstdc++ (extra.cxx_models says so): every splice overload, every merge
// overload, and allocators other than std::allocator<T> (including
// pmr::list). Those are not stubbed. libstdc++ 13's list does not throw
// length_error; this model does not invent that check.
#ifndef _PRISM_MODEL_LIST
#define _PRISM_MODEL_LIST 1
#define _GLIBCXX_LIST 1  // libstdc++'s <list> include guard: never both

#pragma GCC system_header

#include <bits/c++config.h>
#include <bits/stl_algobase.h>
#include <bits/allocator.h>
#include <bits/alloc_traits.h>
#include <bits/stl_iterator_base_funcs.h>
#include <bits/stl_iterator.h>
#include <bits/functexcept.h>
#include <bits/range_access.h>
#include <bits/stl_algo.h>
#include <ext/aligned_buffer.h>
#include <initializer_list>
#include <type_traits>
#include <compare>
#include <memory>
#include <new>
#include <utility>
#include <bits/memory_resource.h>
#include <debug/assertions.h>

