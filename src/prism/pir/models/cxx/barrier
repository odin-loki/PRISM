// PRISM operational model of <barrier> (roadmap 2.6, docs/PIR.md "C++ library
// models"). The pir stage puts this directory first on the C++ include path,
// so `#include <barrier>` reaches this file instead of libstdc++'s. It is a
// file, not a directory: a directory of this name would make the include fail
// with EISDIR and every such unit would fall back to libstdc++.
//
// Partial model. The expected arrival count is a ptrdiff_t stored in the
// object. A negative constructor argument is a check and is not stored; the
// count stays 0. A non-negative argument is stored. Nothing here allocates,
// and nothing starts a thread. This header is not a concurrency proof: the
// count is not atomic, and arrive does not pretend that other threads
// arrived.
//
// max() is modelled: it returns PTRDIFF_MAX. It does not wait and it does
// not change any barrier.
//
// arrive(n) does not wait. A negative n is FUNC-CONTRACT, then
// __builtin_trap, and the count does not increase. n == 0 changes nothing
// and does not trap. n greater than the remaining expected count is
// FUNC-CONTRACT, then __builtin_trap, and the count does not wrap.
// Otherwise arrive subtracts n. arrive is not PROVED and not CLEAN.
//
// wait and arrive_and_wait stay omitted. A blocking wait that returns
// immediately would be a fake synchronization success. Those names are
// omitted so the unit fails to compile and pir falls back to libstdc++.
//
// arrive_and_drop() decreases the expected count by one and does not wait.
// If the expected count is already zero, it is a check.
//
// This file does not include <atomic>, <latch>, <semaphore>, or <thread>.
#ifndef _GLIBCXX_BARRIER
#define _GLIBCXX_BARRIER 1

#pragma GCC system_header

#include <cstddef>
#include <cstdint>

// PIR intrinsic (translate.cpp). A literal class and message, as in the libc
// models. Not defined here: the analysed program does not link a body.
extern "C" void __prism_check(int ok, const char* cls, const char* msg);

namespace std {

class barrier {
    // Expected arrival count. A negative constructor argument is not stored;
    // the count stays 0. No heap control block.
    ptrdiff_t _M_expected;

public:
    // Stores the argument when it is non-negative. A negative argument fails
    // the check and leaves the expected count at 0.
    explicit barrier(ptrdiff_t __expected) noexcept : _M_expected(0) {
        const int __ok = __expected >= 0 ? 1 : 0;
        __prism_check(__ok, "FUNC-CONTRACT",
                      "barrier constructed with a negative count");
        if (__ok)
            _M_expected = __expected;
    }

    barrier(const barrier&) = delete;
    barrier& operator=(const barrier&) = delete;

    // No thread to join and no allocation to release.
    ~barrier() = default;

    // max() is modelled. It returns PTRDIFF_MAX. It does not wait and it
    // does not change any barrier. This is not a concurrency proof.
    static constexpr ptrdiff_t max() noexcept { return PTRDIFF_MAX; }

    // Does not wait. arrive is not PROVED and not CLEAN.
    void arrive(ptrdiff_t __n = 1) {
        // arrive is not PROVED and not CLEAN.
        // A negative update would increase the count. Leave the count alone.
        if (__n < 0) {
            __prism_check(0, "FUNC-CONTRACT", "barrier::arrive called with a negative count");
            __builtin_trap();
        } else if (__n == 0) {
            // n == 0 changes nothing.
            return;
        } else if (__n > _M_expected) {
            // Greater than the remaining expected count. The stored count is left unchanged.
            __prism_check(0, "FUNC-CONTRACT", "barrier::arrive count exceeds the expected count");
            __builtin_trap();
        } else {
            _M_expected -= __n;
        }
    }

    // One less expected arrival. Does not wait. Already zero is a check,
    // and the count stays zero.
    void arrive_and_drop() {
        __prism_check(_M_expected == 0 ? 0 : 1, "CXX-BARRIER-DROP",
                      "barrier::arrive_and_drop when the expected count is already zero");
        if (_M_expected != 0)
            --_M_expected;
    }
};

}  // namespace std

#endif
