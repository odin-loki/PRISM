// PRISM operational model of <numeric>. Partial on purpose.
// The pir stage puts this directory first on the C++ include path, so
// `#include <numeric>` reaches this file instead of libstdc++'s.
//
// std::midpoint for integers does not overflow. The distance is formed in
// the corresponding unsigned type, and half of that distance is applied to
// one argument. The result is one of the two arguments or strictly between
// them. midpoint of two equal large values is that same value.
//
// std::gcd is the Euclidean algorithm on the absolute values. gcd(0, 0) is 0.
//
// std::lcm(0, x), std::lcm(x, 0), and std::lcm(0, 0) are 0. Otherwise the
// value is |m| / gcd(|m|, |n|) * |n|, formed in the unsigned common type.
// A product that does not fit in the return type is __prism_check with class
// FUNC-CONTRACT, then __builtin_trap. That path does not return a wrapped
// product and does not return 0.
//
// Not declared here, so naming accumulate, reduce, transform_reduce,
// inner_product, adjacent_difference, partial_sum, iota, or exclusive_scan
// fails to compile and the pir stage falls back to libstdc++
// (extra.cxx_models). A partial header is intentional.
#ifndef _GLIBCXX_NUMERIC
#define _GLIBCXX_NUMERIC 1

#pragma GCC system_header

#include <type_traits>

// PIR intrinsic (translate.cpp). Literal class and message. Declared, not
// defined: the analysed program does not link a body.
extern "C" void __prism_check(int, const char*, const char*);

namespace std {

// Magnitude as an unsigned value. A negative signed value, including the
// minimum of that type, converts without a signed negation.
template <typename _Up, typename _Tp>
constexpr _Up _Prism_numeric_absu(_Tp __v) noexcept {
    static_assert(is_unsigned_v<_Up>, "magnitude is an unsigned type");
    if constexpr (is_signed_v<_Tp>) {
        if (__v < 0) return static_cast<_Up>(0) - static_cast<_Up>(__v);
    }
    return static_cast<_Up>(__v);
}

// [numeric.ops.midpoint]. Both arguments have the same integer type, and
// that type is not bool. Half the unsigned distance stays in range, then
// the cast back is the midpoint.
template <typename _Tp>
constexpr enable_if_t<is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>, _Tp>
midpoint(_Tp __a, _Tp __b) noexcept {
    using _Up = make_unsigned_t<_Tp>;
    if (__a > __b) {
        const _Up __diff = static_cast<_Up>(__a) - static_cast<_Up>(__b);
        return static_cast<_Tp>(static_cast<_Up>(__a) - (__diff / 2));
    }
    const _Up __diff = static_cast<_Up>(__b) - static_cast<_Up>(__a);
    return static_cast<_Tp>(static_cast<_Up>(__a) + (__diff / 2));
}

// [numeric.ops.gcd]. Both magnitudes 0: the loop does not run, and the
// value returned is 0.
template <typename _Mn, typename _Nn>
constexpr enable_if_t<is_integral_v<_Mn> && is_integral_v<_Nn> && !is_same_v<remove_cv_t<_Mn>, bool> &&
                          !is_same_v<remove_cv_t<_Nn>, bool>,
                      common_type_t<_Mn, _Nn>>
gcd(_Mn __m, _Nn __n) noexcept {
    using _Ct = common_type_t<_Mn, _Nn>;
    using _Up = make_unsigned_t<_Ct>;
    _Up __um = _Prism_numeric_absu<_Up>(static_cast<_Ct>(__m));
    _Up __un = _Prism_numeric_absu<_Up>(static_cast<_Ct>(__n));
    while (__un != 0) {
        const _Up __r = __um % __un;
        __um = __un;
        __un = __r;
    }
    return static_cast<_Ct>(__um);
}

// [numeric.ops.lcm]. A zero magnitude is 0, including both zero, before any
// product. Otherwise the value is |m| / gcd(|m|, |n|) * |n| in the unsigned
// common type. A product that does not fit in the return type is not a
// result: __prism_check, then __builtin_trap. That path does not return a
// wrapped product and does not return 0 for a nonzero pair.
template <typename _Mn, typename _Nn>
constexpr enable_if_t<is_integral_v<_Mn> && is_integral_v<_Nn> && !is_same_v<remove_cv_t<_Mn>, bool> &&
                          !is_same_v<remove_cv_t<_Nn>, bool>,
                      common_type_t<_Mn, _Nn>>
lcm(_Mn __m, _Nn __n) noexcept {
    using _Ct = common_type_t<_Mn, _Nn>;
    using _Up = make_unsigned_t<_Ct>;
    const _Up __um = _Prism_numeric_absu<_Up>(__m);
    const _Up __un = _Prism_numeric_absu<_Up>(__n);
    if (__um == 0 || __un == 0) return static_cast<_Ct>(0);
    const _Up __g = gcd(__um, __un);
    // Both magnitudes are nonzero, so this quotient is at least 1.
    const _Up __q = __um / __g;
    const _Up __lim = is_signed_v<_Ct> ? static_cast<_Up>(static_cast<_Up>(-1) >> 1) : static_cast<_Up>(-1);
    if (__un > __lim / __q) {
        __prism_check(0, "FUNC-CONTRACT", "std::lcm product does not fit in the return type");
        __builtin_trap();
    }
    return static_cast<_Ct>(__q * __un);
}

}  // namespace std

#endif
