// PRISM operational model of <numeric>. Partial on purpose.
// The pir stage puts this directory first on the C++ include path, so
// `#include <numeric>` reaches this file instead of libstdc++'s.
//
// std::midpoint for integers does not overflow. The distance is formed in
// the corresponding unsigned type, and half of that distance is applied to
// one argument. The result is one of the two arguments or strictly between
// them. midpoint of two equal large values is that same value.
//
// std::gcd is the Euclidean algorithm on the absolute values. gcd(0, 0) is 0.
//
// std::lcm(0, x), std::lcm(x, 0), and std::lcm(0, 0) are 0. Otherwise the
// value is |m| / gcd(|m|, |n|) * |n|, formed in the unsigned common type.
// A product that does not fit in the return type is __prism_check with class
// FUNC-CONTRACT, then __builtin_trap. That path does not return a wrapped
// product and does not return 0.
//
// std::iota takes two pointers of one type and a starting value of that
// type. last < first is __prism_check with class FUNC-CONTRACT, then
// __builtin_trap, and stores nothing. first == last writes nothing.
// Otherwise the range receives value, value + 1, and so on. A next value
// that does not fit in the element type is __prism_check, then
// __builtin_trap. The class is INT-SIGNED-OVF for a signed integer and
// FUNC-CONTRACT otherwise. That path does not store a wrapped value.
//
// std::accumulate takes two pointers of one type and an initial value of
// that type. last < first is __prism_check with class FUNC-CONTRACT, then
// __builtin_trap. That path does not read and does not return a wrapped
// init. first == last returns init and does not read. Otherwise the result
// is init plus each element in order. A sum that does not fit is
// __prism_check, then __builtin_trap. The class is INT-SIGNED-OVF for a
// signed integer and FUNC-CONTRACT otherwise. That path does not return a
// wrapped sum.
//
// Not declared here, so naming reduce, transform_reduce, inner_product,
// adjacent_difference, partial_sum, or exclusive_scan fails to compile
// and the pir stage falls back to libstdc++ (extra.cxx_models). A partial
// header is intentional.
#ifndef _GLIBCXX_NUMERIC
#define _GLIBCXX_NUMERIC 1

#pragma GCC system_header

#include <type_traits>

// PIR intrinsic (translate.cpp). Literal class and message. Declared, not
// defined: the analysed program does not link a body.
extern "C" void __prism_check(int, const char*, const char*);

namespace std {

// Magnitude as an unsigned value. A negative signed value, including the
// minimum of that type, converts without a signed negation.
template <typename _Up, typename _Tp>
constexpr _Up _Prism_numeric_absu(_Tp __v) noexcept {
    static_assert(is_unsigned_v<_Up>, "magnitude is an unsigned type");
    if constexpr (is_signed_v<_Tp>) {
        if (__v < 0) return static_cast<_Up>(0) - static_cast<_Up>(__v);
    }
    return static_cast<_Up>(__v);
}

// [numeric.ops.midpoint]. Both arguments have the same integer type, and
// that type is not bool. Half the unsigned distance stays in range, then
// the cast back is the midpoint.
template <typename _Tp>
constexpr enable_if_t<is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>, _Tp>
midpoint(_Tp __a, _Tp __b) noexcept {
    using _Up = make_unsigned_t<_Tp>;
    if (__a > __b) {
        const _Up __diff = static_cast<_Up>(__a) - static_cast<_Up>(__b);
        return static_cast<_Tp>(static_cast<_Up>(__a) - (__diff / 2));
    }
    const _Up __diff = static_cast<_Up>(__b) - static_cast<_Up>(__a);
    return static_cast<_Tp>(static_cast<_Up>(__a) + (__diff / 2));
}

// [numeric.ops.gcd]. Both magnitudes 0: the loop does not run, and the
// value returned is 0.
template <typename _Mn, typename _Nn>
constexpr enable_if_t<is_integral_v<_Mn> && is_integral_v<_Nn> && !is_same_v<remove_cv_t<_Mn>, bool> &&
                          !is_same_v<remove_cv_t<_Nn>, bool>,
                      common_type_t<_Mn, _Nn>>
gcd(_Mn __m, _Nn __n) noexcept {
    using _Ct = common_type_t<_Mn, _Nn>;
    using _Up = make_unsigned_t<_Ct>;
    _Up __um = _Prism_numeric_absu<_Up>(static_cast<_Ct>(__m));
    _Up __un = _Prism_numeric_absu<_Up>(static_cast<_Ct>(__n));
    while (__un != 0) {
        const _Up __r = __um % __un;
        __um = __un;
        __un = __r;
    }
    return static_cast<_Ct>(__um);
}

// [numeric.ops.lcm]. A zero magnitude is 0, including both zero, before any
// product. Otherwise the value is |m| / gcd(|m|, |n|) * |n| in the unsigned
// common type. A product that does not fit in the return type is not a
// result: __prism_check, then __builtin_trap. That path does not return a
// wrapped product and does not return 0 for a nonzero pair.
template <typename _Mn, typename _Nn>
constexpr enable_if_t<is_integral_v<_Mn> && is_integral_v<_Nn> && !is_same_v<remove_cv_t<_Mn>, bool> &&
                          !is_same_v<remove_cv_t<_Nn>, bool>,
                      common_type_t<_Mn, _Nn>>
lcm(_Mn __m, _Nn __n) noexcept {
    using _Ct = common_type_t<_Mn, _Nn>;
    using _Up = make_unsigned_t<_Ct>;
    const _Up __um = _Prism_numeric_absu<_Up>(__m);
    const _Up __un = _Prism_numeric_absu<_Up>(__n);
    if (__um == 0 || __un == 0) return static_cast<_Ct>(0);
    const _Up __g = gcd(__um, __un);
    // Both magnitudes are nonzero, so this quotient is at least 1.
    const _Up __q = __um / __g;
    const _Up __lim = is_signed_v<_Ct> ? static_cast<_Up>(static_cast<_Up>(-1) >> 1) : static_cast<_Up>(-1);
    if (__un > __lim / __q) {
        __prism_check(0, "FUNC-CONTRACT", "std::lcm product does not fit in the return type");
        __builtin_trap();
    }
    return static_cast<_Ct>(__q * __un);
}

// [numeric.iota]. Two pointers of the same type, and a starting value of
// that type. A value of a different type does not match this overload.
// last < first fails the check before any store. An empty range returns
// before any store. The next value is formed only when another element
// remains, and only in the else of the fit test, so a wrapped value is
// not stored. A signed integer uses INT-SIGNED-OVF. An unsigned integer
// uses FUNC-CONTRACT. bool and a non-integer use ++ and have no separate
// range check.
template <typename _Tp>
constexpr void
iota(_Tp* __first, _Tp* __last, _Tp __value) {
    if (__last < __first) {
        __prism_check(0, "FUNC-CONTRACT", "std::iota last is before first");
        __builtin_trap();
    }
    if (__first == __last) return;
    while (__first != __last) {
        *__first = __value;
        ++__first;
        if (__first == __last) return;
        if constexpr (is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>) {
            if constexpr (is_signed_v<_Tp>) {
                using _Up = make_unsigned_t<_Tp>;
                const _Tp __lim = static_cast<_Tp>(static_cast<_Up>(-1) >> 1);
                if (__value == __lim) {
                    __prism_check(0, "INT-SIGNED-OVF", "std::iota next value does not fit in T");
                    __builtin_trap();
                } else {
                    __value = static_cast<_Tp>(__value + static_cast<_Tp>(1));
                }
            } else {
                if (__value == static_cast<_Tp>(-1)) {
                    __prism_check(0, "FUNC-CONTRACT", "std::iota next value does not fit in T");
                    __builtin_trap();
                } else {
                    __value = static_cast<_Tp>(__value + static_cast<_Tp>(1));
                }
            }
        } else {
            ++__value;
        }
    }
}

// [accumulate]. Two pointers of the same type, and an initial value of that
// type. A value of a different type does not match this overload. last <
// first fails the check before any read and does not return init. An empty
// range returns init before any read. The next sum is formed only when
// another element remains, and only in the else of the fit test, so a
// wrapped sum is not returned. A signed integer uses INT-SIGNED-OVF. An
// unsigned integer uses FUNC-CONTRACT. bool and a non-integer add with no
// separate range check. The signed maximum is an unsigned shift of all-ones,
// and the minimum is -1 minus that maximum, so the test itself does not
// overflow. The unsigned limit is the maximum value of T.
template <typename _Tp>
constexpr _Tp
accumulate(_Tp* __first, _Tp* __last, _Tp __init) {
    if (__last < __first) {
        __prism_check(0, "FUNC-CONTRACT", "std::accumulate last is before first");
        __builtin_trap();
    }
    if (__first == __last) return __init;
    while (__first != __last) {
        if constexpr (is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>) {
            if constexpr (is_signed_v<_Tp>) {
                using _Up = make_unsigned_t<_Tp>;
                const _Tp __lim = static_cast<_Tp>(static_cast<_Up>(-1) >> 1);
                // -1 - max is the minimum, and that difference is representable.
                const _Tp __min = static_cast<_Tp>(static_cast<_Tp>(-1) - __lim);
                const _Tp __elem = *__first;
                if ((__elem > static_cast<_Tp>(0) && __init > __lim - __elem) ||
                    (__elem < static_cast<_Tp>(0) && __init < __min - __elem)) {
                    __prism_check(0, "INT-SIGNED-OVF", "std::accumulate sum does not fit in T");
                    __builtin_trap();
                } else {
                    __init = static_cast<_Tp>(__init + __elem);
                }
            } else {
                const _Tp __elem = *__first;
                if (__init > static_cast<_Tp>(-1) - __elem) {
                    __prism_check(0, "FUNC-CONTRACT", "std::accumulate sum does not fit in T");
                    __builtin_trap();
                } else {
                    __init = static_cast<_Tp>(__init + __elem);
                }
            }
        } else {
            __init = static_cast<_Tp>(__init + *__first);
        }
        ++__first;
    }
    return __init;
}

}  // namespace std

#endif
