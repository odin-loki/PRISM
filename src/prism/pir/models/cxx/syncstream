// PRISM operational model of <syncstream>. The pir stage puts this directory
// first on the C++ include path, so `#include <syncstream>` reaches this file
// instead of libstdc++'s. It is a file, not a directory: a directory of
// this name would make the include fail with EISDIR and every such unit
// would fall back to libstdc++.
//
// basic_syncbuf stores a caller char pointer, a size, and an offset.
// Nothing is allocated. The destructor does not free the caller buffer and
// does not pretend the bytes were emitted to a stream.
//
// sputc writes one character only when the offset is less than the size,
// then advances. When the offset is already the size, sputc is a
// __prism_check: it does not write and does not wrap the offset. A null
// pointer with a non-zero size is a __prism_check at construction. That
// failure stores size 0, so a later sputc, sgetc, or sungetc does not use
// the pointer.
//
// sgetc returns the unsigned char at the offset and advances by one only
// when the offset is less than the size. When the offset is already the
// size, including a size of 0, sgetc is a __prism_check (MEM-OOB-READ): it
// does not read the pointer and does not return a character from the buffer.
// -1 is the end signal after that check. A null buffer whose size was forced
// to 0 takes that path.
//
// sungetc steps the offset back by one when it is greater than 0 and
// returns the unsigned char now at that offset. When the offset is 0,
// sungetc is a __prism_check (MEM-OOB-READ): it does not decrement and does
// not read before the buffer. -1 is the end signal after that check. A null
// buffer whose size was forced to 0 takes that path.
//
// emit and the syncstream class are omitted so a unit that names one
// fails to compile and pir falls back to libstdc++. A flush that returns
// success without a stream would be a fake write. Move construction and
// move assignment are not declared, for the same reason.
//
// This header is not a concurrency proof.
#ifndef _GLIBCXX_SYNCSTREAM
#define _GLIBCXX_SYNCSTREAM 1

#pragma GCC system_header

#include <cstddef>

// Set only by this stand-in. Task sources use it so a libstdc++ <syncstream>
// (no caller-buffer constructor) still compiles for the label self-check.
#define _PRISM_SYNCSTREAM_MODEL 1

// PIR intrinsic (translate.cpp). A literal class and message, as in the
// libc models. Not defined here: the analysed program does not link a body.
extern "C" void __prism_check(int ok, const char* cls, const char* msg);

namespace std {

class basic_syncbuf {
public:
    // Caller buffer. A null pointer with a non-zero size is a precondition
    // failure. Nothing is allocated.
    explicit basic_syncbuf(char* __buf, size_t __n) noexcept : _M_buf(__buf), _M_size(__n), _M_off(0) {
        __prism_check((__buf != nullptr || __n == 0) ? 1 : 0, "FUNC-CONTRACT",
                      "basic_syncbuf constructed with a null buffer and a non-zero size");
        // A failing check does not leave a size that sputc would write through
        // or that sgetc or sungetc would read through.
        if (!(__buf != nullptr || __n == 0)) _M_size = 0;
    }

    // Does not free the caller buffer. Does not pretend the bytes were
    // emitted to a stream.
    ~basic_syncbuf() = default;

    basic_syncbuf(const basic_syncbuf&) = delete;
    basic_syncbuf& operator=(const basic_syncbuf&) = delete;

    // Writes one character only when the offset is less than the size, then
    // advances. When the offset is already the size this is a precondition
    // failure: the character is not stored and the offset is not wrapped.
    void sputc(char __c) noexcept {
        const int __ok = (_M_off < _M_size) ? 1 : 0;
        __prism_check(__ok, "MEM-OOB-WRITE", "basic_syncbuf::sputc would write past the caller buffer");
        if (__ok) {
            _M_buf[_M_off] = __c;
            ++_M_off;
        }
    }

    // Returns the unsigned char at the offset and advances by one when the
    // offset is less than the size. When the offset is already the size,
    // including a size of 0, the pointer is not read. -1 is the end signal
    // after the check, not a character from the buffer. A null buffer whose
    // size was forced to 0 takes that path.
    int sgetc() noexcept {
        const int __in = (_M_off < _M_size) ? 1 : 0;
        __prism_check(__in, "MEM-OOB-READ", "basic_syncbuf::sgetc would read past the caller buffer");
        if (__in) {
            const unsigned char __ch = static_cast<unsigned char>(_M_buf[_M_off]);
            ++_M_off;
            return static_cast<int>(__ch);
        }
        return -1;
    }

    // Steps the offset back by one when it is greater than 0 and returns
    // the unsigned char now at that offset. When the offset is 0 the offset
    // is not decremented and the pointer is not read. -1 is the end signal
    // after the check, not a character from the buffer. A null buffer whose
    // size was forced to 0 takes that path.
    int sungetc() noexcept {
        const int __back = (_M_off > 0) ? 1 : 0;
        __prism_check(__back, "MEM-OOB-READ", "basic_syncbuf::sungetc would read before the caller buffer");
        if (__back) {
            --_M_off;
            const unsigned char __ch = static_cast<unsigned char>(_M_buf[_M_off]);
            return static_cast<int>(__ch);
        }
        return -1;
    }

private:
    char* _M_buf;
    size_t _M_size;
    size_t _M_off;
};

}  // namespace std

#endif
