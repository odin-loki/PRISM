// PRISM operational model of <spanstream> (docs/PIR.md "C++ library models").
// The pir stage puts this directory first on the C++ include path, so
// `#include <spanstream>` reaches this file instead of libstdc++'s.
//
// Partial on purpose. Only std::basic_spanbuf for char is modelled. It stores
// a char pointer, a size, and an offset. It does not allocate. The
// destructor is defaulted and does not free. The characters belong to the
// caller.
//
// sputc writes one character only when the offset is less than the size, then
// advances the offset. When the offset is already the size, including a size
// of 0, sputc is a precondition failure (__prism_check) and does not write.
// A null pointer with a non-zero size is a check at construction. That size
// is kept: the pointer is not turned into an empty buffer.
//
// sgetc reads one character only when the offset is less than the size, then
// advances the offset. The result is that byte as an unsigned char, so 255
// is not an end signal. When the offset is already the size, including a
// size of 0, sgetc is a precondition failure (__prism_check, MEM-OOB-READ)
// and does not read the pointer. It then returns -1, char_traits-style EOF,
// only as that end signal. A null pointer with size 0 is that same end:
// the pointer is not read.
//
// sungetc steps the offset back one when it is greater than 0, then returns
// the unsigned char at the new offset, so 255 is not an end signal. When the
// offset is already 0, sungetc is a precondition failure (__prism_check,
// MEM-OOB-READ) and does not decrement and does not read before the buffer.
// It then returns -1 only after that check. A null pointer with size 0 takes
// that same offset-0 path and is not read.
//
// sputn writes min(count, remaining space) characters from a caller source
// and returns how many were stored. It does not write past the buffer. A
// negative count, a null source with a positive count, and a product of the
// count and the element size that does not fit are checks and then
// __builtin_trap. A count of 0 returns 0 and does not read or write.
//
// Omitted names are not declared here. A use of one fails to compile against
// this header, and the pir stage falls back to libstdc++ (extra.cxx_models).
// They are omitted because declaring them would include the span or sstream
// headers. This file does not include those, or string, or string_view:
//  * std::spanstream, std::ispanstream, std::ospanstream
//  * std::basic_spanstream, std::basic_ispanstream, std::basic_ospanstream
//  * a constructor or span() that takes or returns std::span
//  * basic_spanbuf's traits parameter, and wchar_t spanbufs
#ifndef _GLIBCXX_SPANSTREAM
#define _GLIBCXX_SPANSTREAM 1  // libstdc++'s <spanstream> include guard: never both

#pragma GCC system_header

#include <bits/c++config.h>
#include <cstddef>
#include <type_traits>

// PIR intrinsic (src/prism/pir/models/libc/prism_model.h). Declared, not
// defined: translate.cpp reports the call. A definition here would be inlined
// away and the check would disappear.
extern "C" void __prism_check(int __ok, const char* __cls, const char* __msg);

namespace std _GLIBCXX_VISIBILITY(default) {
_GLIBCXX_BEGIN_NAMESPACE_VERSION

template <typename _CharT>
class basic_spanbuf {
    static_assert(is_same_v<_CharT, char>,
                  "PRISM spanstream model: only char is modelled (the pir stage falls back to libstdc++)");

public:
    basic_spanbuf() noexcept : _M_ptr(nullptr), _M_size(0), _M_off(0) {}

    // Stores __p and __n. A null pointer with a non-zero size is a
    // precondition failure. The size stays __n: this is not an empty buffer.
    basic_spanbuf(char* __p, size_t __n) : _M_ptr(__p), _M_size(__n), _M_off(0) {
        __prism_check(__p != nullptr || __n == 0, "PTR-NULL-DEREF",
                      "std::basic_spanbuf constructed from a null pointer with a non-zero size");
    }

    basic_spanbuf(const basic_spanbuf&) noexcept = default;
    basic_spanbuf& operator=(const basic_spanbuf&) noexcept = default;

    // Does not allocate and does not free. The characters belong to the caller.
    ~basic_spanbuf() noexcept = default;

    [[nodiscard]] size_t size() const noexcept { return _M_size; }

    // One character when the offset is still inside the caller buffer, then
    // the offset advances. At the size (a size of 0 is already there) this
    // is a precondition failure and the buffer is not written.
    int sputc(char __c) {
        __prism_check(_M_off < _M_size, "MEM-OOB-WRITE", "std::basic_spanbuf::sputc write at size");
        if (_M_off < _M_size) {
            _M_ptr[_M_off] = __c;
            ++_M_off;
            return static_cast<int>(static_cast<unsigned char>(__c));
        }
        return -1;
    }

    // One character when the offset is still inside the caller buffer, then
    // the offset advances. The result is that byte as unsigned char (0..255).
    // At the size, including a size of 0, this is a precondition failure and
    // the pointer is not read. -1 is char_traits-style EOF, only that end
    // signal, and only after the check. A null pointer with size 0 takes
    // this end path and is not read.
    int sgetc() {
        __prism_check(_M_off < _M_size, "MEM-OOB-READ", "std::basic_spanbuf::sgetc read at size");
        if (_M_off < _M_size) {
            const int __r = static_cast<int>(static_cast<unsigned char>(_M_ptr[_M_off]));
            ++_M_off;
            return __r;
        }
        return -1;
    }

    // One character back when the offset is greater than 0: the offset moves
    // back one, then that byte is returned as unsigned char (0..255). When
    // the offset is already 0, this is a precondition failure and the pointer
    // is not read. The offset is not decremented. -1 is char_traits-style
    // EOF, only that end signal, and only after the check. A null pointer
    // with size 0 takes this path and is not read.
    int sungetc() {
        __prism_check(_M_off > 0, "MEM-OOB-READ", "std::basic_spanbuf::sungetc read before the buffer");
        if (_M_off > 0) {
            --_M_off;
            const int __r = static_cast<int>(static_cast<unsigned char>(_M_ptr[_M_off]));
            return __r;
        }
        return -1;
    }

    // Writes min(__n, remaining) characters and returns how many were stored.
    // A negative count is FUNC-CONTRACT, then __builtin_trap, and does not
    // write. A null source with a positive count is PTR-NULL-DEREF, then
    // __builtin_trap, and does not write. A count of 0 returns 0 and does not
    // read or write. The product of the count and the element size is formed
    // only when it fits; otherwise that is FUNC-CONTRACT, then __builtin_trap,
    // and the length is not a wrapped product. The unwritten tail is not
    // stored. sputn is not PROVED and not CLEAN.
    std::ptrdiff_t sputn(const char* __s, std::ptrdiff_t __n) {
        if (__n < 0) {
            __prism_check(0, "FUNC-CONTRACT", "std::basic_spanbuf::sputn negative count");
            __builtin_trap();
        } else if (__n == 0) {
            return 0;
        } else if (__s == nullptr) {
            __prism_check(0, "PTR-NULL-DEREF", "std::basic_spanbuf::sputn null source");
            __builtin_trap();
        } else if (static_cast<size_t>(__n) > (static_cast<size_t>(-1) / sizeof(_CharT))) {
            // The product does not fit. Do not form a wrapped length.
            __prism_check(0, "FUNC-CONTRACT",
                          "std::basic_spanbuf::sputn count times element size does not fit");
            __builtin_trap();
        } else {
            // Fits. For char the element size is 1, so this is the character
            // count. It is not a wrapped value.
            const size_t __bytes = static_cast<size_t>(__n) * sizeof(_CharT);
            const size_t __room = _M_off < _M_size ? _M_size - _M_off : 0;
            // min(count, remaining). Characters past __stored are not stored,
            // and the return is not the requested count.
            const size_t __stored = __bytes < __room ? __bytes : __room;
            for (size_t __i = 0; __i < __stored; ++__i) {
                _M_ptr[_M_off] = __s[__i];
                ++_M_off;
            }
            return static_cast<std::ptrdiff_t>(__stored);
        }
    }

private:
    char* _M_ptr;
    size_t _M_size;
    size_t _M_off;
};

using spanbuf = basic_spanbuf<char>;

_GLIBCXX_END_NAMESPACE_VERSION
}  // namespace std

#endif  // _GLIBCXX_SPANSTREAM
