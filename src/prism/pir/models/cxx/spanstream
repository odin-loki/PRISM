// PRISM operational model of <spanstream> (docs/PIR.md "C++ library models").
// The pir stage puts this directory first on the C++ include path, so
// `#include <spanstream>` reaches this file instead of libstdc++'s.
//
// Partial on purpose. Only std::basic_spanbuf for char is modelled. It stores
// a char pointer, a size, and a write offset. It does not allocate. The
// destructor is defaulted and does not free. The characters belong to the
// caller.
//
// sputc writes one character only when the offset is less than the size, then
// advances the offset. When the offset is already the size, including a size
// of 0, sputc is a precondition failure (__prism_check) and does not write.
// A null pointer with a non-zero size is a check at construction. That size
// is kept: the pointer is not turned into an empty buffer.
//
// Omitted names are not declared here. A use of one fails to compile against
// this header, and the pir stage falls back to libstdc++ (extra.cxx_models).
// They are omitted because declaring them would include the span or sstream
// headers. This file does not include those, or string, or string_view:
//  * std::spanstream, std::ispanstream, std::ospanstream
//  * std::basic_spanstream, std::basic_ispanstream, std::basic_ospanstream
//  * a constructor or span() that takes or returns std::span
//  * basic_spanbuf's traits parameter, and wchar_t spanbufs
#ifndef _GLIBCXX_SPANSTREAM
#define _GLIBCXX_SPANSTREAM 1  // libstdc++'s <spanstream> include guard: never both

#pragma GCC system_header

#include <bits/c++config.h>
#include <cstddef>
#include <type_traits>

// PIR intrinsic (src/prism/pir/models/libc/prism_model.h). Declared, not
// defined: translate.cpp reports the call. A definition here would be inlined
// away and the check would disappear.
extern "C" void __prism_check(int __ok, const char* __cls, const char* __msg);

namespace std _GLIBCXX_VISIBILITY(default) {
_GLIBCXX_BEGIN_NAMESPACE_VERSION

template <typename _CharT>
class basic_spanbuf {
    static_assert(is_same_v<_CharT, char>,
                  "PRISM spanstream model: only char is modelled (the pir stage falls back to libstdc++)");

public:
    basic_spanbuf() noexcept : _M_ptr(nullptr), _M_size(0), _M_off(0) {}

    // Stores __p and __n. A null pointer with a non-zero size is a
    // precondition failure. The size stays __n: this is not an empty buffer.
    basic_spanbuf(char* __p, size_t __n) : _M_ptr(__p), _M_size(__n), _M_off(0) {
        __prism_check(__p != nullptr || __n == 0, "PTR-NULL-DEREF",
                      "std::basic_spanbuf constructed from a null pointer with a non-zero size");
    }

    basic_spanbuf(const basic_spanbuf&) noexcept = default;
    basic_spanbuf& operator=(const basic_spanbuf&) noexcept = default;

    // Does not allocate and does not free. The characters belong to the caller.
    ~basic_spanbuf() noexcept = default;

    [[nodiscard]] size_t size() const noexcept { return _M_size; }

    // One character when the offset is still inside the caller buffer, then
    // the offset advances. At the size (a size of 0 is already there) this
    // is a precondition failure and the buffer is not written.
    int sputc(char __c) {
        __prism_check(_M_off < _M_size, "MEM-OOB-WRITE", "std::basic_spanbuf::sputc write at size");
        if (_M_off < _M_size) {
            _M_ptr[_M_off] = __c;
            ++_M_off;
            return static_cast<int>(static_cast<unsigned char>(__c));
        }
        return -1;
    }

private:
    char* _M_ptr;
    size_t _M_size;
    size_t _M_off;
};

using spanbuf = basic_spanbuf<char>;

_GLIBCXX_END_NAMESPACE_VERSION
}  // namespace std

#endif  // _GLIBCXX_SPANSTREAM
