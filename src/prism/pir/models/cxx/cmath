// PRISM operational model of <cmath> (partial). The pir stage puts this
// directory first on the C++ include path, so `#include <cmath>` reaches
// this file instead of libstdc++'s. It is a file, not a directory: a
// directory of this name would make the include fail with EISDIR and every
// such unit would fall back to libstdc++.
//
// This header is not a proof of numeric accuracy.
//
// isfinite, isinf, isnan, and signbit are declared. They classify a value.
// They are not a proof of a numeric identity.
//
// copysign, fmin, and fmax are declared for float, double, and long double.
// copysign copies the sign bit of the second argument onto the magnitude of
// the first. copysign(0, negative) is a negative zero, not a positive
// stand-in. It does not change the magnitude. fmin returns the smaller
// argument and fmax returns the larger. If one argument is NaN, the other
// is returned. If both are NaN, a NaN is returned. Zero is not a stand-in
// for that NaN. An integer argument is not an overload. copysign, fmin,
// and fmax are not PROVED and not CLEAN.
//
// floor, ceil, and trunc are declared for float, double, and long double.
// They call __builtin_floor / __builtin_floorf / __builtin_floorl and the
// ceil and trunc builtins. A NaN stays a NaN. The body does not return 0
// in place of a NaN. An infinity stays that infinity. An integer argument
// is not an overload. floor, ceil, and trunc are not PROVED and not CLEAN.
//
// fma, hypot, remainder, fmod, and fdim are declared for float, double,
// and long double. A NaN argument is returned as that NaN, not 0. fmod and
// remainder of a zero divisor return a NaN. hypot of an infinity is that
// infinity's magnitude. fdim of x <= y is +0. An integer argument is not
// an overload. fma, hypot, remainder, fmod, and fdim are not PROVED and
// not CLEAN.
//
// sin, cos, tan, exp, log, and pow are not declared, and neither is the
// rest of <cmath>. A use of them fails to compile against this header and
// pir falls back to libstdc++. A partial header is intentional.
#ifndef _GLIBCXX_CMATH
#define _GLIBCXX_CMATH 1

#pragma GCC system_header

// libstdc++ <bits/std_abs.h> also defines the floating abs overloads, unless
// this macro is set (the same guard that header already uses). With it set,
// those overloads are the ones below, not a second definition.
#define __CORRECT_ISO_CPP_MATH_H_PROTO
#undef abs
#undef fabs
#undef sqrt
// <math.h> defines isfinite, isinf, isnan, and signbit as function-like
// macros. A later include, such as <cstdio>, would then rewrite
// std::isfinite(x) into a name in namespace std. The guard stops that
// include from defining the macros. This file does not include <math.h>,
// so sin, cos, tan, exp, log, and pow stay undeclared. If <math.h> was
// already included, the undefs drop the macros. copysign, fmin, fmax,
// floor, ceil, trunc, fma, hypot, remainder, fmod, and fdim are cleared
// the same way when a macro of that name is present.
#define _MATH_H 1
#undef isfinite
#undef isinf
#undef isnan
#undef signbit
#undef copysign
#undef fmin
#undef fmax
#undef floor
#undef ceil
#undef trunc
#undef fma
#undef hypot
#undef remainder
#undef fmod
#undef fdim

// PIR intrinsic (translate.cpp). A literal class and message, as in the libc
// models. Not defined here: the analysed program does not link a body.
extern "C" void __prism_check(int ok, const char* cls, const char* msg);

namespace std {

// A negative hits the check before any builtin and before any returned
// value. That path does not call a library sqrt, and it does not return a
// quiet NaN or an invented non-negative number. Zero is zero. A positive
// value is the real sqrt (__builtin_sqrt / sqrtf / sqrtl, which PIR lowers
// as llvm.sqrt when the format is float or double).
inline double sqrt(double __x) {
    __prism_check(!(__x < 0.0) ? 1 : 0, "FUNC-CONTRACT", "sqrt of a negative value");
    if (__x < 0.0) {
        __builtin_trap();
    }
    if (__x == 0.0) return 0.0;
    return __builtin_sqrt(__x);
}

inline float sqrt(float __x) {
    __prism_check(!(__x < 0.0f) ? 1 : 0, "FUNC-CONTRACT", "sqrt of a negative value");
    if (__x < 0.0f) {
        __builtin_trap();
    }
    if (__x == 0.0f) return 0.0f;
    return __builtin_sqrtf(__x);
}

inline long double sqrt(long double __x) {
    __prism_check(!(__x < 0.0L) ? 1 : 0, "FUNC-CONTRACT", "sqrt of a negative value");
    if (__x < 0.0L) {
        __builtin_trap();
    }
    if (__x == 0.0L) return 0.0L;
    return __builtin_sqrtl(__x);
}

// Magnitude of a finite value: the builtin clears the sign and keeps the
// value bits. It does not drop the sign and also drop the value.
constexpr double fabs(double __x) { return __builtin_fabs(__x); }
constexpr float fabs(float __x) { return __builtin_fabsf(__x); }
constexpr long double fabs(long double __x) { return __builtin_fabsl(__x); }

// Under libstdc++, bits/std_abs.h (reached from <cstdlib> and others) defines
// the floating abs overloads with the same builtins; use it so they are not
// defined twice.
#if defined(__GLIBCXX__)
}  // namespace std
#include <bits/std_abs.h>
namespace std {
#else
constexpr double abs(double __x) { return __builtin_fabs(__x); }
constexpr float abs(float __x) { return __builtin_fabsf(__x); }
constexpr long double abs(long double __x) { return __builtin_fabsl(__x); }
#endif

// Classification, not a numeric identity. A floating zero is finite and is
// not a NaN. The sign bit of a negative value is set. Clang's isfinite,
// isinf, and isnan builtins are type-generic, so the float and long double
// overloads call the same builtin as double. signbit has f and l builtins.
// An integer argument is not an overload.
constexpr bool isfinite(double __x) { return __builtin_isfinite(__x); }
constexpr bool isfinite(float __x) { return __builtin_isfinite(__x); }
constexpr bool isfinite(long double __x) { return __builtin_isfinite(__x); }

constexpr bool isinf(double __x) { return __builtin_isinf(__x); }
constexpr bool isinf(float __x) { return __builtin_isinf(__x); }
constexpr bool isinf(long double __x) { return __builtin_isinf(__x); }

constexpr bool isnan(double __x) { return __builtin_isnan(__x); }
constexpr bool isnan(float __x) { return __builtin_isnan(__x); }
constexpr bool isnan(long double __x) { return __builtin_isnan(__x); }

constexpr bool signbit(double __x) { return __builtin_signbit(__x); }
constexpr bool signbit(float __x) { return __builtin_signbitf(__x); }
constexpr bool signbit(long double __x) { return __builtin_signbitl(__x); }

// Magnitude of __x, sign bit of __y. Negating that magnitude is a negative
// zero when the magnitude is zero, not a positive stand-in. The value bits
// of the magnitude are the fabs result.
constexpr double copysign(double __x, double __y) {
    const double __m = fabs(__x);
    if (signbit(__y)) return -__m;
    return __m;
}

constexpr float copysign(float __x, float __y) {
    const float __m = fabs(__x);
    if (signbit(__y)) return -__m;
    return __m;
}

constexpr long double copysign(long double __x, long double __y) {
    const long double __m = fabs(__x);
    if (signbit(__y)) return -__m;
    return __m;
}

// Smaller argument. A NaN is missing data: the other argument is returned.
// Two NaNs return a NaN. The result is not a zero written in place of a NaN.
constexpr double fmin(double __x, double __y) {
    if (isnan(__x)) return __y;
    if (isnan(__y)) return __x;
    return __x < __y ? __x : __y;
}

constexpr float fmin(float __x, float __y) {
    if (isnan(__x)) return __y;
    if (isnan(__y)) return __x;
    return __x < __y ? __x : __y;
}

constexpr long double fmin(long double __x, long double __y) {
    if (isnan(__x)) return __y;
    if (isnan(__y)) return __x;
    return __x < __y ? __x : __y;
}

// Larger argument. Same NaN rule as fmin: one NaN returns the other, and
// two NaNs return a NaN rather than zero.
constexpr double fmax(double __x, double __y) {
    if (isnan(__x)) return __y;
    if (isnan(__y)) return __x;
    return __x > __y ? __x : __y;
}

constexpr float fmax(float __x, float __y) {
    if (isnan(__x)) return __y;
    if (isnan(__y)) return __x;
    return __x > __y ? __x : __y;
}

constexpr long double fmax(long double __x, long double __y) {
    if (isnan(__x)) return __y;
    if (isnan(__y)) return __x;
    return __x > __y ? __x : __y;
}

// Toward -infinity, toward +infinity, and toward zero. The builtin keeps a
// NaN as a NaN and keeps an infinity as that infinity. It does not return
// 0 in place of a NaN. float uses the f builtin and long double the l
// builtin. An integer argument is not an overload.
constexpr double floor(double __x) { return __builtin_floor(__x); }
constexpr float floor(float __x) { return __builtin_floorf(__x); }
constexpr long double floor(long double __x) { return __builtin_floorl(__x); }

constexpr double ceil(double __x) { return __builtin_ceil(__x); }
constexpr float ceil(float __x) { return __builtin_ceilf(__x); }
constexpr long double ceil(long double __x) { return __builtin_ceill(__x); }

constexpr double trunc(double __x) { return __builtin_trunc(__x); }
constexpr float trunc(float __x) { return __builtin_truncf(__x); }
constexpr long double trunc(long double __x) { return __builtin_truncl(__x); }

// Positive difference. A NaN stays that NaN. x <= y is +0, not a negative
// and not a stand-in for a NaN. An infinity greater than y stays infinite.
// An integer argument is not an overload.
constexpr double fdim(double __x, double __y) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__x <= __y) return +0.0;
    return __x - __y;
}

constexpr float fdim(float __x, float __y) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__x <= __y) return +0.0f;
    return __x - __y;
}

constexpr long double fdim(long double __x, long double __y) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__x <= __y) return +0.0L;
    return __x - __y;
}

// Remainder x - n*y, n = trunc(x/y), with the sign of x. A NaN stays that
// NaN. A zero divisor returns a NaN, not zero. Otherwise the builtin result
// is returned. An infinity stays an infinity when that is the IEEE result.
// An integer argument is not an overload.
constexpr double fmod(double __x, double __y) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__y == 0.0) return __builtin_nan("");
    return __builtin_fmod(__x, __y);
}

constexpr float fmod(float __x, float __y) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__y == 0.0f) return __builtin_nanf("");
    return __builtin_fmodf(__x, __y);
}

constexpr long double fmod(long double __x, long double __y) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__y == 0.0L) return __builtin_nanl("");
    return __builtin_fmodl(__x, __y);
}

// IEEE remainder, n nearest to x/y with ties to even. A NaN stays that NaN.
// A zero divisor returns a NaN, not zero. Otherwise the builtin result is
// returned. An integer argument is not an overload.
constexpr double remainder(double __x, double __y) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__y == 0.0) return __builtin_nan("");
    return __builtin_remainder(__x, __y);
}

constexpr float remainder(float __x, float __y) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__y == 0.0f) return __builtin_nanf("");
    return __builtin_remainderf(__x, __y);
}

constexpr long double remainder(long double __x, long double __y) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__y == 0.0L) return __builtin_nanl("");
    return __builtin_remainderl(__x, __y);
}

// sqrt(x*x + y*y). An infinity wins, including over a NaN, and the result
// is +infinity. A NaN with a finite partner stays that NaN. A pair of zeros
// is +0. Otherwise the builtin result is returned. An integer argument is
// not an overload.
constexpr double hypot(double __x, double __y) {
    if (isinf(__x) || isinf(__y)) return __builtin_huge_val();
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__x == 0.0 && __y == 0.0) return +0.0;
    return __builtin_hypot(__x, __y);
}

constexpr float hypot(float __x, float __y) {
    if (isinf(__x) || isinf(__y)) return __builtin_huge_valf();
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__x == 0.0f && __y == 0.0f) return +0.0f;
    return __builtin_hypotf(__x, __y);
}

constexpr long double hypot(long double __x, long double __y) {
    if (isinf(__x) || isinf(__y)) return __builtin_huge_vall();
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (__x == 0.0L && __y == 0.0L) return +0.0L;
    return __builtin_hypotl(__x, __y);
}

// Fused (x * y) + z. A NaN argument is returned as that NaN, not 0.
// Otherwise the builtin result is returned. An infinity stays an infinity
// when that is the IEEE result. An integer argument is not an overload.
constexpr double fma(double __x, double __y, double __z) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (isnan(__z)) return __z;
    return __builtin_fma(__x, __y, __z);
}

constexpr float fma(float __x, float __y, float __z) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (isnan(__z)) return __z;
    return __builtin_fmaf(__x, __y, __z);
}

constexpr long double fma(long double __x, long double __y, long double __z) {
    if (isnan(__x)) return __x;
    if (isnan(__y)) return __y;
    if (isnan(__z)) return __z;
    return __builtin_fmal(__x, __y, __z);
}

}  // namespace std

#endif
