// PRISM operational model of <iterator>. The pir stage puts this directory
// first on the C++ include path, so `#include <iterator>` reaches this file
// instead of libstdc++'s. It is a file, not a directory: a directory of this
// name would make the include fail with EISDIR and every such unit would
// fall back to libstdc++.
//
// Partial on purpose. std::begin and std::end take a reference to an array
// T (&)[N] and nothing else. begin returns a pointer to the first element
// (array-to-pointer decay, not a load). end returns a pointer one past the
// last.
//
// N == 0 is valid. A parameter written T (&)[N] is a substitution failure
// for that bound (clang: zero-length arrays are not permitted in C++), so
// the empty array is a second overload: a reference whose size is 0. begin
// and end then return the same pointer. Neither overload dereferences it.
//
// A pointer argument is not an overload of begin or end. It does not match
// T (&)[N], and its size is not 0, so the call fails to compile against
// this header and pir falls back to libstdc++. That argument is not stubbed.
//
// std::distance is only the overload for two pointers of the same type.
// The result is the element count from the first to the second. A count
// that does not fit in ptrdiff_t is __prism_check with class FUNC-CONTRACT,
// then __builtin_trap. That path does not return a wrapped ptrdiff_t.
// This is not a proof that the two pointers address the same array.
//
// std::next is only the overloads for a pointer. next(p) returns p + 1.
// next(p, 0) returns p and does not add. next(p, n) for n > 0 returns
// p + n. n < 0 is __prism_check with class FUNC-CONTRACT, then
// __builtin_trap. That path does not form p + n.
// This is not a proof that the pointer addresses an array.
//
// std::prev is only the overloads for a pointer. prev(p) returns p - 1.
// prev(p, 0) returns p and does not subtract. prev(p, n) for n > 0 returns
// p - n. n < 0 is __prism_check with class FUNC-CONTRACT, then
// __builtin_trap. That path does not form p - n.
// This is not a proof that the pointer addresses an array.
//
// std::advance and reverse_iterator are not declared.
// The rest of this header is omitted the same way (iterator traits, tags,
// insert iterators, stream iterators, and the container overloads of begin
// and end). A unit that names one fails to compile here and falls back.
// They are not stubbed.
//
// This is not a proof that an iterator stays in range. There is no check
// on a later increment or on a dereference of the returned pointer.
//
// This file includes <cstddef> and <cstdint>. It does not include <memory>
// or <ranges>.
#ifndef _GLIBCXX_ITERATOR
#define _GLIBCXX_ITERATOR 1

#pragma GCC system_header

#include <cstddef>
#include <cstdint>

// PIR intrinsic (translate.cpp). Literal class and message. Declared, not
// defined: the analysed program does not link a body.
extern "C" void __prism_check(int, const char*, const char*);

namespace std {

// The failing path never returns. A wrapping subtraction of the two
// addresses is not produced here.
[[noreturn]] inline void _Prism_distance_does_not_fit() noexcept {
    __prism_check(0, "FUNC-CONTRACT", "std::distance subtraction does not fit in ptrdiff_t");
    __builtin_trap();
}

// Element count from __first to __last. The address gap is an unsigned
// magnitude, then divided by sizeof(_Tp). A magnitude outside
// [PTRDIFF_MIN, PTRDIFF_MAX] takes the check above. This is not a proof
// that the two pointers address the same array.
template <typename _Tp>
std::ptrdiff_t _Prism_pointer_diff(_Tp* __first, _Tp* __last) noexcept {
    static_assert(sizeof(_Tp) != 0, "distance requires a complete object type");
    const auto __uf = reinterpret_cast<std::uintptr_t>(__first);
    const auto __ul = reinterpret_cast<std::uintptr_t>(__last);
    const bool __neg = __ul < __uf;
    const std::uintptr_t __bytes = __neg ? (__uf - __ul) : (__ul - __uf);
    const std::uintptr_t __n = __bytes / static_cast<std::uintptr_t>(sizeof(_Tp));
    const std::uintptr_t __max = static_cast<std::uintptr_t>(PTRDIFF_MAX);
    if (__neg) {
        // PTRDIFF_MIN is representable. Its magnitude is one past PTRDIFF_MAX.
        // A larger magnitude would be a wrapped bit pattern. Do not return it.
        if (__n > __max) {
            if (__n != __max + 1) _Prism_distance_does_not_fit();
            return PTRDIFF_MIN;
        }
        return static_cast<std::ptrdiff_t>(0) - static_cast<std::ptrdiff_t>(__n);
    }
    if (__n > __max) _Prism_distance_does_not_fit();
    return static_cast<std::ptrdiff_t>(__n);
}

// Pointer to the first element. The bound is at least 1: N == 0 does not
// match this parameter.
template <typename _Tp, size_t _Nm>
constexpr _Tp* begin(_Tp (&__arr)[_Nm]) noexcept {
    return __arr;
}

// One past the last element. The addition is the bound. N == 0 does not
// match this parameter.
template <typename _Tp, size_t _Nm>
constexpr _Tp* end(_Tp (&__arr)[_Nm]) noexcept {
    return __arr + _Nm;
}

// N == 0. sizeof of a zero-length array is 0. The result is the decayed
// pointer, not a load. A pointer argument has a non-zero size, so it does
// not match.
template <typename _Arr>
constexpr auto begin(_Arr& __arr) noexcept -> decltype(__arr + 0)
    requires(sizeof(_Arr) == 0)
{
    return __arr;
}

// Same pointer as begin. Adding zero does not dereference.
template <typename _Arr>
constexpr auto end(_Arr& __arr) noexcept -> decltype(__arr + 0)
    requires(sizeof(_Arr) == 0)
{
    return __arr + 0;
}

// Two pointers only. A class iterator does not match, so the call fails
// to compile and pir falls back. Constant evaluation uses the subtraction:
// a count that does not fit in ptrdiff_t is not a constant expression, so
// that return is not a wrapped value. At run time the count is the unsigned
// distance, and a value that does not fit is the check, not a wrapped result.
// This is not a proof that the two pointers address the same array.
template <typename _Tp>
constexpr std::ptrdiff_t distance(_Tp* __first, _Tp* __last) noexcept {
    if consteval {
        return __last - __first;
    }
    return _Prism_pointer_diff(__first, __last);
}

// n < 0. This path does not form p + n.
// This is not a proof that the pointer addresses an array.
[[noreturn]] inline void _Prism_next_negative() noexcept {
    __prism_check(0, "FUNC-CONTRACT", "std::next offset is negative");
    __builtin_trap();
}

// Pointer only. There is no default argument: next(p) is this overload,
// and it returns p + 1. A class iterator does not match, so that call
// fails to compile and pir falls back.
// This is not a proof that the pointer addresses an array.
template <typename _Tp>
constexpr _Tp* next(_Tp* __p) noexcept {
    return __p + 1;
}

// next(p, 0) returns p and does not add. n > 0 returns p + n. n < 0
// calls the check above and does not form p + n.
// This is not a proof that the pointer addresses an array.
template <typename _Tp>
constexpr _Tp* next(_Tp* __p, std::ptrdiff_t __n) noexcept {
    if (__n < 0) {
        _Prism_next_negative();
    } else if (__n == 0) {
        return __p;
    } else {
        return __p + __n;
    }
}

// n < 0. This path does not form p - n.
// This is not a proof that the pointer addresses an array.
[[noreturn]] inline void _Prism_prev_negative() noexcept {
    __prism_check(0, "FUNC-CONTRACT", "std::prev offset is negative");
    __builtin_trap();
}

// Pointer only. There is no default argument: prev(p) is this overload,
// and it returns p - 1. A class iterator does not match, so that call
// fails to compile and pir falls back.
// This is not a proof that the pointer addresses an array.
template <typename _Tp>
constexpr _Tp* prev(_Tp* __p) noexcept {
    return __p - 1;
}

// prev(p, 0) returns p and does not subtract. n > 0 returns p - n. n < 0
// calls the check above and does not form p - n.
// This is not a proof that the pointer addresses an array.
template <typename _Tp>
constexpr _Tp* prev(_Tp* __p, std::ptrdiff_t __n) noexcept {
    if (__n < 0) {
        _Prism_prev_negative();
    } else if (__n == 0) {
        return __p;
    } else {
        return __p - __n;
    }
}

}  // namespace std

#endif  // _GLIBCXX_ITERATOR
