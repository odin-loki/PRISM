// PRISM operational model of <expected> (roadmap 2.6, docs/PIR.md "C++ library
// models"). The pir stage puts this directory first on the C++ include path,
// so `#include <expected>` reaches this file instead of libstdc++'s. It is a
// file, not a directory: a directory of this name would make the include fail
// with EISDIR and every such unit would fall back to libstdc++.
//
// An expected<T, E> holds either a T or an E, stored inline in one union. It
// is never both, and neither alternative is a separate heap allocation. The
// destructor ends the active alternative's lifetime with an explicit
// destructor call. It does not call delete.
//
// has_value() and operator bool report which alternative is stored. value()
// and operator* / operator-> return that T only when it is the active
// alternative. error() returns that E only when it is the active alternative.
// The other call is a precondition failure (__prism_check). It does not
// return a default T or a default E and it does not invent a value.
//
// and_then calls the function with the stored T when that alternative is
// active and returns what the function returns. When the error alternative
// is active, and_then does not call the function and returns an expected
// that holds that same E. It does not invent a T.
// or_else calls the function with the stored E when that alternative is
// active and returns what the function returns. When a T is stored, or_else
// does not call the function and returns that stored T inside the expected.
// It does not invent an E.
// value_or returns the stored T when that alternative is active. When the
// error alternative is active, value_or returns the argument converted to T.
// It does not return T{} and it does not invent a value that was not stored
// or passed in.
// transform calls the function with the stored T when that alternative is
// active and returns an expected that holds the function's result. When the
// error alternative is active, transform does not call the function and
// returns that same E through _M_from_unex. It does not construct a T and
// it does not return T{}.
// transform_error calls the function with the stored E when that alternative
// is active and returns an expected that holds the function's result as the
// error, through unexpected. When a T is stored, transform_error does not
// call the function and returns that stored T. It does not construct an E
// and it does not return E{} or T{}.
// emplace, swap, comparison, and expected<void, E> are not declared. A use
// of them fails to compile against this header and pir falls back to
// libstdc++.
#ifndef _PRISM_MODEL_EXPECTED
#define _PRISM_MODEL_EXPECTED 1
#define _GLIBCXX_EXPECTED 1  // libstdc++'s <expected> include guard: never both

#pragma GCC system_header

// PIR intrinsic (translate.cpp). A literal class and message, as in the libc
// models. Not defined here: the analysed program does not link a body.
extern "C" void __prism_check(int ok, const char* cls, const char* msg);

namespace std {

template <typename _Ep>
class unexpected {
    _Ep _M_val;

public:
    explicit unexpected(const _Ep& __e) : _M_val(__e) {}
    explicit unexpected(_Ep&& __e) : _M_val(static_cast<_Ep&&>(__e)) {}

    _Ep& error() & noexcept { return _M_val; }
    const _Ep& error() const& noexcept { return _M_val; }
    _Ep&& error() && noexcept { return static_cast<_Ep&&>(_M_val); }
    const _Ep&& error() const&& noexcept { return static_cast<const _Ep&&>(_M_val); }
};

template <typename _Ep>
unexpected(_Ep) -> unexpected<_Ep>;

template <typename _Tp, typename _Er>
class expected {
    // Builds the error alternative without constructing T. Private so a
    // program cannot spell it; and_then and transform use it to return this
    // same E.
    enum class _Unex { _Tag };

    template <typename, typename>
    friend class expected;

    // T and E share this union, inside the expected object. Exactly one is
    // alive. ~_Storage does not destroy it and does not free anything; the
    // expected destructor ends the active alternative's lifetime.
    union _Storage {
        _Tp _M_val;
        _Er _M_unex;
        _Storage() : _M_val() {}
        _Storage(const _Tp& __v) : _M_val(__v) {}
        _Storage(_Tp&& __v) : _M_val(static_cast<_Tp&&>(__v)) {}
        _Storage(const unexpected<_Er>& __u) : _M_unex(__u.error()) {}
        _Storage(unexpected<_Er>&& __u) : _M_unex(static_cast<_Er&&>(__u.error())) {}
        _Storage(_Unex, const _Er& __e) : _M_unex(__e) {}
        _Storage(_Unex, _Er&& __e) : _M_unex(static_cast<_Er&&>(__e)) {}
        ~_Storage() {}
    };

    bool _M_has = false;
    _Storage _M_storage;

    expected(_Unex, const _Er& __e) : _M_has(false), _M_storage(_Unex::_Tag, __e) {}
    expected(_Unex, _Er&& __e) : _M_has(false), _M_storage(_Unex::_Tag, static_cast<_Er&&>(__e)) {}

    // One E, placed in the result. T is not constructed.
    static expected _M_from_unex(const _Er& __e) { return expected(_Unex::_Tag, __e); }
    static expected _M_from_unex(_Er&& __e) { return expected(_Unex::_Tag, static_cast<_Er&&>(__e)); }

public:
    using value_type = _Tp;
    using error_type = _Er;
    using unexpected_type = unexpected<_Er>;

    // Holds a value-initialized T. The error alternative is not alive.
    expected() : _M_has(true), _M_storage() {}
    expected(const _Tp& __v) : _M_has(true), _M_storage(__v) {}
    expected(_Tp&& __v) : _M_has(true), _M_storage(static_cast<_Tp&&>(__v)) {}
    expected(const unexpected<_Er>& __u) : _M_has(false), _M_storage(__u) {}
    expected(unexpected<_Er>&& __u) : _M_has(false), _M_storage(static_cast<unexpected<_Er>&&>(__u)) {}

    ~expected() {
        if (_M_has)
            _M_storage._M_val.~_Tp();
        else
            _M_storage._M_unex.~_Er();
    }

    bool has_value() const noexcept { return _M_has; }
    explicit operator bool() const noexcept { return _M_has; }

    // The stored T. Not a value-initialized T: the failure path is the check.
    _Tp& operator*() & noexcept {
        __prism_check(_M_has ? 1 : 0, "CXX-EXPECTED-NULL",
                      "expected::operator* requires has_value()");
        return _M_storage._M_val;
    }
    const _Tp& operator*() const& noexcept {
        __prism_check(_M_has ? 1 : 0, "CXX-EXPECTED-NULL",
                      "expected::operator* requires has_value()");
        return _M_storage._M_val;
    }
    _Tp* operator->() noexcept {
        __prism_check(_M_has ? 1 : 0, "CXX-EXPECTED-NULL",
                      "expected::operator-> requires has_value()");
        return &_M_storage._M_val;
    }
    const _Tp* operator->() const noexcept {
        __prism_check(_M_has ? 1 : 0, "CXX-EXPECTED-NULL",
                      "expected::operator-> requires has_value()");
        return &_M_storage._M_val;
    }
    _Tp& value() & {
        __prism_check(_M_has ? 1 : 0, "CXX-EXPECTED-NULL",
                      "expected::value() requires has_value()");
        return _M_storage._M_val;
    }
    const _Tp& value() const& {
        __prism_check(_M_has ? 1 : 0, "CXX-EXPECTED-NULL",
                      "expected::value() requires has_value()");
        return _M_storage._M_val;
    }

    // The stored E. Not a value-initialized E: the failure path is the check.
    _Er& error() & noexcept {
        __prism_check(_M_has ? 0 : 1, "CXX-EXPECTED-ERROR",
                      "expected::error() requires !has_value()");
        return _M_storage._M_unex;
    }
    const _Er& error() const& noexcept {
        __prism_check(_M_has ? 0 : 1, "CXX-EXPECTED-ERROR",
                      "expected::error() requires !has_value()");
        return _M_storage._M_unex;
    }

    // Holds T: that T (copied on const&, moved on &&). Holds E: the argument
    // converted to T. The inactive alternative is not read. T{} is not built.
    template <typename _Up>
    _Tp value_or(_Up&& __u) const& {
        if (_M_has) return _M_storage._M_val;
        return static_cast<_Tp>(static_cast<_Up&&>(__u));
    }
    template <typename _Up>
    _Tp value_or(_Up&& __u) && {
        if (_M_has) return static_cast<_Tp&&>(_M_storage._M_val);
        return static_cast<_Tp>(static_cast<_Up&&>(__u));
    }

    // Holds T: call with that T and return the function's expected. Holds E:
    // do not call, and do not construct a T. The result holds this same E.
    // The decltype is unevaluated, so the inactive alternative is not read.
    template <typename _Fn>
    auto and_then(_Fn&& __f) & {
        if (_M_has)
            return static_cast<_Fn&&>(__f)(_M_storage._M_val);
        using _Ret = decltype(static_cast<_Fn&&>(__f)(_M_storage._M_val));
        return _Ret::_M_from_unex(_M_storage._M_unex);
    }
    template <typename _Fn>
    auto and_then(_Fn&& __f) const& {
        if (_M_has)
            return static_cast<_Fn&&>(__f)(_M_storage._M_val);
        using _Ret = decltype(static_cast<_Fn&&>(__f)(_M_storage._M_val));
        return _Ret::_M_from_unex(_M_storage._M_unex);
    }
    template <typename _Fn>
    auto and_then(_Fn&& __f) && {
        if (_M_has)
            return static_cast<_Fn&&>(__f)(static_cast<_Tp&&>(_M_storage._M_val));
        using _Ret = decltype(static_cast<_Fn&&>(__f)(static_cast<_Tp&&>(_M_storage._M_val)));
        return _Ret::_M_from_unex(static_cast<_Er&&>(_M_storage._M_unex));
    }
    template <typename _Fn>
    auto and_then(_Fn&& __f) const&& {
        if (_M_has)
            return static_cast<_Fn&&>(__f)(static_cast<const _Tp&&>(_M_storage._M_val));
        using _Ret = decltype(static_cast<_Fn&&>(__f)(static_cast<const _Tp&&>(_M_storage._M_val)));
        return _Ret::_M_from_unex(static_cast<const _Er&&>(_M_storage._M_unex));
    }

    // Holds E: call with that E and return the function's expected. Holds T:
    // do not call, and do not construct an E. The result holds this stored T.
    template <typename _Fn>
    auto or_else(_Fn&& __f) & {
        if (!_M_has)
            return static_cast<_Fn&&>(__f)(_M_storage._M_unex);
        using _Ret = decltype(static_cast<_Fn&&>(__f)(_M_storage._M_unex));
        return _Ret(_M_storage._M_val);
    }
    template <typename _Fn>
    auto or_else(_Fn&& __f) const& {
        if (!_M_has)
            return static_cast<_Fn&&>(__f)(_M_storage._M_unex);
        using _Ret = decltype(static_cast<_Fn&&>(__f)(_M_storage._M_unex));
        return _Ret(_M_storage._M_val);
    }
    template <typename _Fn>
    auto or_else(_Fn&& __f) && {
        if (!_M_has)
            return static_cast<_Fn&&>(__f)(static_cast<_Er&&>(_M_storage._M_unex));
        using _Ret = decltype(static_cast<_Fn&&>(__f)(static_cast<_Er&&>(_M_storage._M_unex)));
        return _Ret(static_cast<_Tp&&>(_M_storage._M_val));
    }
    template <typename _Fn>
    auto or_else(_Fn&& __f) const&& {
        if (!_M_has)
            return static_cast<_Fn&&>(__f)(static_cast<const _Er&&>(_M_storage._M_unex));
        using _Ret = decltype(static_cast<_Fn&&>(__f)(static_cast<const _Er&&>(_M_storage._M_unex)));
        return _Ret(static_cast<const _Tp&&>(_M_storage._M_val));
    }

    // Holds T: call with that T and return an expected that holds the
    // function's result. Holds E: do not call, and do not construct a T.
    // The result holds this same E, through _M_from_unex. T{} is not
    // returned. The decltype is unevaluated, so the inactive alternative
    // is not read.
    template <typename _Fn>
    auto transform(_Fn&& __f) & {
        using _Up = decltype(static_cast<_Fn&&>(__f)(_M_storage._M_val));
        using _Ret = expected<_Up, _Er>;
        if (_M_has)
            return _Ret(static_cast<_Fn&&>(__f)(_M_storage._M_val));
        return _Ret::_M_from_unex(_M_storage._M_unex);
    }
    template <typename _Fn>
    auto transform(_Fn&& __f) const& {
        using _Up = decltype(static_cast<_Fn&&>(__f)(_M_storage._M_val));
        using _Ret = expected<_Up, _Er>;
        if (_M_has)
            return _Ret(static_cast<_Fn&&>(__f)(_M_storage._M_val));
        return _Ret::_M_from_unex(_M_storage._M_unex);
    }
    template <typename _Fn>
    auto transform(_Fn&& __f) && {
        using _Up = decltype(static_cast<_Fn&&>(__f)(static_cast<_Tp&&>(_M_storage._M_val)));
        using _Ret = expected<_Up, _Er>;
        if (_M_has)
            return _Ret(static_cast<_Fn&&>(__f)(static_cast<_Tp&&>(_M_storage._M_val)));
        return _Ret::_M_from_unex(static_cast<_Er&&>(_M_storage._M_unex));
    }
    template <typename _Fn>
    auto transform(_Fn&& __f) const&& {
        using _Up = decltype(static_cast<_Fn&&>(__f)(static_cast<const _Tp&&>(_M_storage._M_val)));
        using _Ret = expected<_Up, _Er>;
        if (_M_has)
            return _Ret(static_cast<_Fn&&>(__f)(static_cast<const _Tp&&>(_M_storage._M_val)));
        return _Ret::_M_from_unex(static_cast<const _Er&&>(_M_storage._M_unex));
    }

    // Holds E: call with that E and return an expected that holds the
    // function's result as the error, through unexpected. Holds T: do not
    // call, and do not construct an E. The result holds this same T.
    // E{} and T{} are not returned. The decltype is unevaluated, so the
    // inactive alternative is not read.
    template <typename _Fn>
    auto transform_error(_Fn&& __f) & {
        using _Gp = decltype(static_cast<_Fn&&>(__f)(_M_storage._M_unex));
        using _Ret = expected<_Tp, _Gp>;
        if (!_M_has)
            return _Ret(unexpected<_Gp>(static_cast<_Fn&&>(__f)(_M_storage._M_unex)));
        return _Ret(_M_storage._M_val);
    }
    template <typename _Fn>
    auto transform_error(_Fn&& __f) const& {
        using _Gp = decltype(static_cast<_Fn&&>(__f)(_M_storage._M_unex));
        using _Ret = expected<_Tp, _Gp>;
        if (!_M_has)
            return _Ret(unexpected<_Gp>(static_cast<_Fn&&>(__f)(_M_storage._M_unex)));
        return _Ret(_M_storage._M_val);
    }
    template <typename _Fn>
    auto transform_error(_Fn&& __f) && {
        using _Gp = decltype(static_cast<_Fn&&>(__f)(static_cast<_Er&&>(_M_storage._M_unex)));
        using _Ret = expected<_Tp, _Gp>;
        if (!_M_has)
            return _Ret(unexpected<_Gp>(
                static_cast<_Fn&&>(__f)(static_cast<_Er&&>(_M_storage._M_unex))));
        return _Ret(static_cast<_Tp&&>(_M_storage._M_val));
    }
    template <typename _Fn>
    auto transform_error(_Fn&& __f) const&& {
        using _Gp = decltype(static_cast<_Fn&&>(__f)(static_cast<const _Er&&>(_M_storage._M_unex)));
        using _Ret = expected<_Tp, _Gp>;
        if (!_M_has)
            return _Ret(unexpected<_Gp>(
                static_cast<_Fn&&>(__f)(static_cast<const _Er&&>(_M_storage._M_unex))));
        return _Ret(static_cast<const _Tp&&>(_M_storage._M_val));
    }
};

}  // namespace std

#endif
