inline typename multimap<_Key, _Tp, _Compare, _Alloc>::size_type erase_if(
    multimap<_Key, _Tp, _Compare, _Alloc>& __cont, _Predicate __pred) {
    typename multimap<_Key, _Tp, _Compare, _Alloc>::size_type __num = 0;
    for (auto __it = __cont.begin(), __last = __cont.end(); __it != __last;) {
