template <typename _Key, typename _Tp, typename _Compare, typename _Alloc, typename _Predicate>
inline typename map<_Key, _Tp, _Compare, _Alloc>::size_type erase_if(map<_Key, _Tp, _Compare, _Alloc>& __cont,
                                                                     _Predicate __pred) {
    typename map<_Key, _Tp, _Compare, _Alloc>::size_type __num = 0;
    for (auto __it = __cont.begin(), __last = __cont.end(); __it != __last;) {
        if (__pred(*__it)) {
            __it = __cont.erase(__it);
            ++__num;
        } else {
            ++__it;
        }
    }
    return __num;
}
