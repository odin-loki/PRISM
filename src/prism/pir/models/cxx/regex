// PRISM partial stand-in for <regex>. The pir stage puts this directory
// first on the C++ include path, so `#include <regex>` reaches this file
// instead of libstdc++'s. It is a file, not a directory: a directory of
// that name would make the include fail with EISDIR and every such unit
// would fall back to libstdc++.
//
// Partial std::regex only. The object owns a copy of the pattern
// characters the caller wrote. The destructor frees that copy once. A
// move leaves the source empty, so the source destructor does not free
// the same block. This header does not compile the pattern and does not
// decide whether a string matches.
//
// A null const char* is __prism_check with class FUNC-CONTRACT, then
// __builtin_trap. It is not stored as ".*" and it is not stored as an
// empty match-all. An empty pattern stays empty: length 0, no allocation,
// not the two characters of a match-all pattern.
//
// An unsigned flag is stored on the object. flags() returns that unsigned.
// It does not read the pattern to decide a match, and 0 is not a claim
// that the pattern matches. The default constructor and the other
// existing constructors store 0. regex(const char*, unsigned) uses the
// same null check as regex(const char*): a null pointer is FUNC-CONTRACT
// then __builtin_trap, and it is not stored. The flag is stored only
// after that check. Copy and move copy the flag.
// This is not PROVED and not CLEAN.
//
// regex_match, regex_search, and regex_replace are not declared. A true
// return from any of them would be a fake match. A use fails to compile
// against this header and pir falls back to libstdc++ (extra.cxx_models).
// They are not stubbed. basic_regex, wregex, regex_traits, match_results,
// and the iterators are omitted the same way.
//
// This header does not include <string>, <string_view>, <memory>, or
// <locale>. It includes <utility> so std::move can bind the move
// constructor. The characters live in storage this regex allocates itself.
//
// This header is not a proof that a string matches.
#ifndef _GLIBCXX_REGEX
#define _GLIBCXX_REGEX 1

#pragma GCC system_header

#include <cstddef>
#include <new>
#include <utility>

// PIR intrinsics (translate.cpp, prism_model.h). Literal class and message.
// Declared, not defined: the analysed program does not link a body.
extern "C" void __prism_check(int, const char*, const char*);
extern "C" unsigned long __prism_obj_size(const void*);

namespace std {

class regex {
public:
    regex() noexcept : _M_str(nullptr), _M_len(0), _M_flags(0) {}

    // C string. A null pointer is a contract failure, not a pattern. A
    // missing terminator inside the object is a failed read, and this does
    // not copy past that object. The flag is 0.
    explicit regex(const char* __s) : _M_str(nullptr), _M_len(0), _M_flags(0) { _M_from_cstr(__s); }

    // Same null check as regex(const char*). A null pointer is
    // FUNC-CONTRACT then __builtin_trap, and it is not stored. The flag
    // is stored only after that check. _M_from_cstr then copies the
    // pattern. An empty pattern stays empty.
    regex(const char* __s, unsigned __f) : _M_str(nullptr), _M_len(0) {
        if (__s == nullptr) _M_fail("FUNC-CONTRACT", "std::regex constructed from a null pointer");
        _M_flags = __f;
        _M_from_cstr(__s);
    }

    // A char array that is not a string literal. The bound is the array, so
    // the copy does not read past it. The owned length stops at the first
    // NUL. An empty array stays empty. A string literal selects the
    // const char* constructor instead: that non-template is the match
    // clang chooses, and that path reads through __prism_obj_size.
    // The flag is 0.
    template <std::size_t _Nm>
    explicit regex(const char (&__s)[_Nm]) : _M_str(nullptr), _M_len(0), _M_flags(0) {
        std::size_t __n = 0;
        while (__n < _Nm && __s[__n] != '\0') ++__n;
        if (__n != 0) _M_own(__s, __n);
    }

    regex(const regex& __o) : _M_str(nullptr), _M_len(0), _M_flags(__o._M_flags) {
        if (__o._M_len != 0) _M_own(__o._M_str, __o._M_len);
    }

    // The source keeps no pointer. Its destructor then has nothing to free.
    // The flag is copied, then the source flag is 0.
    regex(regex&& __o) noexcept : _M_str(__o._M_str), _M_len(__o._M_len), _M_flags(__o._M_flags) {
        __o._M_str = nullptr;
        __o._M_len = 0;
        __o._M_flags = 0;
    }

    regex& operator=(const regex& __o) {
        if (this != &__o) {
            regex __tmp(__o);
            _M_swap(__tmp);
        }
        return *this;
    }

    // Frees this object's previous copy once, then takes the source. The
    // source is left empty. Self-move-assign keeps the single block.
    regex& operator=(regex&& __o) noexcept {
        if (this != &__o) {
            _M_free();
            _M_str = __o._M_str;
            _M_len = __o._M_len;
            _M_flags = __o._M_flags;
            __o._M_str = nullptr;
            __o._M_len = 0;
            __o._M_flags = 0;
        }
        return *this;
    }

    // Frees the owned copy once, via _M_free. A moved-from regex and an
    // empty regex hold no copy, so this does not free a second time.
    ~regex() { _M_free(); }

    // Character count of the owned copy. An empty pattern is 0.
    [[nodiscard]] std::size_t size() const noexcept { return _M_len; }
    [[nodiscard]] bool empty() const noexcept { return _M_len == 0; }
    // Owned characters, or nullptr when the pattern is empty. Not a match.
    [[nodiscard]] const char* data() const noexcept { return _M_str; }
    // The stored unsigned. It does not read the pattern to decide a match,
    // and 0 is not a claim that the pattern matches.
    [[nodiscard]] unsigned flags() const noexcept { return _M_flags; }

private:
    char* _M_str;
    std::size_t _M_len;
    unsigned _M_flags;

    [[noreturn]] static void _M_fail(const char* __cls, const char* __msg) noexcept;
    void _M_free() noexcept;
    void _M_own(const char* __s, std::size_t __n);
    void _M_swap(regex& __o) noexcept;
    void _M_from_cstr(const char* __s);
};

[[noreturn]] inline void regex::_M_fail(const char* __cls, const char* __msg) noexcept {
    __prism_check(0, __cls, __msg);
    __builtin_trap();
}

inline void regex::_M_free() noexcept {
    if (_M_str != nullptr) {
        ::operator delete(_M_str);
        _M_str = nullptr;
    }
    _M_len = 0;
}

inline void regex::_M_own(const char* __s, std::size_t __n) {
    char* __p = nullptr;
    if (__n != 0) {
        // n + 1 must fit. A wrapped size is not a successful allocation.
        if (__n == static_cast<std::size_t>(-1)) _M_fail("MEM-OOB-WRITE", "std::regex pattern length does not fit");
        __p = static_cast<char*>(::operator new(__n + 1));
        for (std::size_t __i = 0; __i < __n; ++__i) __p[__i] = __s[__i];
        __p[__n] = '\0';
    }
    // Copy first. __s may alias the block _M_free releases.
    _M_free();
    _M_str = __p;
    _M_len = __n;
}

inline void regex::_M_swap(regex& __o) noexcept {
    char* __s = _M_str;
    const std::size_t __n = _M_len;
    const unsigned __f = _M_flags;
    _M_str = __o._M_str;
    _M_len = __o._M_len;
    _M_flags = __o._M_flags;
    __o._M_str = __s;
    __o._M_len = __n;
    __o._M_flags = __f;
}

inline void regex::_M_from_cstr(const char* __s) {
    // Null is not a pattern. Do not store ".*" and do not store an empty
    // match-all. This path does not return.
    if (__s == nullptr) _M_fail("FUNC-CONTRACT", "std::regex constructed from a null pointer");
    const unsigned long __bytes = __prism_obj_size(__s);
    unsigned long __n = 0;
    while (__n < __bytes && __s[__n] != '\0') ++__n;
    // No terminator inside the object: do not read or copy past it, and do
    // not invent a pattern from the bytes that were in range.
    if (__n >= __bytes) _M_fail("MEM-OOB-READ", "std::regex C string is not terminated within its object");
    // A terminated empty pattern stays empty. It is not rewritten.
    if (__n != 0) _M_own(__s, static_cast<std::size_t>(__n));
}

}  // namespace std

#endif  // _GLIBCXX_REGEX
