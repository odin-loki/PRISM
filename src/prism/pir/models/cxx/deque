        return __first;
    }
    template <typename _InputIterator, typename = _RequireInputIter<_InputIterator>>
    iterator insert(const_iterator __pos, _InputIterator __first, _InputIterator __last) {
        if (__first == __last) return _M_reify(__pos);
        iterator __where = _M_reify(__pos);
        iterator __at = __where;
        bool __have = false;
        for (; __first != __last; ++__first) {
            __where = emplace(__where, *__first);
            if (!__have) {
                __at = __where;
                __have = true;
            }
            ++__where;
        }
        return __at;
    }
    iterator insert(const_iterator __pos, initializer_list<value_type> __l) {
        return insert(__pos, __l.begin(), __l.end());
    }

    iterator erase(const_iterator __first, const_iterator __last) {
        _M_bind();
        __glibcxx_assert(__first._M_ctrl == _M_c && __last._M_ctrl == _M_c);
        if (__first == __last) return _M_reify(__first);
        __glibcxx_assert(!__first._M_is_end);
        const bool __prefix = __first._M_node == _M_c->head;
        const bool __suffix = __last._M_is_end;
        const bool __middle = !__prefix && !__suffix;
        // Allocate the replacement anchor/cookie before unlinking so a
        // throwing operator new leaves the deque unchanged.
        _Anchor* __neu_a = __middle ? _S_new_anchor() : nullptr;
        _End* __neu_e = __suffix ? _S_new_end() : nullptr;
        _Node* __stop = __last._M_is_end ? nullptr : __last._M_node;
        _Node* __before = __first._M_node->_M_prev;
        _Node* __cur = __first._M_node;
        while (__cur != __stop) {
            _Node* __next = __cur->_M_next;
            _S_delete_node(__cur);
            --_M_c->size;
            __cur = __next;
        }
        if (__before)
            __before->_M_next = __stop;
        else
            _M_c->head = __stop;
        if (__stop)
            __stop->_M_prev = __before;
        else
            _M_c->tail = __before;
        if (__neu_a) {
            _Anchor* __old = _M_c->anchor;
            _M_c->anchor = __neu_a;
            ::operator delete(__old);
        }
        if (__neu_e) {
            _End* __old = _M_c->endc;
            _M_c->endc = __neu_e;
            ::operator delete(__old);
        }
        if (!__stop) return end();
        return iterator(_M_c->anchor, __stop, false, nullptr, _M_c);
    }
    iterator erase(const_iterator __pos) {
        __glibcxx_assert(__pos._M_ctrl == _M_c && !__pos._M_is_end);
        const_iterator __next = __pos;
        ++__next;
        return erase(__pos, __next);
    }

    void swap(deque& __x) noexcept { std::swap(_M_c, __x._M_c); }
    void clear() noexcept {
        if (!_M_c) return;
        _Anchor* __neu = _S_new_anchor();
        _End* __en = _S_new_end();
        _M_destroy_elems();
        ::operator delete(_M_c->anchor);
        ::operator delete(_M_c->endc);
        _M_c->anchor = __neu;
        _M_c->endc = __en;
    }
    void resize(size_type __n) {
        if (__n > size()) {
            if (__n > max_size()) __throw_length_error(__N("cannot create std::deque larger than max_size()"));
            while (size() < __n) emplace_back();
        } else if (__n < size()) {
            iterator __from = begin();
            for (size_type __i = 0; __i < __n; ++__i) ++__from;
            erase(__from, end());
        }
    }
    void resize(size_type __n, const value_type& __x) {
        if (__n > size()) {
            if (__n > max_size()) __throw_length_error(__N("cannot create std::deque larger than max_size()"));
            while (size() < __n) push_back(__x);
        } else if (__n < size()) {
            resize(__n);
        }
    }

private:
    void _M_release() noexcept {
        if (!_M_c) return;
        _M_destroy_elems();
        ::operator delete(_M_c->anchor);
        ::operator delete(_M_c->endc);
        ::operator delete(_M_c);
        _M_c = nullptr;
    }
    void _M_range_check(size_type __n) const {
        if (__n >= this->size())
            __throw_out_of_range_fmt(__N("deque::_M_range_check: __n "
                                         "(which is %zu)>= this->size() "
                                         "(which is %zu)"),
                                     __n, this->size());
    }
};

template <typename _InputIterator, typename _ValT = typename iterator_traits<_InputIterator>::value_type,
          typename _Allocator = allocator<_ValT>, typename = _RequireInputIter<_InputIterator>,
          typename = _RequireAllocator<_Allocator>>
deque(_InputIterator, _InputIterator, _Allocator = _Allocator()) -> deque<_ValT, _Allocator>;

template <typename _Tp, typename _Alloc>
[[nodiscard]] bool operator==(const deque<_Tp, _Alloc>& __x, const deque<_Tp, _Alloc>& __y) {
    return __x.size() == __y.size() && std::equal(__x.begin(), __x.end(), __y.begin());
}
template <typename _Tp, typename _Alloc>
[[nodiscard]] __detail::__synth3way_t<_Tp> operator<=>(const deque<_Tp, _Alloc>& __x, const deque<_Tp, _Alloc>& __y) {
    return std::lexicographical_compare_three_way(__x.begin(), __x.end(), __y.begin(), __y.end(),
                                                  __detail::__synth3way);
}
template <typename _Tp, typename _Alloc>
void swap(deque<_Tp, _Alloc>& __x, deque<_Tp, _Alloc>& __y) noexcept {
    __x.swap(__y);
}

template <typename _Tp, typename _Alloc, typename _Predicate>
typename deque<_Tp, _Alloc>::size_type erase_if(deque<_Tp, _Alloc>& __cont, _Predicate __pred) {
    const auto __osz = __cont.size();
    __cont.erase(std::remove_if(__cont.begin(), __cont.end(), __pred), __cont.end());
    return __osz - __cont.size();
}
template <typename _Tp, typename _Alloc, typename _Up>
typename deque<_Tp, _Alloc>::size_type erase(deque<_Tp, _Alloc>& __cont, const _Up& __value) {
    const auto __osz = __cont.size();
    __cont.erase(std::remove(__cont.begin(), __cont.end(), __value), __cont.end());
    return __osz - __cont.size();
}

