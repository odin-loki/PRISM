// PRISM operational model of <latch>. The pir stage puts this directory
// first on the C++ include path, so `#include <latch>` reaches this file
// instead of libstdc++'s. It is a file, not a directory: a directory of
// this name would make the include fail with EISDIR and every such unit
// would fall back to libstdc++.
//
// A latch stores one non-negative count in the object. Nothing is
// allocated. count_down(n) subtracts n only when n is not greater than
// that count. A count_down that would pass below zero is a precondition
// failure (__prism_check). The count is not wrapped to a large value, and
// count_down does not run waiters.
//
// try_wait is true only when the count is already zero. It does not
// decrement, and it is not true while the count is positive.
//
// max() is modelled: it returns PTRDIFF_MAX. It does not wait and it does
// not change a latch.
//
// wait and arrive_and_wait stay omitted so a unit that names one fails to
// compile and pir falls back to libstdc++. A blocking wait that returns
// immediately would be a fake synchronization success. This header is not
// a concurrency proof.
#ifndef _GLIBCXX_LATCH
#define _GLIBCXX_LATCH 1

#pragma GCC system_header

#include <cstddef>
#include <cstdint>

// PIR intrinsic (translate.cpp). A literal class and message, as in the
// libc models. Not defined here: the analysed program does not link a body.
extern "C" void __prism_check(int ok, const char* cls, const char* msg);

namespace std {

class latch {
public:
    // The constructor argument is the count. A negative argument is a
    // precondition failure, so a latch that passes the check holds a
    // non-negative count.
    explicit latch(ptrdiff_t __expected) noexcept : _M_count(__expected) {
        __prism_check(__expected >= 0 ? 1 : 0, "FUNC-CONTRACT", "latch constructed with a negative count");
    }

    ~latch() = default;

    latch(const latch&) = delete;
    latch& operator=(const latch&) = delete;

    // max() is modelled. It returns PTRDIFF_MAX. It does not wait and it
    // does not change a latch.
    static constexpr ptrdiff_t max() noexcept { return PTRDIFF_MAX; }

    // wait and arrive_and_wait stay omitted so a unit that names one fails
    // to compile and pir falls back to libstdc++. A blocking wait that
    // returns immediately would be a fake synchronization success.

    void count_down(ptrdiff_t __n = 1) noexcept {
        // Subtract only when __n stays inside the count. A larger __n would
        // pass below zero: a precondition failure, not a wrap to a large
        // value. Waiters are not run.
        const int __ok = (__n >= 0 && __n <= _M_count) ? 1 : 0;
        __prism_check(__ok, "FUNC-CONTRACT", "latch::count_down would pass below zero");
        if (__ok) _M_count -= __n;
    }

    // True only when the count is already zero. Does not decrement.
    bool try_wait() const noexcept { return _M_count == 0; }

private:
    ptrdiff_t _M_count;
};

}  // namespace std

#endif
