// PRISM operational model of <format>. The pir stage puts this directory
// first on the C++ include path, so `#include <format>` reaches this file
// instead of libstdc++'s. It is a file, not a directory: a directory of
// this name would make the include fail with EISDIR and every such unit
// would fall back to libstdc++.
//
// Partial. format_to_n writes one int, in decimal, into a char buffer. The
// format string this model accepts is "{}". It writes at most n characters
// and does not write past the buffer. n == 0 writes nothing. The returned
// size is the full untruncated length of that integer, even when n is
// smaller, and it is not 0 for a non-zero int. A null output pointer with
// n > 0 is __prism_check. This header is not a proof.
//
// std::format and format_to return or allocate std::string. Those names are
// not declared. Those names fail to compile and pir falls back to libstdc++.
#ifndef _GLIBCXX_FORMAT
#define _GLIBCXX_FORMAT 1

#pragma GCC system_header

#include <cstddef>

// PIR intrinsic (translate.cpp). A literal class and message, as in the
// libc models. Not defined here: the analysed program does not link a body.
extern "C" void __prism_check(int ok, const char* cls, const char* msg);

namespace std {

// [format.to] out is the end of what was written. size is the untruncated
// length (not the number of characters that fit in n).
struct format_to_n_result {
    char* out;
    std::ptrdiff_t size;
};

inline format_to_n_result format_to_n(char* __out, std::size_t __n, const char* __fmt, int __v) {
    (void)__fmt;
    const bool __neg = __v < 0;
    // Magnitude via unsigned wrap, so INT_MIN is not a signed negation.
    unsigned __mag = __neg ? static_cast<unsigned>(0) - static_cast<unsigned>(__v) : static_cast<unsigned>(__v);
    char __rev[32];
    std::size_t __nd = 0;
    do {
        __rev[__nd] = static_cast<char>('0' + static_cast<int>(__mag % 10u));
        ++__nd;
        __mag /= 10u;
    } while (__mag != 0u);
    const std::size_t __len = __nd + (__neg ? static_cast<std::size_t>(1) : static_cast<std::size_t>(0));
    char __tmp[32];
    std::size_t __i = 0;
    if (__neg) __tmp[__i++] = '-';
    while (__nd > 0) {
        --__nd;
        __tmp[__i++] = __rev[__nd];
    }
    // n == 0 writes nothing and does not require an output pointer.
    if (__n > 0)
        __prism_check(__out != nullptr ? 1 : 0, "PTR-NULL-DEREF",
                      "format_to_n called with a null output pointer");
    const std::size_t __put = __len < __n ? __len : __n;
    if (__out != nullptr) {
        for (std::size_t __k = 0; __k < __put; ++__k) __out[__k] = __tmp[__k];
    }
    format_to_n_result __r;
    __r.out = __out == nullptr ? nullptr : __out + __put;
    // Full length, not the truncated count and not 0 for a non-zero int.
    __r.size = static_cast<std::ptrdiff_t>(__len);
    return __r;
}

}  // namespace std

#endif
