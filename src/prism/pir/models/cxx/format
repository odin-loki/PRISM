struct __prism_fmt_spec {
    char _M_fill = ' ', _M_align = 0, _M_sign = '-', _M_type = 0;
    bool _M_alt = false, _M_zero = false, _M_loc = false;
    size_t _M_width = 0;
    int _M_prec = -1;
};

inline const char* __prism_fmt_parse(const char* __f, __prism_fmt_spec& __s) {
    auto __is_align = [](char __c) { return __c == '<' || __c == '>' || __c == '^'; };
    if (__f[0] != '\0' && __f[0] != '}' && __is_align(__f[1])) { __s._M_fill = __f[0]; __s._M_align = __f[1]; __f += 2; }
    else if (__is_align(__f[0])) { __s._M_align = __f[0]; ++__f; }
    if (*__f == '+' || *__f == '-' || *__f == ' ') __s._M_sign = *__f++;
    if (*__f == '#') { __s._M_alt = true; ++__f; }
    if (*__f == '0') { __s._M_zero = true; ++__f; }
    if (*__f == '{') __prism_format_reject("std::format model: nested width/precision not supported");
    while (*__f >= '0' && *__f <= '9') { __s._M_width = __s._M_width * 10 + size_t(*__f - '0'); ++__f; }
    if (*__f == '.') {
        ++__f;
        if (*__f < '0' || *__f > '9') __prism_format_reject("std::format model: bad precision");
        __s._M_prec = 0;
        while (*__f >= '0' && *__f <= '9') { __s._M_prec = __s._M_prec * 10 + (*__f - '0'); if (__s._M_prec > 99) __prism_format_reject("std::format model: precision > 99"); ++__f; }
    }
    if (*__f == 'L') { __s._M_loc = true; ++__f; }
    if (*__f != '}' && *__f != '\0') __s._M_type = *__f++;
    if (*__f != '}') __prism_format_reject("std::format model: bad format spec");
    return __f + 1;
}

inline void __prism_fmt_pad(string& __out, const char* __body, size_t __len, const __prism_fmt_spec& __s,
                            char __defalign, size_t __zero_after) {
    if (__s._M_width <= __len) { __out.append(__body, __len); return; }
    size_t __pad = __s._M_width - __len;
    if (__s._M_zero && __s._M_align == 0) {  // sign/prefix, zeros, digits
        __out.append(__body, __zero_after);
        __out.append(__pad, '0');
        __out.append(__body + __zero_after, __len - __zero_after);
        return;
    }
    char __al = __s._M_align ? __s._M_align : __defalign;
    size_t __l = __al == '<' ? 0 : __al == '>' ? __pad : __pad / 2;
    __out.append(__l, __s._M_fill);
    __out.append(__body, __len);
    __out.append(__pad - __l, __s._M_fill);
}

inline void __prism_fmt_one(string& __out, const __prism_fmt_arg& __a, const __prism_fmt_spec& __s) {
    char __buf[80];
    size_t __n = 0;
    char __t = __s._M_type;
