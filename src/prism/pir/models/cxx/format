        if (*__f == ':') __f = __prism_fmt_parse(__f + 1, __s);
        else if (*__f == '}') ++__f;
        else __prism_format_reject("std::format model: bad replacement field");
        __prism_fmt_one(__out, __args[__idx], __s);
    }
}

// format_string is accepted as a plain const char* / string_view: the
// compile-time check of [format.fmt.string] is not modelled; the same
// errors are found at analysis time as FUNC-CONTRACT above.
template <typename... _Args>
string format(string_view __fmt, const _Args&... __args) {
    string __fs(__fmt);
    __prism_fmt_arg __a[sizeof...(_Args) + 1] = {__prism_fmt_make(__args)...};
    string __out;
    __prism_vformat(__out, __fs.c_str(), __a, sizeof...(_Args));
    return __out;
}
inline string vformat(string_view __fmt) { return format(__fmt); }
template <typename _Out, typename... _Args>
_Out format_to(_Out __out, string_view __fmt, const _Args&... __args) {
    string __s = format(__fmt, __args...);
    for (char __c : __s) *__out++ = __c;
    return __out;
}
template <typename... _Args>
size_t formatted_size(string_view __fmt, const _Args&... __args) {
    return format(__fmt, __args...).size();
}

