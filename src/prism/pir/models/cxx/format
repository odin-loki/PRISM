inline void __prism_vformat(string& __out, const char* __f, const __prism_fmt_arg* __args, size_t __nargs) {
    __prism_check(__f != nullptr ? 1 : 0, "PTR-NULL-DEREF", "std::format: null format string");
    size_t __next = 0;
    int __mode = 0;  // 0 unknown, 1 automatic, 2 manual
    while (*__f) {
        if (*__f == '{' && __f[1] == '{') { __out.push_back('{'); __f += 2; continue; }
        if (*__f == '}') {
            if (__f[1] != '}') __prism_format_reject("std::format model: unmatched '}'");
            __out.push_back('}'); __f += 2; continue;
        }
        if (*__f != '{') { __out.push_back(*__f++); continue; }
        ++__f;
        size_t __idx;
        if (*__f >= '0' && *__f <= '9') {
            if (__mode == 1) __prism_format_reject("std::format model: mixed automatic and manual indexing");
            __mode = 2; __idx = 0;
            while (*__f >= '0' && *__f <= '9') { __idx = __idx * 10 + size_t(*__f - '0'); ++__f; }
        } else {
            if (__mode == 2) __prism_format_reject("std::format model: mixed automatic and manual indexing");
            __mode = 1; __idx = __next++;
        }
        if (__idx >= __nargs) __prism_format_reject("std::format model: argument index out of range");
