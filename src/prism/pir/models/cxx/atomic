// PRISM model of <atomic>: std::atomic<T> for integral, bool and pointer
// types (and any trivially copyable T for load/store/exchange/CAS),
// atomic_flag, memory_order, fences. Values are plain members; every
// operation is a scheduler switch point (bits/prism_sched.h), taken after
// the operation, so other threads may run between any two atomic steps of a
// thread (within the preemption bound). Memory order is sequentially
// consistent: relaxed/acquire/release add no extra behaviour here (an
// under-approximation of weak-memory outcomes, see coverage-limits.md).
// wait(old) blocks while the value equals old: a queued thread must run,
// else CXX-DEADLOCK.
#ifndef _GLIBCXX_ATOMIC
#define _GLIBCXX_ATOMIC 1

#pragma GCC system_header

// conc stage: the pthread / seq_cst mapping its lazy sequentialisation encodes
#ifdef __PRISM_CONC_THREADS
#include "bits/prism_conc.h"
#else

#include "bits/prism_sched.h"
#include <type_traits>
#include <cstddef>

namespace std {

enum class memory_order : int { relaxed, consume, acquire, release, acq_rel, seq_cst };
inline constexpr memory_order memory_order_relaxed = memory_order::relaxed;
inline constexpr memory_order memory_order_consume = memory_order::consume;
inline constexpr memory_order memory_order_acquire = memory_order::acquire;
inline constexpr memory_order memory_order_release = memory_order::release;
inline constexpr memory_order memory_order_acq_rel = memory_order::acq_rel;
inline constexpr memory_order memory_order_seq_cst = memory_order::seq_cst;

inline void atomic_thread_fence(memory_order) noexcept { __prism_sched::__maybe_switch(); }
inline void atomic_signal_fence(memory_order) noexcept {}

template <class _Tp>
struct __prism_atomic_base {
    static_assert(is_trivially_copyable_v<_Tp>, "std::atomic<T> requires a trivially copyable T");
    _Tp _M_v;
    static constexpr bool is_always_lock_free = sizeof(_Tp) <= 8;
    constexpr __prism_atomic_base() noexcept(is_nothrow_default_constructible_v<_Tp>) : _M_v() {}
    constexpr __prism_atomic_base(_Tp __v) noexcept : _M_v(__v) {}
    __prism_atomic_base(const __prism_atomic_base&) = delete;
    __prism_atomic_base& operator=(const __prism_atomic_base&) = delete;

    bool is_lock_free() const noexcept { return is_always_lock_free; }
    _Tp load(memory_order = memory_order_seq_cst) const noexcept {
        _Tp __r = _M_v;
        __prism_sched::__maybe_switch();
        return __r;
    }
    void store(_Tp __v, memory_order = memory_order_seq_cst) noexcept {
        _M_v = __v;
        __prism_sched::__maybe_switch();
    }
    operator _Tp() const noexcept { return load(); }
    _Tp operator=(_Tp __v) noexcept { store(__v); return __v; }
    _Tp exchange(_Tp __v, memory_order = memory_order_seq_cst) noexcept {
        _Tp __o = _M_v;
        _M_v = __v;
        __prism_sched::__maybe_switch();
        return __o;
    }
    bool compare_exchange_strong(_Tp& __exp, _Tp __des, memory_order = memory_order_seq_cst, memory_order = memory_order_seq_cst) noexcept {
        bool __ok = __builtin_memcmp(&_M_v, &__exp, sizeof(_Tp)) == 0;
        if (__ok) _M_v = __des; else __exp = _M_v;
        __prism_sched::__maybe_switch();
        return __ok;
    }
    // weak may fail spuriously ([atomics.types.operations]): a solver choice.
    bool compare_exchange_weak(_Tp& __exp, _Tp __des, memory_order __a = memory_order_seq_cst, memory_order __b = memory_order_seq_cst) noexcept {
        unsigned char __s = 0;
        __prism_havoc_bytes(&__s, 1);
        if (__s & 1u) { __exp = _M_v; __prism_sched::__maybe_switch(); return false; }
        return compare_exchange_strong(__exp, __des, __a, __b);
    }
    void wait(_Tp __old, memory_order = memory_order_seq_cst) const {
        while (__builtin_memcmp(&_M_v, &__old, sizeof(_Tp)) == 0)
            __prism_sched::__must_switch("std::atomic::wait: no remaining thread changes the value");
    }
    void notify_one() noexcept { __prism_sched::__maybe_switch(); }
    void notify_all() noexcept { __prism_sched::__maybe_switch(); }
};

template <class _Tp>
struct atomic : __prism_atomic_base<_Tp> {
    using value_type = _Tp;
    using __prism_atomic_base<_Tp>::__prism_atomic_base;
    using __prism_atomic_base<_Tp>::operator=;
};

#define _PRISM_ATOMIC_RMW(name, op)                                         \
    _Tp name(_Tp __d, memory_order = memory_order_seq_cst) noexcept {     \
        _Tp __o = this->_M_v;                                             \
        this->_M_v = static_cast<_Tp>(__o op __d);                        \
        __prism_sched::__maybe_switch();                                  \
        return __o;                                                       \
    }

template <class _Tp>
    requires(is_integral_v<_Tp> && !is_same_v<_Tp, bool>)
struct atomic<_Tp> : __prism_atomic_base<_Tp> {
    using value_type = _Tp;
    using difference_type = _Tp;
    using __prism_atomic_base<_Tp>::__prism_atomic_base;
    using __prism_atomic_base<_Tp>::operator=;
    // Wraps (two's complement) for signed types too: [atomics.types.int].
    _Tp fetch_add(_Tp __d, memory_order = memory_order_seq_cst) noexcept {
        _Tp __o = this->_M_v;
        this->_M_v = static_cast<_Tp>(static_cast<make_unsigned_t<_Tp>>(__o) + static_cast<make_unsigned_t<_Tp>>(__d));
        __prism_sched::__maybe_switch();
        return __o;
    }
    _Tp fetch_sub(_Tp __d, memory_order = memory_order_seq_cst) noexcept {
        _Tp __o = this->_M_v;
        this->_M_v = static_cast<_Tp>(static_cast<make_unsigned_t<_Tp>>(__o) - static_cast<make_unsigned_t<_Tp>>(__d));
        __prism_sched::__maybe_switch();
        return __o;
    }
    _PRISM_ATOMIC_RMW(fetch_and, &)
    _PRISM_ATOMIC_RMW(fetch_or, |)
    _PRISM_ATOMIC_RMW(fetch_xor, ^)
    _Tp operator++() noexcept { return static_cast<_Tp>(fetch_add(1) + 1); }
    _Tp operator++(int) noexcept { return fetch_add(1); }
    _Tp operator--() noexcept { return static_cast<_Tp>(fetch_sub(1) - 1); }
    _Tp operator--(int) noexcept { return fetch_sub(1); }
    _Tp operator+=(_Tp __d) noexcept { return static_cast<_Tp>(fetch_add(__d) + __d); }
    _Tp operator-=(_Tp __d) noexcept { return static_cast<_Tp>(fetch_sub(__d) - __d); }
    _Tp operator&=(_Tp __d) noexcept { return static_cast<_Tp>(fetch_and(__d) & __d); }
    _Tp operator|=(_Tp __d) noexcept { return static_cast<_Tp>(fetch_or(__d) | __d); }
    _Tp operator^=(_Tp __d) noexcept { return static_cast<_Tp>(fetch_xor(__d) ^ __d); }
};
#undef _PRISM_ATOMIC_RMW

template <class _Tp>
struct atomic<_Tp*> : __prism_atomic_base<_Tp*> {
    using value_type = _Tp*;
    using difference_type = ptrdiff_t;
    using __prism_atomic_base<_Tp*>::__prism_atomic_base;
    using __prism_atomic_base<_Tp*>::operator=;
    _Tp* fetch_add(ptrdiff_t __d, memory_order = memory_order_seq_cst) noexcept {
        _Tp* __o = this->_M_v;
        this->_M_v = __o + __d;
        __prism_sched::__maybe_switch();
        return __o;
    }
    _Tp* fetch_sub(ptrdiff_t __d, memory_order = memory_order_seq_cst) noexcept { return fetch_add(-__d); }
    _Tp* operator++() noexcept { return fetch_add(1) + 1; }
    _Tp* operator++(int) noexcept { return fetch_add(1); }
    _Tp* operator--() noexcept { return fetch_sub(1) - 1; }
    _Tp* operator--(int) noexcept { return fetch_sub(1); }
    _Tp* operator+=(ptrdiff_t __d) noexcept { return fetch_add(__d) + __d; }
    _Tp* operator-=(ptrdiff_t __d) noexcept { return fetch_sub(__d) - __d; }
};

struct atomic_flag {
    bool _M_v = false;
    constexpr atomic_flag() noexcept = default;
    atomic_flag(const atomic_flag&) = delete;
    atomic_flag& operator=(const atomic_flag&) = delete;
    bool test_and_set(memory_order = memory_order_seq_cst) noexcept {
        bool __o = _M_v;
        _M_v = true;
        __prism_sched::__maybe_switch();
        return __o;
    }
    void clear(memory_order = memory_order_seq_cst) noexcept {
        _M_v = false;
        __prism_sched::__maybe_switch();
    }
    bool test(memory_order = memory_order_seq_cst) const noexcept {
        bool __r = _M_v;
        __prism_sched::__maybe_switch();
        return __r;
    }
    void wait(bool __old, memory_order = memory_order_seq_cst) const {
        while (_M_v == __old) __prism_sched::__must_switch("std::atomic_flag::wait: no remaining thread changes the flag");
    }
    void notify_one() noexcept { __prism_sched::__maybe_switch(); }
    void notify_all() noexcept { __prism_sched::__maybe_switch(); }
};
#define ATOMIC_FLAG_INIT {}

using atomic_bool = atomic<bool>;
using atomic_char = atomic<char>;
using atomic_int = atomic<int>;
using atomic_uint = atomic<unsigned>;
using atomic_long = atomic<long>;
using atomic_ulong = atomic<unsigned long>;
using atomic_llong = atomic<long long>;
using atomic_ullong = atomic<unsigned long long>;
using atomic_size_t = atomic<size_t>;
using atomic_ptrdiff_t = atomic<ptrdiff_t>;

}  // namespace std

#endif  // __PRISM_CONC_THREADS

#endif  // _GLIBCXX_ATOMIC
