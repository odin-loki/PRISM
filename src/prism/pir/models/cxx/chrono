// PRISM operational model of <chrono>. The pir stage puts this directory
// first on the C++ include path, so `#include <chrono>` reaches this file
// instead of libstdc++'s. It is a file, not a directory: a directory of
// this name would make the include fail with EISDIR and every such unit
// would fall back to libstdc++.
//
// Partial <chrono>. duration stores a signed 64-bit count. This file does
// not include <ratio>; another change owns that header. Addition and
// subtraction that would overflow the representation are a precondition
// failure (__prism_check). They do not wrap to a negative count and return
// that as success. A duration of the maximum count plus one count is that
// failure. count() returns the stored count. Zero stays zero.
// operator+= and operator-= for the same duration type use that same
// check and update the stored count. A sum or difference that does not
// fit stores 0. It does not store a wrapped negative.
//
// operator==, operator!=, operator<, operator>, operator<=, and operator>=
// compare the stored counts of two durations of the same type. They do not
// convert a period, do not add, and do not sleep. A different period is
// not an overload. This is not PROVED and not CLEAN.
//
// duration::zero() returns a duration whose count is 0. It does not add
// and does not sleep. duration::min() is the most negative count the
// representation can store. duration::max() is the most positive count.
// min() is not 0 and max() is not 0. They do not read another duration.
// A duration multiplied by a scalar of the same representation is that
// product. A product that does not fit is __prism_check then
// __builtin_trap. That path does not return a wrapped count and does not
// return a zero duration as a stand-in. Zero times any count is zero and
// does not overflow. A duration times a duration is not an overload, and
// a different period is not an overload. operator*= is not declared.
// This is not PROVED and not CLEAN.
//
// (Session 5: time_point, system_clock, steady_clock are now declared at
// the end of this file.) OS clock reads, and sleep_for /
// sleep_until are not declared. A sleep that returns immediately would be
// a fake wait. Omitted names fail to compile against this header and pir
// falls back to libstdc++. That includes period conversion and the calendar
// typedefs. Compound assignment is only the same duration type. A different
// period is not declared for it. duration_cast is declared only when
// the source and target period are the same type, this header's
// __duration_period (num 1, den 1). The result count is that count. It
// does not truncate and does not wrap. A cast to a different period is
// not declared, so that use fails to compile and pir still falls back.
#ifndef _GLIBCXX_CHRONO
#define _GLIBCXX_CHRONO 1

#pragma GCC system_header

// PIR intrinsic (translate.cpp). A literal class and message, as in the
// libc models. Not defined here: the analysed program does not link a body.
extern "C" void __prism_check(int ok, const char* cls, const char* msg);

static_assert(sizeof(long long) == 8, "duration stores a signed 64-bit count");

namespace std::chrono {

// Stand-in for the default period. Not std::ratio.
struct __duration_period {
    static constexpr long long num = 1;
    static constexpr long long den = 1;
};

inline constexpr long long __duration_rep_max = 9223372036854775807LL;
inline constexpr long long __duration_rep_min = -9223372036854775807LL - 1;

template <typename _Rep, typename _Period = __duration_period>
class duration {
    static_assert(sizeof(_Rep) == 8, "duration stores a signed 64-bit count");
    static_assert(static_cast<_Rep>(-1) < static_cast<_Rep>(0), "duration count is signed");

    _Rep _M_count = 0;

public:
    using rep = _Rep;
    using period = _Period;

    constexpr duration() noexcept = default;
    constexpr explicit duration(rep __count) noexcept : _M_count(__count) {}

    // The stored count. A zero duration stays zero.
    constexpr rep count() const noexcept { return _M_count; }

    // Count 0. Does not add, does not sleep, and does not read another duration.
    static constexpr duration zero() noexcept { return duration(static_cast<_Rep>(0)); }

    // Most negative count this representation can store. Not 0.
    // Does not read another duration.
    static constexpr duration min() noexcept { return duration(static_cast<_Rep>(__duration_rep_min)); }

    // Most positive count this representation can store. Not 0.
    // Does not read another duration.
    static constexpr duration max() noexcept { return duration(static_cast<_Rep>(__duration_rep_max)); }

    // Same duration type. A different period is not declared, so that
    // compound assignment fails to compile and pir still falls back.
    duration& operator+=(const duration& __d);
    duration& operator-=(const duration& __d);
};

// True when both types are the same type. Used so duration_cast exists
// only for __duration_period (num 1, den 1) and the same rep. A different
// period does not match, so that cast is not declared.
template <typename _A, typename _B>
inline constexpr bool __duration_same_type = false;

template <typename _A>
inline constexpr bool __duration_same_type<_A, _A> = true;

// Same period and the same rep. The count is copied. There is no ratio
// multiply and no division, so the count is not truncated and not wrapped.
// A different target period fails the constraint: the cast is not declared,
// the use fails to compile, and pir still falls back.
template <typename _ToDur, typename _Rep>
    requires __duration_same_type<typename _ToDur::period, __duration_period> &&
             __duration_same_type<typename _ToDur::rep, _Rep>
constexpr _ToDur duration_cast(const duration<_Rep, __duration_period>& __d) noexcept {
    return _ToDur(__d.count());
}

// True when __a + __b is representable. The limit arithmetic stays in range
// on the branch that reaches it, so the test itself does not wrap.
inline int __duration_add_fits(long long __a, long long __b) noexcept {
    if (__b > 0) {
        if (__a > __duration_rep_max - __b) return 0;
        return 1;
    }
    if (__b < 0) {
        if (__a < __duration_rep_min - __b) return 0;
        return 1;
    }
    return 1;
}

inline int __duration_sub_fits(long long __a, long long __b) noexcept {
    if (__b > 0) {
        if (__a < __duration_rep_min + __b) return 0;
        return 1;
    }
    if (__b < 0) {
        if (__a > __duration_rep_max + __b) return 0;
        return 1;
    }
    return 1;
}

template <typename _Rep, typename _Period>
duration<_Rep, _Period> operator+(const duration<_Rep, _Period>& __a,
                                  const duration<_Rep, _Period>& __b) {
    const long long __x = static_cast<long long>(__a.count());
    const long long __y = static_cast<long long>(__b.count());
    const int __ok = __duration_add_fits(__x, __y);
    __prism_check(__ok, "INT-SIGNED-OVF",
                  "std::chrono::duration addition overflows the representation");
    // Maximum count plus one count fails the check above. The wrapped
    // negative value is not produced.
    if (!__ok) return duration<_Rep, _Period>(0);
    return duration<_Rep, _Period>(static_cast<_Rep>(__x + __y));
}

template <typename _Rep, typename _Period>
duration<_Rep, _Period> operator-(const duration<_Rep, _Period>& __a,
                                  const duration<_Rep, _Period>& __b) {
    const long long __x = static_cast<long long>(__a.count());
    const long long __y = static_cast<long long>(__b.count());
    const int __ok = __duration_sub_fits(__x, __y);
    __prism_check(__ok, "INT-SIGNED-OVF",
                  "std::chrono::duration subtraction overflows the representation");
    if (!__ok) return duration<_Rep, _Period>(0);
    return duration<_Rep, _Period>(static_cast<_Rep>(__x - __y));
}

// Same duration type as operator+. The stored count is updated. A sum that
// does not fit is the check and then 0. The wrapped negative value is not
// stored.
template <typename _Rep, typename _Period>
duration<_Rep, _Period>& duration<_Rep, _Period>::operator+=(const duration<_Rep, _Period>& __d) {
    const long long __x = static_cast<long long>(count());
    const long long __y = static_cast<long long>(__d.count());
    const int __ok = __duration_add_fits(__x, __y);
    __prism_check(__ok, "INT-SIGNED-OVF",
                  "std::chrono::duration addition overflows the representation");
    if (!__ok) {
        _M_count = static_cast<_Rep>(0);
        return *this;
    }
    _M_count = static_cast<_Rep>(__x + __y);
    return *this;
}

// Same duration type as operator-. The stored count is updated. A difference
// that does not fit is the check and then 0. The wrapped negative value is
// not stored.
template <typename _Rep, typename _Period>
duration<_Rep, _Period>& duration<_Rep, _Period>::operator-=(const duration<_Rep, _Period>& __d) {
    const long long __x = static_cast<long long>(count());
    const long long __y = static_cast<long long>(__d.count());
    const int __ok = __duration_sub_fits(__x, __y);
    __prism_check(__ok, "INT-SIGNED-OVF",
                  "std::chrono::duration subtraction overflows the representation");
    if (!__ok) {
        _M_count = static_cast<_Rep>(0);
        return *this;
    }
    _M_count = static_cast<_Rep>(__x - __y);
    return *this;
}

// Count comparison. Same duration type only. The stored counts are
// compared. A different period is not an overload. These operators do not
// convert a period, do not add, and do not sleep.
// This is not PROVED and not CLEAN.
template <typename _Rep, typename _Period>
constexpr bool operator==(const duration<_Rep, _Period>& __a,
                          const duration<_Rep, _Period>& __b) noexcept {
    return __a.count() == __b.count();
}

template <typename _Rep, typename _Period>
constexpr bool operator!=(const duration<_Rep, _Period>& __a,
                          const duration<_Rep, _Period>& __b) noexcept {
    return __a.count() != __b.count();
}

template <typename _Rep, typename _Period>
constexpr bool operator<(const duration<_Rep, _Period>& __a,
                         const duration<_Rep, _Period>& __b) noexcept {
    return __a.count() < __b.count();
}

template <typename _Rep, typename _Period>
constexpr bool operator>(const duration<_Rep, _Period>& __a,
                         const duration<_Rep, _Period>& __b) noexcept {
    return __a.count() > __b.count();
}

template <typename _Rep, typename _Period>
constexpr bool operator<=(const duration<_Rep, _Period>& __a,
                          const duration<_Rep, _Period>& __b) noexcept {
    return __a.count() <= __b.count();
}

template <typename _Rep, typename _Period>
constexpr bool operator>=(const duration<_Rep, _Period>& __a,
                          const duration<_Rep, _Period>& __b) noexcept {
    return __a.count() >= __b.count();
}

// Duration multiplied by a scalar of the same representation.
// The scalar type is that same rep. A duration times a duration is not an
// overload, and a different period is not an overload. Zero times any count
// is zero: that product is returned before the check, and the multiply is
// not evaluated. It does not overflow. A product that does not fit is
// __prism_check then __builtin_trap. That path does not return a wrapped
// count and does not return a zero duration as a stand-in.
// This is not PROVED and not CLEAN.

// Magnitude as unsigned long long. The most negative count is not negated:
// v + 1 is representable for every negative v, and the magnitude is
// -(v + 1) + 1.
inline unsigned long long __duration_uabs(long long __v) noexcept {
    if (__v >= 0) return static_cast<unsigned long long>(__v);
    return static_cast<unsigned long long>(-(__v + 1)) + 1ull;
}

// True when the product of the two counts is representable as a signed
// 64-bit count. Zero times any count fits: the product is 0 and this test
// does not overflow. The unsigned product is formed only after the
// magnitudes are known to fit in unsigned long long, and that magnitude
// is then compared with the signed limit. A failing result does not yield
// a wrapped count.
inline int __duration_mul_fits(long long __a, long long __b) noexcept {
    if (__a == 0 || __b == 0) return 1;
    const int __neg = ((__a < 0) != (__b < 0)) ? 1 : 0;
    const unsigned long long __ua = __duration_uabs(__a);
    const unsigned long long __ub = __duration_uabs(__b);
    if (__ua > static_cast<unsigned long long>(-1) / __ub) return 0;
    const unsigned long long __product = __ua * __ub;
    const unsigned long long __max = static_cast<unsigned long long>(__duration_rep_max);
    if (__neg) return __product <= __max + 1ull ? 1 : 0;
    return __product <= __max ? 1 : 0;
}

// Signed product of a pair __duration_mul_fits has already accepted, or of
// a zero factor. The magnitude is multiplied in unsigned long long. A
// negative product is the two's-complement conversion of that magnitude,
// so the most negative count is not a signed negation. Zero is 0.
inline long long __duration_product(long long __a, long long __b) noexcept {
    if (__a == 0 || __b == 0) return 0;
    const int __neg = ((__a < 0) != (__b < 0)) ? 1 : 0;
    const unsigned long long __product = __duration_uabs(__a) * __duration_uabs(__b);
    if (__neg) return static_cast<long long>(0ull - __product);
    return static_cast<long long>(__product);
}

// Same representation. Both orders call this. A product that does not fit
// is the check and then __builtin_trap. The fitting product is the else,
// so a wrapped count is not returned, and a zero duration is not returned
// in its place.
template <typename _Rep, typename _Period>
duration<_Rep, _Period> __duration_mul(const duration<_Rep, _Period>& __d, const _Rep& __s) {
    const long long __x = static_cast<long long>(__d.count());
    const long long __y = static_cast<long long>(__s);
    // Zero times any count is zero. This return is the product. It is not
    // a stand-in for a product that does not fit, and the multiply is not
    // evaluated.
    if (__x == 0 || __y == 0)
        return duration<_Rep, _Period>(static_cast<_Rep>(0));
    const int __ok = __duration_mul_fits(__x, __y);
    __prism_check(__ok, "INT-SIGNED-OVF",
                  "std::chrono::duration multiplication overflows the representation");
    if (!__ok) {
        __builtin_trap();
    } else {
        return duration<_Rep, _Period>(static_cast<_Rep>(__duration_product(__x, __y)));
    }
}

template <typename _Rep, typename _Period, typename _Scalar>
    requires __duration_same_type<_Scalar, _Rep>
duration<_Rep, _Period> operator*(const duration<_Rep, _Period>& __d, const _Scalar& __s) {
    return __duration_mul(__d, __s);
}

template <typename _Rep, typename _Period, typename _Scalar>
    requires __duration_same_type<_Scalar, _Rep>
duration<_Rep, _Period> operator*(const _Scalar& __s, const duration<_Rep, _Period>& __d) {
    return __duration_mul(__d, __s);
}

// Session 5: time points and clocks. time_point<Clock, Duration> stores a
// Duration since the clock's epoch. + and - with a duration and the
// difference of two time points reuse the checked duration arithmetic, so
// an overflow is __prism_check, never a wrapped value. Comparisons compare
// time_since_epoch(). Clocks: now() is a nondeterministic count (any
// value: the analysed program cannot assume a time). steady_clock::now()
// is nondeterministic but never smaller than the previous call
// (is_steady); system_clock is not steady. No call sleeps or reads the OS.
// to_time_t / from_time_t on system_clock use the same one-unit period.
// This is not PROVED and not CLEAN.
}  // namespace std::chrono
extern "C" long long __VERIFIER_nondet_longlong(void);
extern "C" void __VERIFIER_assume(int);
namespace std::chrono {

template <typename _Clock, typename _Dur = typename _Clock::duration>
class time_point {
    _Dur _M_d{};

public:
    using clock = _Clock;
    using duration = _Dur;
    using rep = typename _Dur::rep;
    using period = typename _Dur::period;
    constexpr time_point() noexcept = default;
    constexpr explicit time_point(const _Dur& __d) noexcept : _M_d(__d) {}
    constexpr _Dur time_since_epoch() const noexcept { return _M_d; }
    time_point& operator+=(const _Dur& __d) { _M_d += __d; return *this; }
    time_point& operator-=(const _Dur& __d) { _M_d -= __d; return *this; }
    static constexpr time_point min() noexcept { return time_point(_Dur::min()); }
    static constexpr time_point max() noexcept { return time_point(_Dur::max()); }
};

template <typename _C, typename _D>
time_point<_C, _D> operator+(const time_point<_C, _D>& __t, const _D& __d) {
    return time_point<_C, _D>(__t.time_since_epoch() + __d);
}
template <typename _C, typename _D>
time_point<_C, _D> operator+(const _D& __d, const time_point<_C, _D>& __t) {
    return time_point<_C, _D>(__t.time_since_epoch() + __d);
}
template <typename _C, typename _D>
time_point<_C, _D> operator-(const time_point<_C, _D>& __t, const _D& __d) {
    return time_point<_C, _D>(__t.time_since_epoch() - __d);
}
template <typename _C, typename _D>
_D operator-(const time_point<_C, _D>& __a, const time_point<_C, _D>& __b) {
    return __a.time_since_epoch() - __b.time_since_epoch();
}
template <typename _C, typename _D>
bool operator==(const time_point<_C, _D>& __a, const time_point<_C, _D>& __b) { return __a.time_since_epoch() == __b.time_since_epoch(); }
template <typename _C, typename _D>
bool operator!=(const time_point<_C, _D>& __a, const time_point<_C, _D>& __b) { return !(__a == __b); }
template <typename _C, typename _D>
bool operator<(const time_point<_C, _D>& __a, const time_point<_C, _D>& __b) { return __a.time_since_epoch() < __b.time_since_epoch(); }
template <typename _C, typename _D>
bool operator>(const time_point<_C, _D>& __a, const time_point<_C, _D>& __b) { return __b < __a; }
template <typename _C, typename _D>
bool operator<=(const time_point<_C, _D>& __a, const time_point<_C, _D>& __b) { return !(__b < __a); }
template <typename _C, typename _D>
bool operator>=(const time_point<_C, _D>& __a, const time_point<_C, _D>& __b) { return !(__a < __b); }

// Same-type cast only, as duration_cast above.
template <typename _ToDur, typename _C, typename _D>
    requires __duration_same_type<_ToDur, _D>
constexpr time_point<_C, _ToDur> time_point_cast(const time_point<_C, _D>& __t) noexcept {
    return time_point<_C, _ToDur>(__t.time_since_epoch());
}

using seconds = duration<long long>;

struct system_clock {
    using rep = long long;
    using period = __duration_period;
    using duration = chrono::duration<rep, period>;
    using time_point = chrono::time_point<system_clock>;
    static constexpr bool is_steady = false;
    static time_point now() noexcept { return time_point(duration(__VERIFIER_nondet_longlong())); }
    static long long to_time_t(const time_point& __t) noexcept { return __t.time_since_epoch().count(); }
    static time_point from_time_t(long long __t) noexcept { return time_point(duration(__t)); }
};

struct steady_clock {
    using rep = long long;
    using period = __duration_period;
    using duration = chrono::duration<rep, period>;
    using time_point = chrono::time_point<steady_clock>;
    static constexpr bool is_steady = true;
    static time_point now() noexcept {
        static long long __last = __duration_rep_min;
        long long __v = __VERIFIER_nondet_longlong();
        __VERIFIER_assume(__v >= __last ? 1 : 0);
        __last = __v;
        return time_point(duration(__v));
    }
};
using high_resolution_clock = steady_clock;
template <typename _D> using sys_time = time_point<system_clock, _D>;
using sys_seconds = sys_time<seconds>;

}  // namespace std::chrono

#endif
