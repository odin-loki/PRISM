// PRISM model of C++23 <generator> (std::generator<Ref, V>, no custom
// allocator; elements_of of a nested generator is yielded ranges::elements_of is not
// modelled: a unit using it fails to compile here and falls back). Built on the <coroutine> model: iteration resumes the frame
// through __builtin_coro_resume, which the coro passes in lower_to_ir turn
// into calls the pir follows. Checks: dereferencing or incrementing an
// exhausted iterator (FUNC-CONTRACT), begin() called twice (FUNC-CONTRACT,
// [coro.generator.members]), an exception from the body is rethrown.
#ifndef _GLIBCXX_GENERATOR
#define _GLIBCXX_GENERATOR 1

#pragma GCC system_header

#include <coroutine>
#include <bits/iterator_concepts.h>  // default_sentinel_t (libstdc++)
#include <exception>
#include <memory>
#include <type_traits>
#include <utility>

namespace std {



template <class _Ref, class _Val = void, class _Alloc = void>
class generator {
    using _Value = conditional_t<is_void_v<_Val>, remove_cvref_t<_Ref>, _Val>;
    using _Reference = conditional_t<is_void_v<_Val>, _Ref&&, _Ref>;
    using _Yielded = conditional_t<is_reference_v<_Reference>, _Reference, const _Reference&>;

public:
    struct promise_type {
        add_pointer_t<_Yielded> _M_val = nullptr;
        exception_ptr _M_exc;

        generator get_return_object() noexcept { return generator(coroutine_handle<promise_type>::from_promise(*this)); }
        suspend_always initial_suspend() const noexcept { return {}; }
        suspend_always final_suspend() noexcept { return {}; }

        suspend_always yield_value(_Yielded __v) noexcept {
            _M_val = std::addressof(__v);
            return {};
        }
        // Copy of an lvalue when _Yielded is an rvalue reference.
        auto yield_value(const remove_reference_t<_Yielded>& __v)
            requires is_rvalue_reference_v<_Yielded> && constructible_from<remove_cvref_t<_Yielded>, const remove_reference_t<_Yielded>&>
        {
            struct _Aw {
                remove_cvref_t<_Yielded> _M_copy;
                promise_type* _M_p;
                bool await_ready() const noexcept { return false; }
                void await_suspend(coroutine_handle<>) noexcept { _M_p->_M_val = std::addressof(_M_copy); }
                void await_resume() const noexcept {}
            };
            return _Aw{__v, this};
        }
        void await_transform() = delete;
        void return_void() const noexcept {}
        void unhandled_exception() { _M_exc = current_exception(); }
    };

    class iterator {
        coroutine_handle<promise_type> _M_h;
        friend class generator;
        explicit iterator(coroutine_handle<promise_type> __h) noexcept : _M_h(__h) {}
    public:
        using value_type = _Value;
        using difference_type = ptrdiff_t;
        iterator(iterator&& __o) noexcept : _M_h(std::exchange(__o._M_h, nullptr)) {}
        iterator& operator=(iterator&& __o) noexcept { _M_h = std::exchange(__o._M_h, nullptr); return *this; }
        _Reference operator*() const {
            __prism_check(_M_h && !_M_h.done() ? 1 : 0, "FUNC-CONTRACT", "std::generator iterator dereferenced past the end");
            return static_cast<_Reference>(*_M_h.promise()._M_val);
        }
        iterator& operator++() {
            __prism_check(_M_h && !_M_h.done() ? 1 : 0, "FUNC-CONTRACT", "std::generator iterator incremented past the end");
            _M_h.resume();
            if (_M_h.promise()._M_exc) rethrow_exception(_M_h.promise()._M_exc);
            return *this;
        }
        void operator++(int) { ++*this; }
        friend bool operator==(const iterator& __i, default_sentinel_t) { return __i._M_h.done(); }
    };

    generator(const generator&) = delete;
    generator(generator&& __o) noexcept : _M_h(std::exchange(__o._M_h, nullptr)), _M_began(__o._M_began) {}
    generator& operator=(generator __o) noexcept { std::swap(_M_h, __o._M_h); std::swap(_M_began, __o._M_began); return *this; }
    ~generator() { if (_M_h) _M_h.destroy(); }

    iterator begin() {
        __prism_check(_M_h && !_M_began ? 1 : 0, "FUNC-CONTRACT", "std::generator::begin called twice or on a moved-from generator");
        _M_began = true;
        _M_h.resume();
        if (_M_h.promise()._M_exc) rethrow_exception(_M_h.promise()._M_exc);
        return iterator(_M_h);
    }
    default_sentinel_t end() const noexcept { return default_sentinel; }

private:
    coroutine_handle<promise_type> _M_h;
    bool _M_began = false;
    explicit generator(coroutine_handle<promise_type> __h) noexcept : _M_h(__h) {}
};

}  // namespace std

#endif  // _GLIBCXX_GENERATOR
