// PRISM partial stand-in for <ranges>. The pir stage puts this directory
// first on the C++ include path, so `#include <ranges>` reaches this file
// instead of libstdc++'s. It is a file, not a directory: a directory of
// that name would make the include fail with EISDIR and every such unit
// would fall back to libstdc++.
//
// std::ranges::size, std::ranges::ssize, std::ranges::empty,
// std::ranges::begin, std::ranges::end, std::ranges::data,
// std::ranges::cbegin, std::ranges::cend, std::ranges::cdata, and
// std::ranges::distance, and views::take / views::drop over contiguous
// lvalue ranges (pointer subranges, clamped; see below).
// size of a T(&)[N] is N. size of an lvalue with a const size() member
// is that size(). There is no overload for a pointer. A pointer argument
// fails to compile, and pir falls back to libstdc++. This stand-in does
// not give a pointer a length.
//
// ssize is that same value converted to ptrdiff_t. A value that does not
// fit is __prism_check with class FUNC-CONTRACT, then __builtin_trap.
// That path does not return a wrapped negative ptrdiff_t.
//
// empty of a T(&)[N] is true only when N == 0. The parameter is unnamed,
// so the element is not loaded. N == 0 does not match that parameter
// (clang: zero-length arrays are not permitted in C++). That array is a
// second overload: a reference whose size is 0. It returns true and does
// not load an element. A pointer's size is not 0, so it does not match.
// empty of an lvalue with a const empty() member returns that empty().
// There is no pointer overload. A pointer is not a range.
//
// begin of a T(&)[N] is a pointer to the first element. The return is
// array-to-pointer decay, not a load. end is a pointer one past the last.
// The addition is the bound, and it does not load an element. N == 0 does
// not match that parameter, for the same reason as empty. That array is a
// second overload: a reference whose size is 0. begin and end then return
// the same pointer. Neither loads it. A pointer argument's size is not 0,
// so it does not match. There is no pointer overload.
//
// data of a T(&)[N] is a pointer to the first element. The return is
// array-to-pointer decay, not a load. N == 0 does not match that
// parameter, for the same reason as begin. That array is a second
// overload: a reference whose size is 0. data then returns the decayed
// pointer and does not load it. A pointer argument's size is not 0, so
// it does not match. There is no pointer overload. Returning that
// pointer does not give it a length.
//
// cbegin of a T(&)[N] is a const pointer to the first element. The return
// is array-to-pointer decay, not a load. cend is a const pointer one past
// the last. The addition is the bound, and it does not load an element.
// cdata is that same const pointer by array-to-pointer decay, and it does
// not load an element. N == 0 does not match that parameter, for the same
// reason as begin. That array is a second overload: a reference whose size
// is 0. cbegin, cend, and cdata then return the decayed pointer and do not
// load it. A pointer argument's size is not 0, so it does not match. There
// is no pointer overload. Returning that pointer does not give it a length.
//
// distance of a T(&)[N] with N >= 1 is the bound converted to ptrdiff_t.
// The parameter is unnamed, so the element is not loaded. A bound that
// does not fit in ptrdiff_t is __prism_check with class FUNC-CONTRACT and
// message "std::ranges::distance does not fit in ptrdiff_t", then
// __builtin_trap. That path does not return a wrapped negative ptrdiff_t.
// N == 0 does not match that parameter, for the same reason as empty.
// That array is a second overload: a reference whose size is 0. It returns
// 0 and does not load an element. A pointer argument's size is not 0, so
// it does not match. There is no pointer overload. A pointer is not a
// range and is not given a length.
//
// sort, find, and views are not declared. A use fails to compile against
// this header and pir falls back. They are not stubbed. vector, memory,
// string, iterator, algorithm, and span are not included.
//
// This is not a proof that an iterator stays in range. This header is not
// a proof that a range is sorted or that a pointer has a length.
// This is not PROVED and not CLEAN.
#ifndef _GLIBCXX_RANGES
#define _GLIBCXX_RANGES 1

#pragma GCC system_header

#include <cstddef>
#include <cstdint>

// PIR intrinsic (translate.cpp). Literal class and message. Declared, not
// defined: the analysed program does not link a body.
extern "C" void __prism_check(int, const char*, const char*);

namespace std {

// The failing path never returns. A cast of a too-wide unsigned size would
// be a negative ptrdiff_t; this function does not produce that value.
[[noreturn]] inline void _Prism_ssize_does_not_fit() noexcept {
    __prism_check(0, "FUNC-CONTRACT", "ranges::ssize size does not fit in ptrdiff_t");
    __builtin_trap();
}

// Convert an integral size to ptrdiff_t. Unsigned values of ptrdiff_t's
// width (or wider) are checked against PTRDIFF_MAX. A signed type wider
// than ptrdiff_t is checked against both ends. Narrower values fit, so
// they are cast and not wrapped.
template <typename _Sz>
constexpr std::ptrdiff_t _Prism_as_ptrdiff(_Sz __n) noexcept {
    if constexpr (static_cast<_Sz>(-1) > static_cast<_Sz>(0)) {
        if constexpr (sizeof(_Sz) >= sizeof(std::ptrdiff_t)) {
            if (__n > static_cast<_Sz>(PTRDIFF_MAX)) _Prism_ssize_does_not_fit();
        }
    } else if constexpr (sizeof(_Sz) > sizeof(std::ptrdiff_t)) {
        if (__n > PTRDIFF_MAX || __n < PTRDIFF_MIN) _Prism_ssize_does_not_fit();
    }
    return static_cast<std::ptrdiff_t>(__n);
}

// The failing path never returns. A cast of a bound that does not fit
// would be a negative ptrdiff_t; this function does not produce that value.
[[noreturn]] inline void _Prism_ranges_distance_does_not_fit() noexcept {
    __prism_check(0, "FUNC-CONTRACT", "std::ranges::distance does not fit in ptrdiff_t");
    __builtin_trap();
}

namespace ranges {

template <typename _Tp, std::size_t _Nm>
constexpr std::size_t size(_Tp (&)[_Nm]) noexcept {
    return _Nm;
}

// Lvalue only. The const cast selects the const size() member. A type
// whose size() is not const, and a pointer, fail here and pir falls back.
template <typename _Tp>
constexpr auto size(_Tp& __t) noexcept(noexcept(static_cast<const _Tp&>(__t).size()))
    -> decltype(static_cast<const _Tp&>(__t).size()) {
    return static_cast<const _Tp&>(__t).size();
}

template <typename _Tp>
constexpr auto ssize(_Tp& __t) noexcept(noexcept(size(__t))) -> decltype(size(__t), std::ptrdiff_t()) {
    return _Prism_as_ptrdiff(size(__t));
}

// True only when N == 0. The parameter is unnamed, so this does not load
// an element. N == 0 does not match this parameter.
template <typename _Tp, std::size_t _Nm>
constexpr bool empty(_Tp (&)[_Nm]) noexcept {
    return _Nm == 0;
}

// N == 0. sizeof of a zero-length array is 0. The result is true, not a
// load of an element. A pointer argument has a non-zero size, so it does
// not match. When T(&)[N] is viable it is the more specialized overload,
// so a bound other than 0 is not taken here.
template <typename _Arr>
constexpr bool empty(_Arr&) noexcept
    requires(sizeof(_Arr) == 0)
{
    return true;
}

// Lvalue only. The const cast selects the const empty() member. A type
// whose empty() is not const, and a pointer, fail here and pir falls back.
template <typename _Tp>
constexpr auto empty(_Tp& __t) noexcept(noexcept(static_cast<const _Tp&>(__t).empty()))
    -> decltype(static_cast<const _Tp&>(__t).empty()) {
    return static_cast<const _Tp&>(__t).empty();
}

// Pointer to the first element. The bound is at least 1: N == 0 does not
// match this parameter. The return is array-to-pointer decay, not a load.
template <typename _Tp, std::size_t _Nm>
constexpr _Tp* begin(_Tp (&__a)[_Nm]) noexcept {
    return __a;
}

// One past the last element. The addition is the bound. N == 0 does not
// match this parameter. The addition does not load an element.
template <typename _Tp, std::size_t _Nm>
constexpr _Tp* end(_Tp (&__a)[_Nm]) noexcept {
    return __a + _Nm;
}

// N == 0. sizeof of a zero-length array is 0. The result is the decayed
// pointer, not a load. A pointer argument has a non-zero size, so it does
// not match. When T(&)[N] is viable it is the more specialized overload,
// so a bound other than 0 is not taken here.
template <typename _Arr>
constexpr auto begin(_Arr& __a) noexcept -> decltype(__a + 0)
    requires(sizeof(_Arr) == 0)
{
    return __a;
}

// Same pointer as begin. Adding zero does not load an element.
template <typename _Arr>
constexpr auto end(_Arr& __a) noexcept -> decltype(__a + 0)
    requires(sizeof(_Arr) == 0)
{
    return __a + 0;
}

// Pointer to the first element. The bound is at least 1: N == 0 does not
// match this parameter. The return is array-to-pointer decay, not a load.
template <typename _Tp, std::size_t _Nm>
constexpr _Tp* data(_Tp (&__a)[_Nm]) noexcept {
    return __a;
}

// N == 0. sizeof of a zero-length array is 0. The result is the decayed
// pointer, not a load. A pointer argument has a non-zero size, so it does
// not match. When T(&)[N] is viable it is the more specialized overload,
// so a bound other than 0 is not taken here.
template <typename _Arr>
constexpr auto data(_Arr& __a) noexcept -> decltype(__a + 0)
    requires(sizeof(_Arr) == 0)
{
    return __a;
}

// Const pointer to the first element. The bound is at least 1: N == 0 does
// not match this parameter. The return is array-to-pointer decay, not a load.
template <typename _Tp, std::size_t _Nm>
constexpr const _Tp* cbegin(_Tp (&__a)[_Nm]) noexcept {
    return __a;
}

// Const pointer one past the last element. The addition is the bound.
// N == 0 does not match this parameter. The addition does not load an element.
template <typename _Tp, std::size_t _Nm>
constexpr const _Tp* cend(_Tp (&__a)[_Nm]) noexcept {
    return __a + _Nm;
}

// N == 0. The result is the decayed pointer, not a load. A pointer argument
// has a non-zero size, so it does not match. When T(&)[N] is viable it is
// the more specialized overload, so a bound other than 0 is not taken here.
template <typename _Arr>
constexpr auto cbegin(_Arr& __a) noexcept -> decltype(static_cast<const _Arr&>(__a) + 0)
    requires(sizeof(_Arr) == 0)
{
    return __a;
}

// Same pointer as cbegin. The result is the decayed pointer, not a load.
template <typename _Arr>
constexpr auto cend(_Arr& __a) noexcept -> decltype(static_cast<const _Arr&>(__a) + 0)
    requires(sizeof(_Arr) == 0)
{
    return __a;
}

// Const pointer to the first element. The bound is at least 1: N == 0 does
// not match this parameter. The return is array-to-pointer decay, not a load.
template <typename _Tp, std::size_t _Nm>
constexpr const _Tp* cdata(_Tp (&__a)[_Nm]) noexcept {
    return __a;
}

// N == 0. The result is the decayed pointer, not a load. A pointer argument
// has a non-zero size, so it does not match. When T(&)[N] is viable it is
// the more specialized overload, so a bound other than 0 is not taken here.
template <typename _Arr>
constexpr auto cdata(_Arr& __a) noexcept -> decltype(static_cast<const _Arr&>(__a) + 0)
    requires(sizeof(_Arr) == 0)
{
    return __a;
}

// Bound as ptrdiff_t. The parameter is unnamed, so this does not load an
// element. N == 0 does not match this parameter. A bound that does not fit
// in ptrdiff_t is a check then a trap, not a wrapped negative ptrdiff_t.
template <typename _Tp, std::size_t _Nm>
constexpr std::ptrdiff_t distance(_Tp (&)[_Nm]) noexcept {
    if constexpr (sizeof(std::size_t) >= sizeof(std::ptrdiff_t)) {
        if (_Nm > static_cast<std::size_t>(PTRDIFF_MAX)) _Prism_ranges_distance_does_not_fit();
    }
    return static_cast<std::ptrdiff_t>(_Nm);
}

// N == 0. sizeof of a zero-length array is 0. The result is 0, not a load
// of an element. A pointer argument has a non-zero size, so it does not
// match. When T(&)[N] is viable it is the more specialized overload, so a
// bound other than 0 is not taken here.
template <typename _Arr>
constexpr std::ptrdiff_t distance(_Arr&) noexcept
    requires(sizeof(_Arr) == 0)
{
    return 0;
}

template <typename _P>
struct _Prism_ptr_elem;
template <typename _Tp>
struct _Prism_ptr_elem<_Tp*> {
    using type = _Tp;
};

// views::take and views::drop over a contiguous lvalue range (a T(&)[N], or a
// type with data() and size(): array, vector, span, string_view). The result
// is a pointer subrange [b, e) inside the source, clamped to its size as the
// standard requires, so iterating it never leaves the source. A negative
// count is FUNC-CONTRACT (the standard's precondition). Other views, rvalue
// ranges and non-contiguous ranges are not declared and fall back to libstdc++.
template <typename _Tp>
struct _Prism_ptr_subrange {
    _Tp* _M_b;
    _Tp* _M_e;
    constexpr _Tp* begin() const noexcept { return _M_b; }
    constexpr _Tp* end() const noexcept { return _M_e; }
    constexpr std::size_t size() const noexcept { return static_cast<std::size_t>(_M_e - _M_b); }
    constexpr bool empty() const noexcept { return _M_b == _M_e; }
};
struct _Prism_take_n { std::ptrdiff_t _M_n; };
struct _Prism_drop_n { std::ptrdiff_t _M_n; };
template <typename _Tp>
constexpr std::size_t _Prism_view_count(std::ptrdiff_t __n, std::size_t __sz) noexcept {
    __prism_check(__n >= 0, "FUNC-CONTRACT", "views::take/drop with a negative count");
    if (__n < 0) __builtin_trap();
    return static_cast<std::size_t>(__n) < __sz ? static_cast<std::size_t>(__n) : __sz;
}
template <typename _Tp, std::size_t _Nm>
constexpr _Prism_ptr_subrange<_Tp> operator|(_Tp (&__a)[_Nm], _Prism_take_n __t) noexcept {
    return {__a, __a + _Prism_view_count<_Tp>(__t._M_n, _Nm)};
}
template <typename _Tp, std::size_t _Nm>
constexpr _Prism_ptr_subrange<_Tp> operator|(_Tp (&__a)[_Nm], _Prism_drop_n __t) noexcept {
    return {__a + _Prism_view_count<_Tp>(__t._M_n, _Nm), __a + _Nm};
}
template <typename _R>
constexpr auto operator|(_R& __r, _Prism_take_n __t) noexcept
    -> _Prism_ptr_subrange<typename _Prism_ptr_elem<decltype(__r.data())>::type> {
    auto* __b = __r.data();
    return {__b, __b + _Prism_view_count<int>(__t._M_n, static_cast<std::size_t>(__r.size()))};
}
template <typename _R>
constexpr auto operator|(_R& __r, _Prism_drop_n __t) noexcept
    -> _Prism_ptr_subrange<typename _Prism_ptr_elem<decltype(__r.data())>::type> {
    auto* __b = __r.data();
    const std::size_t __sz = static_cast<std::size_t>(__r.size());
    return {__b + _Prism_view_count<int>(__t._M_n, __sz), __b + __sz};
}
namespace views {
constexpr _Prism_take_n take(std::ptrdiff_t __n) noexcept { return {__n}; }
constexpr _Prism_drop_n drop(std::ptrdiff_t __n) noexcept { return {__n}; }
}  // namespace views
}  // namespace ranges
namespace views = ranges::views;
}  // namespace std

#endif  // _GLIBCXX_RANGES
