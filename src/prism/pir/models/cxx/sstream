// PRISM operational model of <sstream> (roadmap 2.6, docs/PIR.md "C++ library
// models"): enough of std::basic_stringbuf and std::basic_ostringstream for
// the pir stage to inline typical `ostringstream` usage without libstdc++.so
// NEEDS-HARNESS from <ostream>. The pir stage puts this directory first on the
// C++ include path, so `#include <sstream>` reaches this file instead of
// libstdc++'s. Only char / char_traits<char> / allocator<char> are modelled;
// other instantiations are left undefined here and the unit falls back to
// libstdc++ (reported in `extra.cxx_models`). iostream input, stringstream,
// and istringstream are not provided.
#ifndef _PRISM_MODEL_SSTREAM
#define _PRISM_MODEL_SSTREAM 1
#define _GLIBCXX_SSTREAM 1  // libstdc++'s <sstream> include guard: never both

#pragma GCC system_header

#include <bits/c++config.h>
#include <ios>
#include <string>
#include <type_traits>

namespace std _GLIBCXX_VISIBILITY(default) {
_GLIBCXX_BEGIN_NAMESPACE_VERSION
_GLIBCXX_BEGIN_NAMESPACE_CXX11

template <typename _CharT, typename _Traits, typename _Alloc>
class basic_ostringstream;

// [27.7.1] basic_stringbuf — output sequence tracked at _M_out (put pointer).
template <typename _CharT, typename _Traits, typename _Alloc>
class basic_stringbuf {
public:
    typedef _CharT char_type;
    typedef _Traits traits_type;
    typedef _Alloc allocator_type;
    typedef typename traits_type::int_type int_type;
    typedef typename traits_type::pos_type pos_type;
    typedef typename traits_type::off_type off_type;
    typedef basic_string<_CharT, _Traits, _Alloc> __string_type;
    typedef typename __string_type::size_type __size_type;

    static_assert(is_same_v<_CharT, char>, "PRISM sstream model: only char is modelled (the pir stage falls back to libstdc++)");
    static_assert(is_same_v<_Traits, char_traits<char>>,
                  "PRISM sstream model: only char_traits<char> is modelled (the pir stage falls back to libstdc++)");
    static_assert(is_same_v<_Alloc, allocator<char>>,
                  "PRISM sstream model: only std::allocator<char> is modelled (the pir stage falls back to libstdc++)");

protected:
    ios_base::openmode _M_mode;
    __string_type _M_string;
    __size_type _M_out = 0;
    bool _M_put_started = false;

    void _M_append(const char_type* __s, __size_type __n) {
        if (!(_M_mode & ios_base::out) || __n == 0 || __s == nullptr) return;
        // ate/app open at the end; app seeks to the end before every write.
        // Default `out` overwrites from the start and keeps the unwritten tail.
        if (!_M_put_started) {
            _M_out = (_M_mode & (ios_base::ate | ios_base::app)) ? _M_string.size() : 0;
            _M_put_started = true;
        } else if (_M_mode & ios_base::app)
            _M_out = _M_string.size();
        if (_M_out == _M_string.size()) {
            _M_string.append(__s, __n);
            _M_out = _M_string.size();
            return;
        }
        const __size_type __need = _M_out + __n;
        if (__need > _M_string.size()) _M_string.resize(__need, char_type());
        traits_type::copy(_M_string.data() + _M_out, __s, __n);
        _M_out = __need;
    }

    void _M_append(const __string_type& __s) { _M_append(__s.data(), __s.size()); }

    // Lighter integer text (session 4): digits into a stack buffer, then
    // one _M_append. No temporary std::string (std::to_string allocated and
    // freed a heap block per operator<<), so a loop of operator<< has one
    // growing allocation, not two per iteration. Same "C"-locale text.
    void _M_append_ull(unsigned long long __mag, bool __neg) {
        char __buf[24];
        __size_type __i = sizeof(__buf);
        do {
            __buf[--__i] = static_cast<char>('0' + static_cast<int>(__mag % 10ull));
            __mag /= 10ull;
        } while (__mag != 0ull);
        if (__neg) __buf[--__i] = '-';
        _M_append(__buf + __i, sizeof(__buf) - __i);
    }
    void _M_append_ll(long long __v) {
        const bool __neg = __v < 0;
        _M_append_ull(__neg ? 0ull - static_cast<unsigned long long>(__v) : static_cast<unsigned long long>(__v), __neg);
    }
    void _M_append_int(int __v) { _M_append_ll(__v); }

    friend class basic_ostringstream<_CharT, _Traits, _Alloc>;

public:
    basic_stringbuf() : _M_mode(ios_base::in | ios_base::out), _M_string() {}

    explicit basic_stringbuf(ios_base::openmode __mode) : _M_mode(__mode), _M_string() {}

    explicit basic_stringbuf(const __string_type& __str, ios_base::openmode __mode = ios_base::in | ios_base::out)
        : _M_mode(__mode), _M_string(__str), _M_out(0) {}

    basic_stringbuf(const basic_stringbuf&) = delete;
    basic_stringbuf(basic_stringbuf&& __rhs) noexcept
        : _M_mode(__rhs._M_mode), _M_string(std::move(__rhs._M_string)), _M_out(__rhs._M_out),
          _M_put_started(__rhs._M_put_started) {
        __rhs._M_out = 0;
        __rhs._M_put_started = false;
    }

    basic_stringbuf& operator=(const basic_stringbuf&) = delete;
    basic_stringbuf& operator=(basic_stringbuf&& __rhs) noexcept {
        _M_mode = __rhs._M_mode;
        _M_string = std::move(__rhs._M_string);
        _M_out = __rhs._M_out;
        _M_put_started = __rhs._M_put_started;
        __rhs._M_out = 0;
        __rhs._M_put_started = false;
        return *this;
    }

    // High-water content, not the put pointer. A short overwrite of a longer
    // seed leaves the tail (libstdc++ max(pptr, egptr)), so str() is the buffer.
    __string_type str() const { return _M_string; }

    // Output sequence the contracts call. Not a basic_streambuf; input and
    // seeking are not modelled.
    std::streamsize sputn(const char_type* __s, std::streamsize __n) {
        if (__s == nullptr || __n <= 0 || !(_M_mode & ios_base::out)) return 0;
        _M_append(__s, static_cast<__size_type>(__n));
        return __n;
    }

    void str(const __string_type& __s) {
        _M_string = __s;
        _M_out = 0;
        _M_put_started = false;
    }

    void str(__string_type&& __s) {
        _M_string = std::move(__s);
        _M_out = 0;
        _M_put_started = false;
    }
};

// [27.7.3] basic_ostringstream — no basic_ostream base; operator<< for the
// types PIR most often encodes (int, C string, basic_string).
template <typename _CharT, typename _Traits, typename _Alloc>
class basic_ostringstream {
public:
    typedef _CharT char_type;
    typedef _Traits traits_type;
    typedef _Alloc allocator_type;
    typedef typename traits_type::int_type int_type;
    typedef typename traits_type::pos_type pos_type;
    typedef typename traits_type::off_type off_type;
    typedef basic_string<_CharT, _Traits, _Alloc> __string_type;
    typedef basic_stringbuf<_CharT, _Traits, _Alloc> __stringbuf_type;

private:
    __stringbuf_type _M_stringbuf;
    ios_base::iostate _M_state = ios_base::goodbit;
    ios_base::iostate _M_except = ios_base::goodbit;

public:
    basic_ostringstream() : _M_stringbuf(ios_base::out) {}

    explicit basic_ostringstream(ios_base::openmode __mode) : _M_stringbuf(__mode | ios_base::out) {}

    explicit basic_ostringstream(const __string_type& __str, ios_base::openmode __mode = ios_base::out)
        : _M_stringbuf(__str, __mode | ios_base::out) {}

    basic_ostringstream(const basic_ostringstream&) = delete;
    basic_ostringstream(basic_ostringstream&& __rhs) noexcept : _M_stringbuf(std::move(__rhs._M_stringbuf)), _M_state(__rhs._M_state), _M_except(__rhs._M_except) {}

    ~basic_ostringstream() = default;

    basic_ostringstream& operator=(const basic_ostringstream&) = delete;
    basic_ostringstream& operator=(basic_ostringstream&& __rhs) noexcept {
        _M_stringbuf = std::move(__rhs._M_stringbuf);
        _M_state = __rhs._M_state;
        _M_except = __rhs._M_except;
        return *this;
    }

    __stringbuf_type* rdbuf() const { return const_cast<__stringbuf_type*>(&_M_stringbuf); }

    // [iostate.flags] Stream state and exception mask, as basic_ios keeps
    // them. clear() throws ios_base::failure when the new state meets the
    // mask (std::__throw_ios_failure: pir maps it to that type).
    ios_base::iostate rdstate() const { return _M_state; }
    void clear(ios_base::iostate __s = ios_base::goodbit) {
        _M_state = __s;
        if ((_M_state & _M_except) != 0) std::__throw_ios_failure("basic_ios::clear");
    }
    void setstate(ios_base::iostate __s) { clear(_M_state | __s); }
    bool good() const { return _M_state == ios_base::goodbit; }
    bool eof() const { return (_M_state & ios_base::eofbit) != 0; }
    bool fail() const { return (_M_state & (ios_base::badbit | ios_base::failbit)) != 0; }
    bool bad() const { return (_M_state & ios_base::badbit) != 0; }
    explicit operator bool() const { return !fail(); }
    bool operator!() const { return fail(); }
    ios_base::iostate exceptions() const { return _M_except; }
    void exceptions(ios_base::iostate __e) {
        _M_except = __e;
        clear(_M_state);
    }

    __string_type str() const { return _M_stringbuf.str(); }

    void str(const __string_type& __s) { _M_stringbuf.str(__s); }

    void str(__string_type&& __s) { _M_stringbuf.str(std::move(__s)); }

    basic_ostringstream& operator<<(int __v) {
        _M_stringbuf._M_append_int(__v);
        return *this;
    }

    // Exact match so a char (e.g. ':') is not promoted to operator<<(int).
    basic_ostringstream& operator<<(char __c) {
        _M_stringbuf._M_append(&__c, 1);
        return *this;
    }

    basic_ostringstream& operator<<(const char* __s) {
        if (__s) _M_stringbuf._M_append(__s, traits_type::length(__s));
        return *this;
    }

    basic_ostringstream& operator<<(const __string_type& __s) {
        _M_stringbuf._M_append(__s);
        return *this;
    }

    // Wider integers: decimal text from a stack buffer, as num_put does in
    // the "C" locale with default flags. bool prints 0/1 (noboolalpha).
    basic_ostringstream& operator<<(long __v) { _M_stringbuf._M_append_ll(__v); return *this; }
    basic_ostringstream& operator<<(long long __v) { _M_stringbuf._M_append_ll(__v); return *this; }
    basic_ostringstream& operator<<(unsigned __v) { _M_stringbuf._M_append_ull(__v, false); return *this; }
    basic_ostringstream& operator<<(unsigned long __v) { _M_stringbuf._M_append_ull(__v, false); return *this; }
    basic_ostringstream& operator<<(unsigned long long __v) { _M_stringbuf._M_append_ull(__v, false); return *this; }
    basic_ostringstream& operator<<(short __v) { return *this << static_cast<int>(__v); }
    basic_ostringstream& operator<<(unsigned short __v) { return *this << static_cast<int>(__v); }
    basic_ostringstream& operator<<(bool __v) { return *this << (__v ? '1' : '0'); }

    // Unformatted output.
    basic_ostringstream& put(char_type __c) { return *this << __c; }
    basic_ostringstream& write(const char_type* __s, std::streamsize __n) {
        _M_stringbuf.sputn(__s, __n);
        return *this;
    }
    basic_ostringstream& flush() { return *this; }

    void swap(basic_ostringstream& __o) noexcept {
        basic_ostringstream __t(std::move(__o));
        __o = std::move(*this);
        *this = std::move(__t);
    }

private:
    basic_ostringstream& _M_text(const __string_type& __t) {
        _M_stringbuf._M_append(__t);
        return *this;
    }
};

typedef basic_stringbuf<char> stringbuf;
typedef basic_ostringstream<char> ostringstream;

_GLIBCXX_END_NAMESPACE_CXX11
_GLIBCXX_END_NAMESPACE_VERSION
}  // namespace std

#endif  // _PRISM_MODEL_SSTREAM
