// Partial model of the <numbers> header. The pir stage puts this directory
// first on the C++ include path, so a translation unit that names <numbers>
// reaches this file instead of libstdc++. No standard header is included.
// Special functions are omitted.
//
// Each name is a variable template. The initializer is a long double
// decimal literal (the usual expansion). These values are not exact.
// a comparison against these literals is not a proof of a numeric identity.
#ifndef _GLIBCXX_NUMBERS
#define _GLIBCXX_NUMBERS 1

#pragma GCC system_header

namespace std::numbers {

// [numbers.syn]: the _v variable templates and the double constants.
template <typename _Tp>
inline constexpr _Tp e_v = 2.718281828459045235360287471352662498L;
inline constexpr double e = e_v<double>;

template <typename _Tp>
inline constexpr _Tp log2e_v = 1.442695040888963407359924681001892137L;
inline constexpr double log2e = log2e_v<double>;

template <typename _Tp>
inline constexpr _Tp log10e_v = 0.434294481903251827651128918916605082L;
inline constexpr double log10e = log10e_v<double>;

template <typename _Tp>
inline constexpr _Tp pi_v = 3.141592653589793238462643383279502884L;
inline constexpr double pi = pi_v<double>;

template <typename _Tp>
inline constexpr _Tp inv_pi_v = 0.318309886183790671537767526745028724L;
inline constexpr double inv_pi = inv_pi_v<double>;

template <typename _Tp>
inline constexpr _Tp inv_sqrtpi_v = 0.564189583547756286948079451560772586L;
inline constexpr double inv_sqrtpi = inv_sqrtpi_v<double>;

template <typename _Tp>
inline constexpr _Tp ln2_v = 0.693147180559945309417232121458176568L;
inline constexpr double ln2 = ln2_v<double>;

template <typename _Tp>
inline constexpr _Tp ln10_v = 2.302585092994045684017991454684364208L;
inline constexpr double ln10 = ln10_v<double>;

template <typename _Tp>
inline constexpr _Tp sqrt2_v = 1.414213562373095048801688724209698079L;
inline constexpr double sqrt2 = sqrt2_v<double>;

template <typename _Tp>
inline constexpr _Tp sqrt3_v = 1.732050807568877293527446341505872367L;
inline constexpr double sqrt3 = sqrt3_v<double>;

template <typename _Tp>
inline constexpr _Tp inv_sqrt3_v = 0.577350269189625764509148780501957456L;
inline constexpr double inv_sqrt3 = inv_sqrt3_v<double>;

template <typename _Tp>
inline constexpr _Tp egamma_v = 0.577215664901532860606512090082402431L;
inline constexpr double egamma = egamma_v<double>;

template <typename _Tp>
inline constexpr _Tp phi_v = 1.618033988749894848204586834365638118L;
inline constexpr double phi = phi_v<double>;

}  // namespace std::numbers

#endif  // _GLIBCXX_NUMBERS
