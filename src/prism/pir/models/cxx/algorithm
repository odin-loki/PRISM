// PRISM operational model of <algorithm>. Partial on purpose.
// The pir stage puts this directory first on the C++ include path, so
// `#include <algorithm>` reaches this file instead of libstdc++'s. It is a
// file, not a directory: a directory of this name would make the include
// fail with EISDIR and every such unit would fall back to libstdc++.
//
// std::min, std::max, and std::clamp, for a type comparable with operator<.
// min(a, b) returns a when !(b < a), otherwise b. Equal arguments return
// the first argument. max is the symmetric rule: a when !(a < b), otherwise
// b. The result is one of those two arguments. It is not a third value, and
// it is not a sum that wrapped to 0.
//
// clamp(v, lo, hi): when hi < lo, __prism_check with class FUNC-CONTRACT
// and then __builtin_trap. That path does not return v. When the range is
// valid, the result is lo if v < lo, hi if hi < v, otherwise v.
//
// std::min_element and std::max_element take two pointers, first and last.
// There is no comparator. When last < first, __prism_check with class
// FUNC-CONTRACT and then __builtin_trap. That path does not return a
// pointer. When first == last, the result is last. That path does not read
// an element and does not invent a T. Otherwise the result is a pointer to
// the minimum or the maximum element in [first, last). Equal elements keep
// the first.
//
// std::find takes two pointers, first and last, and a const T& value.
// There is no other overload. When last < first, __prism_check with class
// FUNC-CONTRACT and then __builtin_trap. That path does not read an element
// and does not invent a T. When first == last, the result is last. That
// path does not read an element. Otherwise the result is a pointer to the
// first element in [first, last) that compares equal with operator==, or
// last if none. The function does not allocate.
//
// std::find_if takes two pointers and one function pointer,
// bool (*)(const T&). There is no other overload. A null predicate is
// __prism_check with class FUNC-CONTRACT and then __builtin_trap. That
// path does not call the predicate. When last < first, __prism_check with
// class FUNC-CONTRACT and the message "find_if: last < first", then
// __builtin_trap. That path does not read an element and does not invent
// a T. When first == last, the result is last. That path does not read
// an element and does not call the predicate. Otherwise the result is a
// pointer to the first element for which the predicate returns true, or
// last if none. The function does not allocate.
//
// std::count takes two pointers and a const T&. The result is a ptrdiff_t:
// how many elements in [first, last) compare equal with operator==. When
// last < first, __prism_check with class FUNC-CONTRACT and then
// __builtin_trap. That path does not read an element. When first == last,
// the result is 0. That path does not read an element. A count that would
// not fit in ptrdiff_t is __prism_check with class FUNC-CONTRACT and then
// __builtin_trap. That path does not return a wrapped count. The function
// does not allocate.
//
// The C++11 predicates over two pointers and any callable predicate:
// all_of, any_of, none_of, find_if_not, copy_if, is_partitioned,
// partition_point, minmax, minmax_element, is_heap, is_heap_until. An
// inverted range is __prism_check FUNC-CONTRACT then __builtin_trap, as
// above. Empty ranges follow [alg.all.of]: all_of and none_of are true,
// any_of is false. minmax_element returns the first smallest and the last
// largest.
//
// sort, copy, fill, for_each, and every other algorithm are not
// declared. A use of those names fails to compile and the pir stage falls
// back to libstdc++ (extra.cxx_models). A partial header is intentional.
//
// This header is not a proof that a range is sorted. It is not PROVED
// and it is not CLEAN. After a failed check the path traps. It does not
// continue into a read or a fabricated success.
#ifndef _GLIBCXX_ALGORITHM
#define _GLIBCXX_ALGORITHM 1

#pragma GCC system_header

#include <bits/stl_pair.h>

// PIR intrinsic (translate.cpp). Literal class and message, as in the libc
// models. Not defined here: the analysed program does not link a body.
extern "C" void __prism_check(int ok, const char* cls, const char* msg);

namespace std {

template <typename _Tp>
concept _Prism_less_than_comparable = requires(const _Tp& __x, const _Tp& __y) { __x < __y; };

template <_Prism_less_than_comparable _Tp>
constexpr const _Tp& min(const _Tp& __a, const _Tp& __b) {
    // Equal arguments: !(b < a), so the first argument is returned.
    if (!(__b < __a)) return __a;
    return __b;
}

template <_Prism_less_than_comparable _Tp>
constexpr const _Tp& max(const _Tp& __a, const _Tp& __b) {
    if (!(__a < __b)) return __a;
    return __b;
}

template <_Prism_less_than_comparable _Tp>
constexpr const _Tp& clamp(const _Tp& __v, const _Tp& __lo, const _Tp& __hi) {
    if (__hi < __lo) {
        __prism_check(0, "FUNC-CONTRACT", "clamp: hi < lo");
        // The range is not valid. __v is not a result of this path.
        __builtin_trap();
    }
    if (__v < __lo) return __lo;
    if (__hi < __v) return __hi;
    return __v;
}

// Two pointers only. An inverted range traps. An empty range returns last
// and does not read an element. Equal elements keep the earlier pointer.
template <_Prism_less_than_comparable _Tp>
constexpr _Tp* min_element(_Tp* __first, _Tp* __last) {
    if (__last < __first) {
        __prism_check(0, "FUNC-CONTRACT", "min_element: last < first");
        __builtin_trap();
    }
    if (__first == __last) return __last;
    _Tp* __result = __first;
    ++__first;
    while (__first != __last) {
        if (*__first < *__result) __result = __first;
        ++__first;
    }
    return __result;
}

template <_Prism_less_than_comparable _Tp>
constexpr _Tp* max_element(_Tp* __first, _Tp* __last) {
    if (__last < __first) {
        __prism_check(0, "FUNC-CONTRACT", "max_element: last < first");
        __builtin_trap();
    }
    if (__first == __last) return __last;
    _Tp* __result = __first;
    ++__first;
    while (__first != __last) {
        if (*__result < *__first) __result = __first;
        ++__first;
    }
    return __result;
}

template <typename _Tp>
concept _Prism_equality_comparable = requires(const _Tp& __x, const _Tp& __y) { __x == __y; };

// Two pointers and one value. An inverted range traps without reading and
// without inventing a T. An empty range returns last and does not read.
// operator== picks the first match. Nothing is allocated.
template <_Prism_equality_comparable _Tp>
constexpr _Tp* find(_Tp* __first, _Tp* __last, const _Tp& __value) {
    if (__last < __first) {
        __prism_check(0, "FUNC-CONTRACT", "find: last < first");
        __builtin_trap();
    }
    if (__first == __last) return __last;
    while (__first != __last) {
        if (*__first == __value) return __first;
        ++__first;
    }
    return __last;
}

// Function pointer only. A null predicate traps before any call. An
// inverted range traps before any read. An empty range returns last and
// does not call. This is not PROVED and it is not CLEAN.
template <typename _Tp>
constexpr _Tp* find_if(_Tp* __first, _Tp* __last, bool (*__pred)(const _Tp&)) {
    if (__pred == nullptr) {
        __prism_check(0, "FUNC-CONTRACT", "find_if: null predicate");
        __builtin_trap();
    }
    if (__last < __first) {
        __prism_check(0, "FUNC-CONTRACT", "find_if: last < first");
        __builtin_trap();
    }
    if (__first == __last) return __last;
    while (__first != __last) {
        if (__pred(*__first)) return __first;
        ++__first;
    }
    return __last;
}

// Two pointers and one value. An inverted range traps without reading.
// An empty range returns 0 and does not read. The tally is a ptrdiff_t.
// One more match than that type can hold traps and does not wrap.
// This is not PROVED and it is not CLEAN.
template <_Prism_equality_comparable _Tp>
constexpr __PTRDIFF_TYPE__ count(_Tp* __first, _Tp* __last, const _Tp& __value) {
    if (__last < __first) {
        __prism_check(0, "FUNC-CONTRACT", "count: last < first");
        __builtin_trap();
    }
    if (__first == __last) return 0;
    __PTRDIFF_TYPE__ __n = 0;
    while (__first != __last) {
        if (*__first == __value) {
            if (__n == static_cast<__PTRDIFF_TYPE__>(__PTRDIFF_MAX__)) {
                __prism_check(0, "FUNC-CONTRACT", "count: result does not fit in ptrdiff_t");
                __builtin_trap();
            }
            ++__n;
        }
        ++__first;
    }
    return __n;
}

#define _PRISM_RANGE_CHECK(__f, __l, __name)                                   \
    if ((__l) < (__f)) {                                                       \
        __prism_check(0, "FUNC-CONTRACT", __name ": last < first");            \
        __builtin_trap();                                                      \
    }

template <typename _Tp, typename _Pred>
constexpr bool all_of(_Tp* __first, _Tp* __last, _Pred __pred) {
    _PRISM_RANGE_CHECK(__first, __last, "all_of")
    for (; __first != __last; ++__first)
        if (!__pred(*__first)) return false;
    return true;
}
template <typename _Tp, typename _Pred>
constexpr bool any_of(_Tp* __first, _Tp* __last, _Pred __pred) {
    _PRISM_RANGE_CHECK(__first, __last, "any_of")
    for (; __first != __last; ++__first)
        if (__pred(*__first)) return true;
    return false;
}
template <typename _Tp, typename _Pred>
constexpr bool none_of(_Tp* __first, _Tp* __last, _Pred __pred) {
    _PRISM_RANGE_CHECK(__first, __last, "none_of")
    for (; __first != __last; ++__first)
        if (__pred(*__first)) return false;
    return true;
}
template <typename _Tp, typename _Pred>
constexpr _Tp* find_if_not(_Tp* __first, _Tp* __last, _Pred __pred) {
    _PRISM_RANGE_CHECK(__first, __last, "find_if_not")
    for (; __first != __last; ++__first)
        if (!__pred(*__first)) return __first;
    return __last;
}
template <typename _Tp, typename _Up, typename _Pred>
constexpr _Up* copy_if(_Tp* __first, _Tp* __last, _Up* __out, _Pred __pred) {
    _PRISM_RANGE_CHECK(__first, __last, "copy_if")
    for (; __first != __last; ++__first)
        if (__pred(*__first)) *__out++ = *__first;
    return __out;
}
template <typename _Tp, typename _Pred>
constexpr bool is_partitioned(_Tp* __first, _Tp* __last, _Pred __pred) {
    _PRISM_RANGE_CHECK(__first, __last, "is_partitioned")
    for (; __first != __last && __pred(*__first); ++__first) {}
    for (; __first != __last; ++__first)
        if (__pred(*__first)) return false;
    return true;
}
// Linear scan: the first element for which pred is false. On a range that
// is_partitioned this is the partition point required by [alg.partitions].
template <typename _Tp, typename _Pred>
constexpr _Tp* partition_point(_Tp* __first, _Tp* __last, _Pred __pred) {
    _PRISM_RANGE_CHECK(__first, __last, "partition_point")
    for (; __first != __last; ++__first)
        if (!__pred(*__first)) return __first;
    return __last;
}
template <_Prism_less_than_comparable _Tp>
constexpr pair<const _Tp&, const _Tp&> minmax(const _Tp& __a, const _Tp& __b) {
    if (__b < __a) return pair<const _Tp&, const _Tp&>(__b, __a);
    return pair<const _Tp&, const _Tp&>(__a, __b);
}
template <_Prism_less_than_comparable _Tp>
constexpr pair<_Tp*, _Tp*> minmax_element(_Tp* __first, _Tp* __last) {
    _PRISM_RANGE_CHECK(__first, __last, "minmax_element")
    _Tp* __lo = __first;
    _Tp* __hi = __first;
    for (_Tp* __p = __first; __p != __last; ++__p) {
        if (*__p < *__lo) __lo = __p;
        if (!(*__p < *__hi)) __hi = __p;  // last largest
    }
    return pair<_Tp*, _Tp*>(__lo, __hi);
}
template <_Prism_less_than_comparable _Tp>
constexpr _Tp* is_heap_until(_Tp* __first, _Tp* __last) {
    _PRISM_RANGE_CHECK(__first, __last, "is_heap_until")
    const __PTRDIFF_TYPE__ __n = __last - __first;
    for (__PTRDIFF_TYPE__ __i = 1; __i < __n; ++__i)
        if (__first[(__i - 1) / 2] < __first[__i]) return __first + __i;
    return __last;
}
template <_Prism_less_than_comparable _Tp>
constexpr bool is_heap(_Tp* __first, _Tp* __last) {
    return is_heap_until(__first, __last) == __last;
}

#undef _PRISM_RANGE_CHECK

}  // namespace std

#endif
