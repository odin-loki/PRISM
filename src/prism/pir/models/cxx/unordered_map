// PRISM operational model of <unordered_map> (roadmap 2.6, docs/PIR.md "C++ library
// models"): std::unordered_map and std::unordered_multimap with std::allocator, on
// prism_hash_table.h. Node handles and pmr allocators fall back to libstdc++.
#ifndef _PRISM_MODEL_UNORDERED_MAP
#define _PRISM_MODEL_UNORDERED_MAP 1
#define _GLIBCXX_UNORDERED_MAP 1

#pragma GCC system_header

#include <prism_hash_table.h>
#include <bits/memory_resource.h>

#define __cpp_lib_unordered_map_try_emplace 201411L

namespace std _GLIBCXX_VISIBILITY(default) {

template <typename _Pair>
struct _Prism_umap_select1st {
    static const typename _Pair::first_type& _S_get(const _Pair& __x) noexcept { return __x.first; }
};

template <typename _Key, typename _Tp, typename _Hash = hash<_Key>, typename _Pred = equal_to<_Key>,
          typename _Alloc = allocator<pair<const _Key, _Tp>>>
class unordered_multimap;

template <typename _Key, typename _Tp, typename _Hash = hash<_Key>, typename _Pred = equal_to<_Key>,
          typename _Alloc = allocator<pair<const _Key, _Tp>>>
class unordered_map {
public:
    typedef _Key key_type;
    typedef _Tp mapped_type;
    typedef pair<const _Key, _Tp> value_type;
    typedef _Hash hasher;
    typedef _Pred key_equal;
    typedef _Alloc allocator_type;

private:
    typedef _Prism_hashtable<_Key, value_type, _Prism_umap_select1st<value_type>, _Hash, _Pred, _Alloc, true> _Rep;
    _Rep _M_h;

    static mapped_type& _S_mapped(_Rep::iterator __it) noexcept { return __it._M_node->_M_valptr()->second; }

public:
    typedef value_type* pointer;
    typedef const value_type* const_pointer;
    typedef value_type& reference;
    typedef const value_type& const_reference;
    typedef typename _Rep::iterator iterator;
    typedef typename _Rep::const_iterator const_iterator;
    typedef typename _Rep::size_type size_type;
    typedef typename _Rep::difference_type difference_type;

    unordered_map() = default;
    explicit unordered_map(size_type __n, const hasher& __hf = hasher(), const key_equal& __eq = key_equal(),
                           const allocator_type& = allocator_type())
        : _M_h(__n, __hf, __eq) {}
    unordered_map(const unordered_map&) = default;
    unordered_map(unordered_map&&) = default;
    explicit unordered_map(const allocator_type&) {}
    unordered_map(const unordered_map& __m, const __type_identity_t<allocator_type>&) : _M_h(__m._M_h) {}
    unordered_map(unordered_map&& __m, const __type_identity_t<allocator_type>&) noexcept : _M_h(std::move(__m._M_h)) {}
    template <typename _InputIterator>
    unordered_map(_InputIterator __f, _InputIterator __l, size_type __n = 0, const hasher& __hf = hasher(),
                  const key_equal& __eq = key_equal(), const allocator_type& = allocator_type())
        : _M_h(__n, __hf, __eq) {
        _M_h.insert(__f, __l);
    }
    unordered_map(initializer_list<value_type> __l, size_type __n = 0, const hasher& __hf = hasher(),
                  const key_equal& __eq = key_equal(), const allocator_type& = allocator_type())
        : _M_h(__n, __hf, __eq) {
        _M_h.insert(__l.begin(), __l.end());
    }
    ~unordered_map() = default;

    unordered_map& operator=(const unordered_map&) = default;
    unordered_map& operator=(unordered_map&&) = default;
    unordered_map& operator=(initializer_list<value_type> __l) {
        _M_h.clear();
        _M_h.insert(__l.begin(), __l.end());
        return *this;
    }

    allocator_type get_allocator() const noexcept { return _M_h.get_allocator(); }
    iterator begin() noexcept { return _M_h.begin(); }
    const_iterator begin() const noexcept { return _M_h.begin(); }
    iterator end() noexcept { return _M_h.end(); }
    const_iterator end() const noexcept { return _M_h.end(); }
    const_iterator cbegin() const noexcept { return _M_h.cbegin(); }
    const_iterator cend() const noexcept { return _M_h.cend(); }

    [[__nodiscard__]] bool empty() const noexcept { return _M_h.empty(); }
    size_type size() const noexcept { return _M_h.size(); }
    size_type max_size() const noexcept { return _M_h.max_size(); }

    mapped_type& operator[](const key_type& __k) {
        auto __r = _M_h.emplace(piecewise_construct, std::forward_as_tuple(__k), std::tuple<>());
        return _S_mapped(__r.first);
    }
    mapped_type& operator[](key_type&& __k) {
        auto __r = _M_h.emplace(piecewise_construct, std::forward_as_tuple(std::move(__k)), std::tuple<>());
        return _S_mapped(__r.first);
    }
    mapped_type& at(const key_type& __k) {
        iterator __it = _M_h.find(__k);
        if (__it == _M_h.end()) __throw_out_of_range(__N("unordered_map::at"));
        return _S_mapped(__it);
    }
    const mapped_type& at(const key_type& __k) const {
        const_iterator __it = _M_h.find(__k);
        if (__it == _M_h.end()) __throw_out_of_range(__N("unordered_map::at"));
        return __it->second;
    }

    template <typename... _Args>
    pair<iterator, bool> emplace(_Args&&... __args) {
        return _M_h.emplace(std::forward<_Args>(__args)...);
    }
    template <typename... _Args>
    iterator emplace_hint(const_iterator __pos, _Args&&... __args) {
        return _M_h.emplace_hint(__pos, std::forward<_Args>(__args)...);
    }

    template <typename... _Args>
    pair<iterator, bool> try_emplace(const key_type& __k, _Args&&... __args) {
        if (iterator __it = _M_h.find(__k); __it != _M_h.end()) return {__it, false};
        return _M_h.emplace(piecewise_construct, std::forward_as_tuple(__k),
                           std::forward_as_tuple(std::forward<_Args>(__args)...));
    }
    template <typename... _Args>
    pair<iterator, bool> try_emplace(key_type&& __k, _Args&&... __args) {
        if (iterator __it = _M_h.find(__k); __it != _M_h.end()) return {__it, false};
        return _M_h.emplace(piecewise_construct, std::forward_as_tuple(std::move(__k)),
                           std::forward_as_tuple(std::forward<_Args>(__args)...));
    }

    pair<iterator, bool> insert(const value_type& __x) { return _M_h.insert(__x); }
    pair<iterator, bool> insert(value_type&& __x) { return _M_h.insert(std::move(__x)); }
    iterator insert(const_iterator, const value_type& __x) { return insert(__x).first; }
    iterator insert(const_iterator, value_type&& __x) { return insert(std::move(__x)).first; }
    template <typename _InputIterator>
    void insert(_InputIterator __f, _InputIterator __l) {
        _M_h.insert(__f, __l);
    }
    void insert(initializer_list<value_type> __l) { insert(__l.begin(), __l.end()); }

    template <typename _Obj>
    pair<iterator, bool> insert_or_assign(const key_type& __k, _Obj&& __obj) {
        auto __r = try_emplace(__k, std::forward<_Obj>(__obj));
        if (!__r.second) _S_mapped(__r.first) = std::forward<_Obj>(__obj);
        return __r;
    }
    template <typename _Obj>
    pair<iterator, bool> insert_or_assign(key_type&& __k, _Obj&& __obj) {
        auto __r = try_emplace(std::move(__k), std::forward<_Obj>(__obj));
        if (!__r.second) _S_mapped(__r.first) = std::forward<_Obj>(__obj);
        return __r;
    }

    iterator erase(const_iterator __it) { return _M_h.erase(__it); }
    iterator erase(iterator __it) { return _M_h.erase(const_iterator(__it)); }
    size_type erase(const key_type& __k) { return _M_h.erase(__k); }
    void clear() noexcept { _M_h.clear(); }
    void swap(unordered_map& __x) noexcept(noexcept(__x._M_h.swap(_M_h))) { _M_h.swap(__x._M_h); }

    hasher hash_function() const { return _M_h.hash_function(); }
    key_equal key_eq() const { return _M_h.key_eq(); }
    float load_factor() const noexcept { return _M_h.load_factor(); }
    float max_load_factor() const noexcept { return _M_h.max_load_factor(); }
    void max_load_factor(float __z) { _M_h.max_load_factor(__z); }
    size_type bucket_count() const noexcept { return _M_h.bucket_count(); }
    void rehash(size_type __n) { _M_h.rehash(__n); }
    void reserve(size_type __n) { _M_h.reserve(__n); }

    iterator find(const key_type& __k) { return _M_h.find(__k); }
    const_iterator find(const key_type& __k) const { return _M_h.find(__k); }
    template <typename _Kt>
    iterator find(const _Kt& __k) {
        return _M_h.find(__k);
    }
    template <typename _Kt>
    const_iterator find(const _Kt& __k) const {
        return _M_h.find(__k);
    }
    size_type count(const key_type& __k) const { return _M_h.count(__k); }
    bool contains(const key_type& __k) const { return _M_h.contains(__k); }
    template <typename _Kt>
    size_type count(const _Kt& __k) const {
        return _M_h.count(__k);
    }
    template <typename _Kt>
    bool contains(const _Kt& __k) const {
        return _M_h.find(__k) != _M_h.end();
    }
    pair<iterator, iterator> equal_range(const key_type& __k) { return _M_h.equal_range(__k); }
    pair<const_iterator, const_iterator> equal_range(const key_type& __k) const { return _M_h.equal_range(__k); }

    friend bool operator==(const unordered_map& __x, const unordered_map& __y) {
        return __x.size() == __y.size() && std::is_permutation(__x.begin(), __x.end(), __y.begin());
    }
};

template <typename _Key, typename _Tp, typename _Hash, typename _Pred, typename _Alloc>
class unordered_multimap {
public:
    typedef _Key key_type;
    typedef _Tp mapped_type;
    typedef pair<const _Key, _Tp> value_type;
    typedef _Hash hasher;
    typedef _Pred key_equal;
    typedef _Alloc allocator_type;

private:
    typedef _Prism_hashtable<_Key, value_type, _Prism_umap_select1st<value_type>, _Hash, _Pred, _Alloc, false> _Rep;
    _Rep _M_h;

public:
    typedef typename _Rep::iterator iterator;
    typedef typename _Rep::const_iterator const_iterator;
    typedef typename _Rep::size_type size_type;

    unordered_multimap() = default;
    explicit unordered_multimap(size_type __n, const hasher& __hf = hasher(), const key_equal& __eq = key_equal(),
                                const allocator_type& = allocator_type())
        : _M_h(__n, __hf, __eq) {}
    template <typename _InputIterator>
    unordered_multimap(_InputIterator __f, _InputIterator __l, size_type __n = 0, const hasher& __hf = hasher(),
                       const key_equal& __eq = key_equal(), const allocator_type& = allocator_type())
        : _M_h(__n, __hf, __eq) {
        _M_h.insert(__f, __l);
    }
    unordered_multimap(initializer_list<value_type> __l, size_type __n = 0, const hasher& __hf = hasher(),
                       const key_equal& __eq = key_equal(), const allocator_type& = allocator_type())
        : _M_h(__n, __hf, __eq) {
        _M_h.insert(__l.begin(), __l.end());
    }

    iterator begin() noexcept { return _M_h.begin(); }
    const_iterator begin() const noexcept { return _M_h.begin(); }
    iterator end() noexcept { return _M_h.end(); }
    const_iterator end() const noexcept { return _M_h.end(); }
    [[__nodiscard__]] bool empty() const noexcept { return _M_h.empty(); }
    size_type size() const noexcept { return _M_h.size(); }

    template <typename... _Args>
    iterator emplace(_Args&&... __args) {
        return _M_h.emplace(std::forward<_Args>(__args)...).first;
    }
    iterator insert(const value_type& __x) { return _M_h.insert(__x).first; }
    iterator insert(value_type&& __x) { return _M_h.insert(std::move(__x)).first; }
    template <typename _InputIterator>
    void insert(_InputIterator __f, _InputIterator __l) {
        _M_h.insert(__f, __l);
    }
    iterator erase(const_iterator __it) { return _M_h.erase(__it); }
    size_type erase(const key_type& __k) { return _M_h.erase(__k); }
    void clear() noexcept { _M_h.clear(); }
    iterator find(const key_type& __k) { return _M_h.find(__k); }
    size_type count(const key_type& __k) const { return _M_h.count(__k); }
    pair<iterator, iterator> equal_range(const key_type& __k) { return _M_h.equal_range(__k); }
};

template <typename _Key, typename _Tp, typename _Hash, typename _Pred, typename _Alloc>
inline void swap(unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc>& __x,
                 unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc>& __y) noexcept(noexcept(__x.swap(__y))) {
    __x.swap(__y);
}

template <typename _Key, typename _Tp, typename _Hash, typename _Pred, typename _Alloc, typename _Predicate>
inline typename unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc>::size_type erase_if(
    unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc>& __cont, _Predicate __pred) {
    typename unordered_map<_Key, _Tp, _Hash, _Pred, _Alloc>::size_type __n = 0;
    for (auto __it = __cont.begin(), __last = __cont.end(); __it != __last;) {
        if (__pred(*__it)) {
            __it = __cont.erase(__it);
            ++__n;
        } else
            ++__it;
    }
    return __n;
}

template <typename _Key, typename _Tp, typename _Hash, typename _Pred, typename _Alloc, typename _Predicate>
inline typename unordered_multimap<_Key, _Tp, _Hash, _Pred, _Alloc>::size_type erase_if(
    unordered_multimap<_Key, _Tp, _Hash, _Pred, _Alloc>& __cont, _Predicate __pred) {
    typename unordered_multimap<_Key, _Tp, _Hash, _Pred, _Alloc>::size_type __n = 0;
    for (auto __it = __cont.begin(), __last = __cont.end(); __it != __last;) {
        if (__pred(*__it)) {
            __it = __cont.erase(__it);
            ++__n;
        } else
            ++__it;
    }
    return __n;
}

namespace pmr {
template <typename _Key, typename _Tp, typename _Hash = hash<_Key>, typename _Pred = equal_to<_Key>>
using unordered_map = std::unordered_map<_Key, _Tp, _Hash, _Pred, polymorphic_allocator<pair<const _Key, _Tp>>>;
template <typename _Key, typename _Tp, typename _Hash = hash<_Key>, typename _Pred = equal_to<_Key>>
using unordered_multimap =
    std::unordered_multimap<_Key, _Tp, _Hash, _Pred, polymorphic_allocator<pair<const _Key, _Tp>>>;
}  // namespace pmr

}  // namespace std

#endif  // _PRISM_MODEL_UNORDERED_MAP
