// One type argument. The call is that operator. A missing operator fails
// the requires clause. The fitting integer result is the operator's value.
// The trap arms do not return it.

template <typename _Tp>
struct plus {
    constexpr _Tp operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a + __b; }
    {
        if constexpr (is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>) {
            if constexpr (is_signed_v<_Tp>) {
                using _Up = make_unsigned_t<_Tp>;
                const _Tp __lim = static_cast<_Tp>(static_cast<_Up>(-1) >> 1);
                const _Tp __min = static_cast<_Tp>(static_cast<_Tp>(-1) - __lim);
                if ((__b > static_cast<_Tp>(0) && __a > __lim - __b) ||
                    (__b < static_cast<_Tp>(0) && __a < __min - __b)) {
                    __prism_check(0, "INT-SIGNED-OVF", "std::plus result does not fit in T");
                    __builtin_trap();
                } else {
                    return static_cast<_Tp>(__a + __b);
                }
            } else {
                if (__a > static_cast<_Tp>(-1) - __b) {
                    __prism_check(0, "FUNC-CONTRACT", "std::plus result does not fit in T");
                    __builtin_trap();
                } else {
                    return static_cast<_Tp>(__a + __b);
                }
            }
        } else {
            return __a + __b;
        }
    }
};

template <typename _Tp>
struct minus {
    constexpr _Tp operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a - __b; }
    {
        if constexpr (is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>) {
            if constexpr (is_signed_v<_Tp>) {
                using _Up = make_unsigned_t<_Tp>;
                const _Tp __lim = static_cast<_Tp>(static_cast<_Up>(-1) >> 1);
                const _Tp __min = static_cast<_Tp>(static_cast<_Tp>(-1) - __lim);
                if ((__b < static_cast<_Tp>(0) && __a > __lim + __b) ||
                    (__b > static_cast<_Tp>(0) && __a < __min + __b)) {
                    __prism_check(0, "INT-SIGNED-OVF", "std::minus result does not fit in T");
                    __builtin_trap();
                } else {
                    return static_cast<_Tp>(__a - __b);
                }
            } else {
                if (__a < __b) {
                    __prism_check(0, "FUNC-CONTRACT", "std::minus result does not fit in T");
                    __builtin_trap();
                } else {
                    return static_cast<_Tp>(__a - __b);
                }
            }
        } else {
            return __a - __b;
        }
    }
};

template <typename _Tp>
struct multiplies {
    constexpr _Tp operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a * __b; }
    {
        if constexpr (is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>) {
            if constexpr (is_signed_v<_Tp>) {
                using _Up = make_unsigned_t<_Tp>;
                const _Tp __lim = static_cast<_Tp>(static_cast<_Up>(-1) >> 1);
                const _Tp __min = static_cast<_Tp>(static_cast<_Tp>(-1) - __lim);
                if ((__a == __min && __b == static_cast<_Tp>(-1)) || (__b == __min && __a == static_cast<_Tp>(-1)) ||
                    (__a > static_cast<_Tp>(0) && __b > static_cast<_Tp>(0) && __a > __lim / __b) ||
                    (__a > static_cast<_Tp>(0) && __b < static_cast<_Tp>(0) && __b < __min / __a) ||
                    (__a < static_cast<_Tp>(0) && __b > static_cast<_Tp>(0) && __a < __min / __b) ||
                    (__a < static_cast<_Tp>(0) && __b < static_cast<_Tp>(0) && __a < __lim / __b)) {
                    __prism_check(0, "INT-SIGNED-OVF", "std::multiplies result does not fit in T");
                    __builtin_trap();
                } else {
                    return static_cast<_Tp>(__a * __b);
                }
            } else {
                if (__b != static_cast<_Tp>(0) && __a > static_cast<_Tp>(-1) / __b) {
                    __prism_check(0, "FUNC-CONTRACT", "std::multiplies result does not fit in T");
                    __builtin_trap();
                } else {
                    return static_cast<_Tp>(__a * __b);
                }
            }
        } else {
            return __a * __b;
        }
    }
};

template <typename _Tp>
struct divides {
    constexpr _Tp operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a / __b; }
    {
        if constexpr (is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>) {
            if (__b == static_cast<_Tp>(0)) {
                __prism_check(0, "FUNC-CONTRACT", "std::divides divisor is zero");
                __builtin_trap();
            }
            if constexpr (is_signed_v<_Tp>) {
                using _Up = make_unsigned_t<_Tp>;
                const _Tp __lim = static_cast<_Tp>(static_cast<_Up>(-1) >> 1);
                const _Tp __min = static_cast<_Tp>(static_cast<_Tp>(-1) - __lim);
                if (__a == __min && __b == static_cast<_Tp>(-1)) {
                    __prism_check(0, "FUNC-CONTRACT", "std::divides of the minimum by -1");
                    __builtin_trap();
                }
            }
            return static_cast<_Tp>(__a / __b);
        } else if constexpr (is_same_v<remove_cv_t<_Tp>, bool> || is_floating_point_v<_Tp>) {
            if (__b == static_cast<_Tp>(0)) {
                __prism_check(0, "FUNC-CONTRACT", "std::divides divisor is zero");
                __builtin_trap();
            }
            return static_cast<_Tp>(__a / __b);
        } else {
            return __a / __b;
        }
    }
};

template <typename _Tp>
struct modulus {
    constexpr _Tp operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a % __b; }
    {
        if constexpr (is_integral_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>) {
            if (__b == static_cast<_Tp>(0)) {
                __prism_check(0, "FUNC-CONTRACT", "std::modulus divisor is zero");
                __builtin_trap();
            }
            if constexpr (is_signed_v<_Tp>) {
                using _Up = make_unsigned_t<_Tp>;
                const _Tp __lim = static_cast<_Tp>(static_cast<_Up>(-1) >> 1);
                const _Tp __min = static_cast<_Tp>(static_cast<_Tp>(-1) - __lim);
                if (__a == __min && __b == static_cast<_Tp>(-1)) {
                    __prism_check(0, "FUNC-CONTRACT", "std::modulus of the minimum by -1");
                    __builtin_trap();
                }
            }
            return static_cast<_Tp>(__a % __b);
        } else if constexpr (is_same_v<remove_cv_t<_Tp>, bool>) {
            if (__b == static_cast<_Tp>(0)) {
                __prism_check(0, "FUNC-CONTRACT", "std::modulus divisor is zero");
                __builtin_trap();
            }
            return static_cast<_Tp>(__a % __b);
        } else {
            return __a % __b;
        }
    }
};

template <typename _Tp>
struct negate {
    constexpr _Tp operator()(const _Tp& __x) const
        requires requires { -__x; }
    {
        if constexpr (is_integral_v<_Tp> && is_signed_v<_Tp> && !is_same_v<remove_cv_t<_Tp>, bool>) {
            using _Up = make_unsigned_t<_Tp>;
            const _Tp __lim = static_cast<_Tp>(static_cast<_Up>(-1) >> 1);
            const _Tp __min = static_cast<_Tp>(static_cast<_Tp>(-1) - __lim);
            if (__x == __min) {
                __prism_check(0, "INT-SIGNED-OVF", "std::negate of the most negative value");
                __builtin_trap();
            } else {
                return static_cast<_Tp>(-__x);
            }
        } else {
            return -__x;
        }
    }
};

