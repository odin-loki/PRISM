// PRISM operational model of <functional> (roadmap 2.6, docs/PIR.md "C++ library
// models"). The pir stage puts this directory first on the C++ include path,
// so `#include <functional>` reaches this file instead of libstdc++'s. It is a
// file, not a directory: a directory of this name would make the include fail
// with EISDIR and every such unit would fall back to libstdc++.
//
// Partial on purpose. std::function, std::invoke, and std::not_fn are modelled
// only for a function-pointer target. The pointer is stored in the std::function object.
// A general callable is not placed on the heap, so there is nothing to free
// in the destructor, in move-assignment, or when the function is empty, and
// those operations do not call the target.
//
// An empty std::function has no target. operator bool is false. operator()
// on an empty function is a precondition failure (__prism_check,
// bad_function_call). That path does not return a default result and does not
// call a null function pointer. Assigning a function pointer makes operator()
// call that pointer. A move copies the pointer, leaves the source empty, and
// does not call the target.
//
// std::invoke calls a non-variadic function pointer, noexcept or not, with
// the forwarded arguments. A null function pointer is a precondition failure
// (__prism_check, FUNC-CONTRACT), then __builtin_unreachable. That path does
// not return a default result and does not call through the null pointer.
// Any other target has no overload, so that call fails to compile here.
//
// std::identity, std::equal_to, std::not_equal_to, std::less, and
// std::greater are function objects. They are not function pointers.
// identity returns its argument and does not copy through a default T{}.
// equal_to returns a == b. not_equal_to returns !(a == b). less returns
// a < b. greater returns b < a. They do not invent a third value. A type
// that does not support the operator fails the template rather than
// returning a stand-in.
// This is not PROVED and not CLEAN.
//
// Not declared, so a unit that names one fails to compile against this header
// and pir falls back to libstdc++ (extra.cxx_models). A partial header is
// intentional:
// bind, mem_fn, ref, cref, bind_front, and reference_wrapper.
// This header does not include memory or type_traits.
#ifndef _PRISM_MODEL_FUNCTIONAL
#define _PRISM_MODEL_FUNCTIONAL 1
#define _GLIBCXX_FUNCTIONAL 1  // libstdc++'s <functional> include guard: never both

#pragma GCC system_header

// PIR intrinsic (translate.cpp). A literal class and message, as in the libc
// models. Not defined here: the analysed program does not link a body.
extern "C" void __prism_check(int ok, const char* cls, const char* msg);

namespace std {

template <typename _Signature>
class function;

template <typename _Res, typename... _ArgTypes>
class function<_Res(_ArgTypes...)> {
    using _Fn = _Res (*)(_ArgTypes...);
    _Fn _M_fn = nullptr;

public:
    function() noexcept = default;
    function(decltype(nullptr)) noexcept : _M_fn(nullptr) {}
    function(_Fn __f) noexcept : _M_fn(__f) {}

    function(const function& __o) noexcept : _M_fn(__o._M_fn) {}
    // The source is empty afterwards. The target is not called.
    function(function&& __o) noexcept : _M_fn(__o._M_fn) { __o._M_fn = nullptr; }

    function& operator=(const function& __o) noexcept {
        _M_fn = __o._M_fn;
        return *this;
    }
    // Steals the pointer. Does not call either target. No allocation, so
    // there is no block to free.
    function& operator=(function&& __o) noexcept {
        if (this != &__o) {
            _M_fn = __o._M_fn;
            __o._M_fn = nullptr;
        }
        return *this;
    }
    function& operator=(decltype(nullptr)) noexcept {
        _M_fn = nullptr;
        return *this;
    }
    function& operator=(_Fn __f) noexcept {
        _M_fn = __f;
        return *this;
    }

    // An empty function has no target. A function pointer is not invoked here.
    ~function() noexcept {}

    explicit operator bool() const noexcept { return _M_fn != nullptr; }

    _Res operator()(_ArgTypes... __args) const {
        if (_M_fn == nullptr) {
            __prism_check(0, "CXX-STD-FUNCTION-NULL",
                          "std::function::operator() on an empty target (bad_function_call)");
            // Not a default _Res, and not a call through the null pointer.
            __builtin_unreachable();
        }
        return _M_fn(__args...);
    }
};

// Function-pointer target only. The null path is the check, then unreachable.
// It does not return a default _Res and it does not call through null. The
// other path calls the pointer with the forwarded arguments.
template <typename _Res, typename... _Params, typename... _Args>
_Res invoke(_Res (*__f)(_Params...), _Args&&... __args) {
    if (__f == nullptr) {
        __prism_check(0, "FUNC-CONTRACT",
                      "std::invoke called with a null function pointer");
        __builtin_unreachable();
    }
    return __f(static_cast<_Args&&>(__args)...);
}

template <typename _Res, typename... _Params, typename... _Args>
_Res invoke(_Res (*__f)(_Params...) noexcept, _Args&&... __args) {
    if (__f == nullptr) {
        __prism_check(0, "FUNC-CONTRACT",
                      "std::invoke called with a null function pointer");
        __builtin_unreachable();
    }
    return __f(static_cast<_Args&&>(__args)...);
}

// A call result is usable as a bool when static_cast<bool> is valid.
// void is not. The specialization keeps that constraint false without
// forming a reference to void.
template <typename _Tp>
struct _Res_bool {
    static constexpr bool value = requires(const _Tp& __r) { static_cast<bool>(__r); };
};

template <>
struct _Res_bool<void> {
    static constexpr bool value = false;
};

// Function-pointer target only. The null path is the check, then unreachable.
// It does not return true or false and it does not call through null. The
// other path calls the pointer with the forwarded arguments and negates that
// bool. A result that is not usable as a bool has no overload.
template <typename _Fn>
struct _Not_fn {
    explicit _Not_fn(_Fn __f) noexcept : _M_fn(__f) {}

    template <typename... _Args>
    bool operator()(_Args&&... __args) const {
        if (_M_fn == nullptr) {
            __prism_check(0, "FUNC-CONTRACT",
                          "std::not_fn called with a null function pointer");
            __builtin_unreachable();
        }
        return !static_cast<bool>(_M_fn(static_cast<_Args&&>(__args)...));
    }

private:
    _Fn _M_fn;
};

template <typename _Res, typename... _Params>
    requires (_Res_bool<_Res>::value)
_Not_fn<_Res (*)(_Params...)> not_fn(_Res (*__f)(_Params...)) {
    return _Not_fn<_Res (*)(_Params...)>{__f};
}

template <typename _Res, typename... _Params>
    requires (_Res_bool<_Res>::value)
_Not_fn<_Res (*)(_Params...) noexcept> not_fn(_Res (*__f)(_Params...) noexcept) {
    return _Not_fn<_Res (*)(_Params...) noexcept>{__f};
}

}  // namespace std

// The rest of <bits/stl_function.h> (arithmetic functors, the transparent
// trait map's model names) stays. equal_to, not_equal_to, less, and greater
// are renamed for that include so this header can define them. identity is
// renamed for <bits/ranges_cmp.h> so ranges::less stays that header's.
#ifndef _STL_FUNCTION_H
#define equal_to _Prism_libstd_equal_to
#define not_equal_to _Prism_libstd_not_equal_to
#define less _Prism_libstd_less
#define greater _Prism_libstd_greater
#include <bits/stl_function.h>
#undef equal_to
#undef not_equal_to
#undef less
#undef greater
#define _PRISM_MODEL_FUNCTIONAL_CMP 1
#endif

#ifndef _RANGES_CMP_H
#define identity _Prism_libstd_identity
#include <bits/ranges_cmp.h>
#undef identity
#define _PRISM_MODEL_FUNCTIONAL_IDENTITY 1
#endif

namespace std {

#ifdef _PRISM_MODEL_FUNCTIONAL_IDENTITY
// Returns the argument. Not a copy, and not a default T{}.
struct identity {
    template <typename _Tp>
    constexpr _Tp&& operator()(_Tp&& __t) const noexcept {
        return static_cast<_Tp&&>(__t);
    }

    using is_transparent = __is_transparent;
};
#endif

#ifdef _PRISM_MODEL_FUNCTIONAL_CMP
// Function objects. A missing operator fails the template. No stand-in bool.
template <typename _Tp = void>
struct equal_to;

template <typename _Tp>
struct equal_to {
    constexpr bool operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a == __b; }
    {
        return __a == __b;
    }
};

template <>
struct equal_to<void> {
    template <typename _A, typename _B>
        requires requires(_A&& __a, _B&& __b) { static_cast<_A&&>(__a) == static_cast<_B&&>(__b); }
    constexpr bool operator()(_A&& __a, _B&& __b) const {
        return static_cast<_A&&>(__a) == static_cast<_B&&>(__b);
    }

    using is_transparent = __is_transparent;
};

template <typename _Tp = void>
struct not_equal_to;

template <typename _Tp>
struct not_equal_to {
    constexpr bool operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a == __b; }
    {
        return !(__a == __b);
    }
};

template <>
struct not_equal_to<void> {
    template <typename _A, typename _B>
        requires requires(_A&& __a, _B&& __b) { static_cast<_A&&>(__a) == static_cast<_B&&>(__b); }
    constexpr bool operator()(_A&& __a, _B&& __b) const {
        return !(static_cast<_A&&>(__a) == static_cast<_B&&>(__b));
    }

    using is_transparent = __is_transparent;
};

template <typename _Tp = void>
struct less;

template <typename _Tp>
struct less {
    constexpr bool operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a < __b; }
    {
        return __a < __b;
    }
};

template <>
struct less<void> {
    template <typename _A, typename _B>
        requires requires(_A&& __a, _B&& __b) { static_cast<_A&&>(__a) < static_cast<_B&&>(__b); }
    constexpr bool operator()(_A&& __a, _B&& __b) const {
        return static_cast<_A&&>(__a) < static_cast<_B&&>(__b);
    }

    using is_transparent = __is_transparent;
};

template <typename _Tp = void>
struct greater;

template <typename _Tp>
struct greater {
    constexpr bool operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __b < __a; }
    {
        return __b < __a;
    }
};

template <>
struct greater<void> {
    template <typename _A, typename _B>
        requires requires(_A&& __a, _B&& __b) { static_cast<_B&&>(__b) < static_cast<_A&&>(__a); }
    constexpr bool operator()(_A&& __a, _B&& __b) const {
        return static_cast<_B&&>(__b) < static_cast<_A&&>(__a);
    }

    using is_transparent = __is_transparent;
};
#endif

}  // namespace std

#endif
