namespace std {

#ifdef _PRISM_MODEL_FUNCTIONAL_IDENTITY
// Returns the argument. Not a copy, and not a default T{}.
struct identity {
    template <typename _Tp>
    constexpr _Tp&& operator()(_Tp&& __t) const noexcept {
        return static_cast<_Tp&&>(__t);
    }

    using is_transparent = __is_transparent;
};
#endif

#ifdef _PRISM_MODEL_FUNCTIONAL_CMP
// Function objects. A missing operator fails the template. No stand-in bool.
template <typename _Tp = void>
struct equal_to;

template <typename _Tp>
struct equal_to {
    constexpr bool operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a == __b; }
    {
        return __a == __b;
    }
};

template <>
struct equal_to<void> {
    template <typename _A, typename _B>
        requires requires(_A&& __a, _B&& __b) { static_cast<_A&&>(__a) == static_cast<_B&&>(__b); }
    constexpr bool operator()(_A&& __a, _B&& __b) const {
        return static_cast<_A&&>(__a) == static_cast<_B&&>(__b);
    }

    using is_transparent = __is_transparent;
};

template <typename _Tp = void>
struct not_equal_to;

template <typename _Tp>
struct not_equal_to {
    constexpr bool operator()(const _Tp& __a, const _Tp& __b) const
        requires requires { __a == __b; }
