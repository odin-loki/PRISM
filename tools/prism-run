#!/bin/bash
# prism-run CMD...: box-safety wrapper for heavy PRISM runs (docs/MEMORY_RULES.md)
# - admission box-wide in ticket order (first fit, aged head gets priority after 600 s); starts only when
#   at most $PRISM_RUN_SLOTS (default 4) jobs run (budget <= $PRISM_RUN_SMALL_MB, default 1024,
#   ignores the count and the queue order) AND
#   MemAvailable - sum(running jobs' remaining headroom: budget - current RSS) >= budget + reserve
#   - half the RSS of large (>1 GB) processes outside prism-run trees (their growth)
#   (reserve $PRISM_RUN_RESERVE_MB, default 1536), always, even with no other job registered
#   (programs outside prism-run use memory too). A budget that never fits waits; lower it.
# - cgroup containment is not possible here: /sys/fs/cgroup/agent is root-owned with processes
#   in it and no user systemd, so per-job MemoryMax would need moving jobs out of the agent cgroup.
# - PRISM_MEM_BUDGET_MB exported (PRISM ends a function as UNKNOWN past it).
# - watchdog: kills the tree at 1.25x budget, or at 1x budget when MemAvailable < 1 GB.
# - oom_score_adj follows RSS/budget (500 at budget, 1000 at 2x, min 100), so if the kernel
#   must kill, it picks the job furthest over its budget, not a small well-behaved one.
# - RSS, oom_score_adj and kills cover every descendant, including ones in new sessions.
# - no RLIMIT_AS (ASan reserves TBs); PRISM_RUN_AS=1 opts into a 4x --as backstop.
set -u
SLOTS=${PRISM_RUN_SLOTS:-4}; SMALL=${PRISM_RUN_SMALL_MB:-1024}; RESERVE=${PRISM_RUN_RESERVE_MB:-1536}
D=${PRISM_RUN_DIR:-/tmp/prism-run-locks}; mkdir -p $D/queue $D/running 2>/dev/null; chmod 1777 $D $D/queue $D/running 2>/dev/null
memavail() { awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo; }
# all descendants by parent pid (children may setsid into new sessions/groups)
treepids() { ps -e -o pid=,ppid= 2>/dev/null | awk -v r=$1 '{c[$2]=c[$2]" "$1} END{q=r; out=r; while(q!=""){split(q,a," "); q=""; for(i in a){n=split(c[a[i]],k," "); for(j=1;j<=n;j++){out=out" "k[j]; q=q" "k[j]}}} print out}'; }
treerss() { local ps_=$(treepids $1); [ -z "$ps_" ] && { echo 0; return; }; ps -o rss= -p $(echo $ps_ | tr ' ' ,) 2>/dev/null | awk '{s+=$1} END{print int(s/1024)}'; }
avail=$(memavail)
cg=$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)
[ "$cg" != max ] && [ -n "$cg" ] && { cgm=$((cg/1048576)); [ $cgm -lt $avail ] && avail=$cgm; }
budget=${PRISM_MEM_BUDGET_MB:-$(( avail * 6 / 10 / 2 ))}
[ -z "${PRISM_MEM_BUDGET_MB:-}" ] && [ $budget -gt 6000 ] && budget=6000
[ $budget -lt 512 ] && budget=512
# ticket: nanosecond time + pid gives FIFO order across workers
ticket=$(date +%s%N)-$$; echo $budget > $D/queue/$ticket
trap 'rm -f $D/queue/$ticket $D/running/$$' EXIT
waited=0
while :; do
  admitted=0
  exec 8>$D/admit.lock; flock 8
  for f in $D/queue/*; do p=${f##*-}; kill -0 $p 2>/dev/null || rm -f $f; done
  for f in $D/running/*; do [ -e "$f" ] && { kill -0 ${f##*/} 2>/dev/null || rm -f $f; }; done
  [ -e $D/queue/$ticket ] || echo $budget > $D/queue/$ticket
  n=0; headroom=0
  for f in $D/running/*; do
    [ -e "$f" ] || continue; read b g < $f; n=$((n+1))
    r=$(treerss ${g:-0}); h=$(( b - ${r:-0} )); [ $h -gt 0 ] && headroom=$((headroom+h))
  done
  # Outside load: large processes (> 1 GB RSS) that are not in any prism-run tree (e.g. a
  # decompiler) can grow too; reserve half their RSS again for that growth.
  ours=" "; for f in $D/running/*; do [ -e "$f" ] && { read b g < $f; ours="$ours$(treepids ${g:-0}) "; }; done
  outside=$(ps -e -o pid=,rss= | awk -v o="$ours" 'BEGIN{n=split(o,a," "); for(i=1;i<=n;i++) m[a[i]]=1} $2>1048576 && !($1 in m) {s+=$2} END{print int(s/1024/2)}')
  free=$(( $(memavail) - headroom - outside ))
  # First fit in ticket order: an older ticket that fits now goes first; one that does not fit
  # does not block younger ones, until it has waited $PRISM_RUN_HOL_S (600) s: then everyone
  # younger holds off so memory drains for it (no starvation, no head-of-line deadlock).
  mine=0; now=$(date +%s)
  for t in $(ls $D/queue | sort); do
    [ "$t" = "$ticket" ] && { mine=1; break; }
    [ $budget -le $SMALL ] && continue  # small jobs (unit-test subsets) never wait behind big ones
    tb=$(cat $D/queue/$t 2>/dev/null || echo 0)
    [ $free -ge $((tb+RESERVE)) ] && break
    [ $(( now - ${t%%-*} / 1000000000 )) -ge ${PRISM_RUN_HOL_S:-600} ] && break
  done
  if [ $mine = 1 ] && { [ $n -lt $SLOTS ] || [ $budget -le $SMALL ]; } && [ $free -ge $((budget+RESERVE)) ]; then
    echo "$budget 0" > $D/running/$$; rm -f $D/queue/$ticket; admitted=1
  fi
  flock -u 8; exec 8>&-
  [ $admitted = 1 ] && break
  [ $((waited % 60)) = 0 ] && echo "prism-run: queued (ticket $ticket, budget ${budget}MB, MemAvailable $(memavail)MB, outside growth reserve ${outside:-0}MB)" >&2
  sleep 2; waited=$((waited+2))
done
export PRISM_MEM_BUDGET_MB=$budget
echo "prism-run: admitted after ${waited}s, MemAvailable $(memavail)MB, budget ${budget}MB" >&2
{ echo 100 > /proc/$$/oom_score_adj; } 2>/dev/null  # children start at 100
if [ "${PRISM_RUN_AS:-0}" = 1 ]; then setsid prlimit --as=$(( budget * 4 * 1048576 )) -- "$@" &
else setsid "$@" & fi
pid=$!
# killed ourselves (timeout, ^C): take the job tree with us; it is in its own
# session, so it would otherwise run on unwatched and unbudgeted
trap 'kill -TERM -$pid $(treepids $pid) 2>/dev/null; sleep 2; kill -9 -$pid $(treepids $pid) 2>/dev/null; exit 143' TERM INT HUP
echo "$budget $pid" > $D/running/$$
peak=0
while kill -0 $pid 2>/dev/null; do
  [ -e $D/running/$$ ] || echo "$budget $pid" > $D/running/$$  # re-register if removed
  r=$(treerss $pid); r=${r:-0}; [ $r -gt $peak ] && peak=$r
  adj=$(( r * 500 / budget )); [ $adj -lt 100 ] && adj=100; [ $adj -gt 1000 ] && adj=1000
  for p in $(treepids $pid); do { echo $adj > /proc/$p/oom_score_adj; } 2>/dev/null; done
  kill_at=$(( budget * 5 / 4 )); [ $(memavail) -lt 1024 ] && kill_at=$budget
  if [ $r -gt $kill_at ]; then echo "prism-run: RSS ${r}MB over ${kill_at}MB (MemAvailable $(memavail)MB): killed (reported, not silent)" >&2; kill -9 -$pid $(treepids $pid) 2>/dev/null; fi
  sleep 0.5
done
wait $pid; rc=$?
echo "prism-run: exit $rc, peak tree RSS ${peak}MB (budget ${budget}MB)" >&2
exit $rc
