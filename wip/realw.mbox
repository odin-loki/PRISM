+            elif c == "}":
+                depth -= 1
+                if depth == 0:
+                    return "".join(buf), line_k + 1
+            buf.append(c)
+        buf.append("\n")
+        line_k += 1
+        if line_k >= len(lines):
+            return "".join(buf), line_k
