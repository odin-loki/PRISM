+std::optional<z3::expr> SymMem::word_split(uint64_t a, unsigned n, std::size_t upto) {
+    const auto key = std::make_tuple(a, n, upto);
+    if (auto it = word_memo_.find(key); it != word_memo_.end()) return it->second;
