+std::string vs_blame(const prism::pir::mem::SymMem& m, const z3::expr& e, int depth = 0) {
+    if (depth > 200) return "deep";
+    if (!e.is_app() || e.num_args() == 0) return "leaf " + e.to_string().substr(0, 80);
+    const auto k = e.decl().decl_kind();
