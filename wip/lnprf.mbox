+        .assign (k + 2) (.cmp .ne) [.v k 64, .v (k + 1) 64], .check (.v (k + 2) 1) "ptr-cmp" "PTR-COMPARE",
+        .assign i (.cmp (uPred p)) [A, B]] =
+      if ptrObj (A.get σ % 2 ^ 64) = ptrObj (B.get σ % 2 ^ 64) then
+        .ok (σ'.set i (icmpVal (uPred p) 64 (A.get σ) (B.get σ))) t
